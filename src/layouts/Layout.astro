---
import '../styles/fonts.css';
import '../styles/global.css';
import montserratFont from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import jakartaFont from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HoselineDock from '../components/HoselineDock.astro';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Imagen de cabecera (fondo CSS) a precargar; en móvil (≤768px) puede ser otra */
  heroImage?: string | { desktop: string; mobile: string };
  /** false para páginas como el panel: sin menú del sitio, pie, dock de audio ni "volver arriba" */
  chrome?: boolean;
}

const {
  title = "BrandMeister Venezuela · Red Digital DMR TG 734",
  description = "Comunidad oficial de radioaficionados en la red BrandMeister DMR en Venezuela. Talkgroups nacionales, circuitos, repetidores, Petra y voz digital.",
  image = "/assets/og-brandmeister-dmr-con-radio.jpg",
  heroImage,
  chrome = true
} = Astro.props;

const heroPreload = typeof heroImage === 'string' ? { desktop: heroImage, mobile: heroImage } : heroImage;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://brandmeisteryv.net');
const siteOrigin = (Astro.site || 'https://brandmeisteryv.net').toString().replace(/\/$/, '');

// Garantizar URL absoluta para og:image y twitter:image (indispensable para WhatsApp, Facebook, Telegram y Twitter)
const ogImageURL = image.startsWith('http://') || image.startsWith('https://')
  ? image
  : new URL(image, siteOrigin).href;

// Breadcrumbs Schema.org dinámico según la ruta
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbsItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Inicio",
    "item": siteOrigin + "/"
  }
];

if (pathSegments.length > 0) {
  const titlesMap: Record<string, string> = {
    'repetidores': 'Repetidores DMR',
    'talkgroups': 'Talkgroups DMR',
    'galeria': 'Galería',
    'comunidad': 'Comunidad',
    'contacto': 'Contacto',
    'petra': 'Dashboard Petra',
    'blog': 'Noticias y Artículos'
  };
  let accumulatedPath = '';
  pathSegments.forEach((segment, idx) => {
    accumulatedPath += `/${segment}`;
    breadcrumbsItems.push({
      "@type": "ListItem",
      "position": idx + 2,
      "name": titlesMap[segment] || segment.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()),
      "item": `${siteOrigin}${accumulatedPath}`
    });
  });
}
---

<!doctype html>
<html lang="es" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon Oficial BrandMeister -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#E8261C" />
    <meta name="msapplication-TileColor" content="#E8261C" />

    <!-- Metadatos de Indexación y Rastreo para Buscadores Tradicionales y Motores de IA -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="author" content="BrandMeister Venezuela" />
    <meta name="publisher" content="BrandMeister Venezuela" />
    <meta name="geo.region" content="VE" />
    <meta name="geo.placename" content="Venezuela" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Alternates / Hreflang para localización e indexación internacional -->
    <link rel="alternate" hreflang="es-VE" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <!-- Open Graph / Redes Sociales (Facebook, WhatsApp, Telegram, LinkedIn, Discord, iMessage) -->
    <meta property="og:site_name" content="BrandMeister Venezuela" />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:type" content={ogImageURL.endsWith('.webp') ? 'image/webp' : 'image/jpeg'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="BrandMeister Venezuela · Red Digital DMR TG 734 · DMR con Radio" />

    <!-- Twitter Cards (X) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@brandmeister_yv" />
    <meta name="twitter:creator" content="@brandmeister_yv" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="BrandMeister Venezuela · Red Digital DMR TG 734 · DMR con Radio" />

    <!-- Fuentes autoalojadas: se precargan para evitar el salto de tipografía -->
    <link rel="preload" href={jakartaFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={montserratFont} as="font" type="font/woff2" crossorigin />
    {heroPreload && heroPreload.desktop === heroPreload.mobile && (
      <link rel="preload" href={heroPreload.desktop} as="image" type="image/webp" fetchpriority="high" />
    )}
    {heroPreload && heroPreload.desktop !== heroPreload.mobile && (
      <>
        <link rel="preload" href={heroPreload.desktop} as="image" type="image/webp" media="(min-width: 769px)" fetchpriority="high" />
        <link rel="preload" href={heroPreload.mobile} as="image" type="image/webp" media="(max-width: 768px)" fetchpriority="high" />
      </>
    )}

    <!-- JSON-LD Datos Estructurados Schema.org (Google Rich Results & LLMs / AI Overviews) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "AmateurRadioOrganization",
          "@id": `${siteOrigin}/#organization`,
          "name": "BrandMeister Venezuela",
          "alternateName": ["BrandMeister DMR Venezuela", "BM Venezuela", "Red DMR TG 734", "BrandMeister YV"],
          "url": siteOrigin,
          "logo": {
            "@type": "ImageObject",
            "url": `${siteOrigin}/assets/og-brandmeister-dmr-con-radio-square.jpg`,
            "width": 1024,
            "height": 1024
          },
          "image": `${siteOrigin}/assets/og-brandmeister-dmr-con-radio.jpg`,
          "description": "Comunidad oficial de radioaficionados en la red BrandMeister DMR Master 734 en Venezuela. Talkgroups nacionales, circuitos, repetidores activos, monitor Petra y voz digital para radioafición.",
          "slogan": "DMR con Radio",
          "address": {
            "@type": "PostalAddress",
            "addressCountry": "VE"
          },
          "sameAs": [
            "https://www.instagram.com/brandmeister_yv/",
            "https://t.me/+_NUvASaZZGxhYTkx",
            "https://wiki.brandmeister.network/index.php/Venezuela"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "email": "sysop@brandmeisteryv.net",
            "contactType": "technical support",
            "availableLanguage": ["Spanish"]
          }
        },
        {
          "@type": "WebSite",
          "@id": `${siteOrigin}/#website`,
          "url": siteOrigin,
          "name": "BrandMeister Venezuela",
          "description": "Portal oficial de la red digital DMR BrandMeister en Venezuela",
          "publisher": {
            "@id": `${siteOrigin}/#organization`
          },
          "inLanguage": "es-VE"
        },
        ...(breadcrumbsItems.length > 1 ? [{
          "@type": "BreadcrumbList",
          "@id": `${canonicalURL}#breadcrumb`,
          "itemListElement": breadcrumbsItems
        }] : [])
      ]
    })} />
    <slot name="head" />
  </head>
  <body>
    {chrome && <Header />}
    <main id="main-content">
      <slot />
    </main>
    {chrome && (
      <>
        <Footer />
        <HoselineDock />
        <BackToTop />
      </>
    )}

    <!-- Script de Animaciones por Scroll sin dependencias externas -->
    <script>
      const initScrollObserver = () => {
        const elements = document.querySelectorAll('.reveal-on-scroll');
        if (!elements.length) return;

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.12,
          rootMargin: '0px 0px -40px 0px'
        });

        elements.forEach(el => observer.observe(el));
      };

      // Iniciar en carga y en navegaciones
      document.addEventListener('DOMContentLoaded', initScrollObserver);
      initScrollObserver();

      // Visita a la página, con el sitio de procedencia para saber por dónde llegó la gente.
      // El navegador solo entrega la procedencia aquí, en la página: la petición al API viaja
      // con nuestra propia dirección, así que el origen hay que mandarlo en el propio aviso.
      (() => {
        try {
          // El panel y las plantillas del blog no son visitas del público
          const ruta = window.location.pathname;
          if (ruta.startsWith('/admin') || ruta.startsWith('/plantillas')) return;

          const params = new URLSearchParams(window.location.search);
          // De un enlace compartido por nosotros: ?utm_source=whatsapp o el más corto ?ref=whatsapp
          const hint = (params.get('utm_source') || params.get('ref') || '').slice(0, 40);

          fetch('/api/analytics.php?action=track', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              event_type: 'page_view',
              event_category: 'pagina',
              entity_id: window.location.pathname.slice(0, 100),
              entity_title: (document.title || '').slice(0, 120),
              referrer: (document.referrer || '').slice(0, 250),
              source_hint: hint,
            }),
            keepalive: true,
          }).catch(() => {});
        } catch (_) {}
      })();

      // Rastreo discreto de clics en enlaces comunitarios y externos
      document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement | null)?.closest?.('a');
        if (!link || !link.href) return;
        const href = link.getAttribute('href') || '';
        const isExternal = Boolean(link.host && link.host !== window.location.host);
        const isResourceKey = href.includes('repetidores') || href.includes('talkgroups') || href.includes('radioid') || href.includes('brandmeister') || (href.includes('petra') && !window.location.pathname.startsWith('/petra'));
        
        if (isExternal || isResourceKey) {
          const title = link.getAttribute('title') || link.getAttribute('aria-label') || link.textContent?.trim() || href;
          try {
            fetch('/api/analytics.php?action=track', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                event_type: 'link_click',
                event_category: isExternal ? 'external_link' : 'portal_link',
                entity_id: href.slice(0, 100),
                entity_title: title.slice(0, 100)
              }),
              keepalive: true
            }).catch(() => {});
          } catch (_) {}
        }
      }, { passive: true });
    </script>
  </body>
</html>
