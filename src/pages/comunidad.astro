---
import Layout from '../layouts/Layout.astro';
---

<Layout
  heroImage={{ desktop: '/assets/tg-background-landscape.webp', mobile: '/assets/tg-background-portrait-m.webp' }}
  title="Nuestra Comunidad · Historia, Valores y Radioaficionados de BrandMeister Venezuela"
  description="Conoce la historia, orígenes y evolución de la Red BrandMeister Venezuela. Un homenaje a los pioneros del DMR en 2010 y un sincero agradecimiento a todos los colegas que hacen posible la red."
>
  <main class="comunidad-page">
    <!-- Hero 50vh con fondo del Hero Principal y degradado lateral -->
    <section class="comunidad-hero">
      <div class="container">
        <div class="comunidad-hero-content">
          <div class="comunidad-badge">
            <span>Radioafición Digital Venezolana</span>
          </div>
          <h1 class="comunidad-title">Nuestra Comunidad</h1>
          <p class="comunidad-subtitle">
            Uniendo a Venezuela y al mundo a través de la voz digital. Una historia construida con vocación de servicio público, innovación técnica y la hermandad de radioaficionados comprometidos con el progreso de nuestra red.
          </p>
          <div class="comunidad-meta">
            Red Digital DMR · Talkgroup Nacional 734 · MCC 734
          </div>
        </div>
      </div>
    </section>

    <!-- Línea divisoria con degradado de 3 colores BrandMeister -->
    <div class="bm-stripe"></div>

    <!-- Cuerpo de Contenido Editorial -->
    <section class="comunidad-body section-padding">
      <div class="container">
        <!-- 1. Historia y Trayectoria -->
        <div class="story-section">
          <div class="section-intro">
            <span class="sub-label">Trayectoria y Evolución</span>
            <h2 class="section-h2">La Historia de BrandMeister en Venezuela</h2>
            <p class="intro-p">
              La red BrandMeister ha transformado las comunicaciones entre radioaficionados en los cinco continentes. Lo que comenzó como un experimento abierto es hoy una infraestructura global dinámica que conecta miles de sistemas y operadores. En Venezuela, esta pasión por la tecnología y la experimentación encendió los primeros enlaces digitales hace más de una década.
            </p>
          </div>

          <div class="timeline-container">
            <div class="timeline-track"></div>

            <!-- Hito 1: 2010 -->
            <div class="timeline-item left">
              <div class="timeline-node" aria-hidden="true">
                <span class="timeline-node-dot"></span>
              </div>
              <div class="timeline-card">
                <div class="timeline-header">
                  <span class="timeline-year">2010</span>
                  <span class="timeline-badge">Orígenes</span>
                </div>
                <h3 class="timeline-title">La Chispa Pionera</h3>
                <p class="timeline-desc">
                  Un grupo entusiasta de radioaficionados venezolanos inició las primeras pruebas de modulación digital DMR en el país. Frente a un panorama tradicionalmente analógico, estos colegas apostaron por un estándar abierto con dos ranuras de tiempo (TDMA) y una eficiencia de espectro sin precedentes.
                </p>
              </div>
            </div>

            <!-- Hito 2: Caracas 734500 -->
            <div class="timeline-item right">
              <div class="timeline-node" aria-hidden="true">
                <span class="timeline-node-dot"></span>
              </div>
              <div class="timeline-card">
                <div class="timeline-header">
                  <span class="timeline-year">Caracas</span>
                  <span class="timeline-badge highlight">Hito Histórico</span>
                </div>
                <h3 class="timeline-title">El Primer Repetidor DMR (734500)</h3>
                <p class="timeline-desc">
                  En la ciudad de Caracas se puso en marcha el repetidor oficial <strong>734500 (YV5DMR)</strong>, enlazado con el valioso apoyo del servidor Máster de México (3341). Este logro consolidó la primera puerta de enlace fija de Venezuela hacia la red global BrandMeister.
                </p>
              </div>
            </div>

            <!-- Hito 3: Expansión -->
            <div class="timeline-item left">
              <div class="timeline-node" aria-hidden="true">
                <span class="timeline-node-dot"></span>
              </div>
              <div class="timeline-card">
                <div class="timeline-header">
                  <span class="timeline-year">Expansión</span>
                  <span class="timeline-badge">Cobertura</span>
                </div>
                <h3 class="timeline-title">Conectividad Nacional</h3>
                <p class="timeline-desc">
                  La visión de cobertura se amplió progresivamente con la instalación de repetidores y puntos de acceso en regiones clave como Guárico, Zulia, Carabobo, Aragua y la región Central, sumados a cientos de hotspots residenciales que conectaron a colegas desde los rincones más distantes.
                </p>
              </div>
            </div>

            <!-- Hito 4: Presente / Petra -->
            <div class="timeline-item right">
              <div class="timeline-node" aria-hidden="true">
                <span class="timeline-node-dot"></span>
              </div>
              <div class="timeline-card">
                <div class="timeline-header">
                  <span class="timeline-year">Presente</span>
                  <span class="timeline-badge highlight">Desarrollo Propio</span>
                </div>
                <h3 class="timeline-title">Innovación Criolla: Sistema Petra</h3>
                <p class="timeline-desc">
                  Nuestra comunidad dio un salto cualitativo desarrollando sus propias herramientas: el Sistema Petra, plataforma de telemetría, monitoreo de salud del anunciador, alertas sísmicas y meteorológicas automáticas, y balizas horarias en telegrafía que honran las raíces de la radio.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Nuestros Pilares Técnicos -->
        <div class="pillars-section">
          <div class="section-intro">
            <span class="sub-label">Principios Operativos</span>
            <h2 class="section-h2">Nuestra Filosofía de Red</h2>
          </div>

          <div class="pillars-grid">
            <div class="pillar-card">
              <div class="pillar-icon">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                  <line x1="8" y1="21" x2="16" y2="21"></line>
                  <line x1="12" y1="17" x2="12" y2="21"></line>
                </svg>
              </div>
              <h3 class="pillar-title">100% Digital</h3>
              <p class="pillar-desc">
                Promovemos la pureza del códec digital AMBE+2 sin conversiones analógicas intermedias, asegurando un audio limpio, funciones de telemetría avanzadas y evitando ruidos o enlaces cruzados.
              </p>
            </div>

            <div class="pillar-card">
              <div class="pillar-icon">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                  <line x1="8" y1="2" x2="8" y2="18"></line>
                  <line x1="16" y1="6" x2="16" y2="22"></line>
                </svg>
              </div>
              <h3 class="pillar-title">TG Nacional 734</h3>
              <p class="pillar-desc">
                El canal 734 es el hogar común de la radioafición venezolana. Un espacio de encuentro fraterno donde convergen estaciones de toda la geografía patria y colegas de la diáspora alrededor del mundo.
              </p>
            </div>

            <div class="pillar-card">
              <div class="pillar-icon">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 17h2a1 1 0 0 0 1-1v-4a2 2 0 0 0-.586-1.414l-2.828-2.828A2 2 0 0 0 17.172 7H14V5a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2"></path>
                  <path d="M14 7h3.172a1 1 0 0 1 .707.293l2.828 2.828A1 1 0 0 1 21 10.83V11H14V7z"></path>
                  <path d="M8 8v4M6 10h4"></path>
                  <circle cx="7" cy="17" r="2"></circle>
                  <path d="M9 17h6"></path>
                  <circle cx="17" cy="17" r="2"></circle>
                </svg>
              </div>
              <h3 class="pillar-title">Servicio y Emergencia</h3>
              <p class="pillar-desc">
                Mantenemos reservado el <strong>TG 734911</strong> en Slot 1 para eventos de contingencia, boletines de protección civil, sismos y emergencias naturales donde la comunicación oportuna salva vidas.
              </p>
            </div>
          </div>
        </div>

        <!-- 3. Agradecimiento Fraterno a Todos los Colegas -->
        <div class="tribute-box">
          <div class="tribute-badge">
            <span>El Corazón de la Red</span>
          </div>
          <h2 class="tribute-title">Un Sincero Reconocimiento a Toda la Comunidad</h2>
          <div class="tribute-text">
            <p>
              La Red BrandMeister Venezuela no es un servidor ni un conjunto de frecuencias: <strong>es su gente</strong>. Nada de esto sería posible sin el esfuerzo generoso y desinteresado de cada uno de los colegas que día tras día aportan su talento, sus recursos y su tiempo a esta obra colectiva.
            </p>
            <p>
              Vaya nuestro más profundo y fraterno agradecimiento a:
            </p>
            <ul class="tribute-list">
              <li>
                <strong>Los custodios y técnicos de repetidores</strong>, que suben cerros y montañas sorteando dificultades climáticas, eléctricas y de acceso para mantener vivas las estaciones repetidoras.
              </li>
              <li>
                <strong>Los constructores y operadores de hotspots</strong>, tanto sencillos como de alta potencia, que extienden la huella de cobertura digital en cada ciudad, pueblo y rincón de Venezuela.
              </li>
              <li>
                <strong>Los administradores y sysops</strong>, que coordinan servidores máster, asignación de identificadores y enlaces internacionales velando por la estabilidad del sistema.
              </li>
              <li>
                <strong>Los radio clubes e instituciones</strong>, que fomentan la capacitación técnica, promueven las buenas prácticas y abren las puertas a las nuevas generaciones de radioaficionados.
              </li>
              <li>
                <strong>A todos y cada uno de los colegas operadores</strong> que toman el micrófono con respeto, ética y espíritu de hermandad, manteniendo encendida la llama de la radioafición venezolana dentro y fuera de nuestras fronteras.
              </li>
            </ul>
            <p class="tribute-footer-quote">
              <em>«La tecnología evoluciona, pero la esencia de la radioafición sigue siendo la misma: servir, experimentar y tender puentes de amistad.»</em>
            </p>
          </div>
        </div>

        <!-- 4. Servidores y Coordinación -->
        <div class="servers-section">
          <div class="section-intro">
            <span class="sub-label">Infraestructura y Soporte</span>
            <h2 class="section-h2">Servidores Máster y Coordinación Técnica</h2>
          </div>

          <div class="servers-grid">
            <div class="server-card">
              <div class="server-badge">Servidor Primario</div>
              <h3 class="server-name">7301 · BM Chile</h3>
              <p class="server-desc">
                Servidor de alta velocidad y baja latencia optimizado para el cono sur y la interconexión estable de hotspots y repetidores venezolanos.
              </p>
            </div>

            <div class="server-card">
              <div class="server-badge">Servidor Histórico</div>
              <h3 class="server-name">3341 · BM México</h3>
              <p class="server-desc">
                El máster hermano que acogió los primeros pasos de Venezuela en 2010 y continúa brindando respaldo confiable a nuestra red.
              </p>
            </div>

            <div class="server-card coordination-card">
              <div class="server-badge">Equipo de Servicio</div>
              <h3 class="server-name">Coordinación BrandMeister YV</h3>
              <p class="server-desc">
                Equipo de administración técnica y soporte a la comunidad: <strong>YV5OF</strong> (Main Sysop), <strong>YV5ADM</strong>, <strong>YV5VE</strong> y <strong>YY3BIG</strong>.
              </p>
            </div>
          </div>
        </div>

      </div>
    </section>
  </main>
</Layout>

<style>
  .comunidad-page {
    background: #FAFAFA;
    min-height: 100vh;
  }

  /* Hero 50vh con fondo de la comunidad de repetidores del home */
  .comunidad-hero {
    position: relative;
    min-height: 50vh;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #FFFFFF;
    background-image:
      linear-gradient(90deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.94) 45%, rgba(255, 255, 255, 0.65) 75%, rgba(255, 255, 255, 0.18) 100%),
      linear-gradient(0deg, #FAFAFA 0%, rgba(255, 255, 255, 0.8) 12%, transparent 35%),
      url('/assets/tg-background-landscape.webp');
    background-size: cover;
    background-position: right center;
    background-repeat: no-repeat;
    padding: 3.5rem 0;
  }

  @media (max-width: 768px) {
    .comunidad-hero {
      min-height: 50vh;
      background-image:
        linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.95) 60%, rgba(255, 255, 255, 0.88) 100%),
        url('/assets/tg-background-portrait-m.webp');
      background-position: center top;
      background-size: cover;
      padding: 2.5rem 0;
    }
  }

  .comunidad-hero-content {
    max-width: 820px;
  }

  .comunidad-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--bm-red);
    border: 1px solid rgba(232, 38, 28, 0.45);
    background: rgba(232, 38, 28, 0.04);
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .comunidad-title {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.15;
    margin-bottom: 0.85rem;
  }

  .comunidad-subtitle {
    font-size: clamp(1.02rem, 1.8vw, 1.2rem);
    line-height: 1.6;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .comunidad-meta {
    font-size: 0.95rem;
    color: var(--text-muted);
    font-weight: 500;
    line-height: 1.5;
  }

  /* Línea divisoria con degradado de 3 colores BrandMeister */
  .bm-stripe {
    height: 3px;
    background: linear-gradient(90deg, #E8261C 0%, #EE6C1F 50%, #F2A93B 100%);
    width: 100%;
    display: block;
    position: relative;
    z-index: 10;
  }

  .comunidad-body {
    padding-top: clamp(2.5rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 5vw, 5rem);
  }

  /* Intro de sección */
  .section-intro {
    margin-bottom: 2rem;
  }

  .sub-label {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--bm-red);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.35rem;
  }

  .section-h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.75rem;
  }

  .intro-p {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 820px;
  }

  /* Timeline Vertical Structure */
  .story-section {
    margin-bottom: 4.5rem;
  }

  .timeline-container {
    position: relative;
    max-width: 920px;
    margin: 2.5rem auto 0;
    padding: 1rem 0;
  }

  /* Columna vertical central con degradado BrandMeister */
  .timeline-track {
    position: absolute;
    top: 1rem;
    bottom: 1rem;
    left: 50%;
    width: 3px;
    transform: translateX(-50%);
    background: linear-gradient(180deg, #E8261C 0%, #EE6C1F 50%, #F2A93B 100%);
    border-radius: 3px;
    z-index: 1;
  }

  .timeline-item {
    position: relative;
    width: 50%;
    margin-bottom: 2.25rem;
    display: flex;
    box-sizing: border-box;
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  /* Alternancia Izquierda y Derecha */
  .timeline-item.left {
    left: 0;
    padding-right: 2.75rem;
    justify-content: flex-end;
  }

  .timeline-item.right {
    left: 50%;
    padding-left: 2.75rem;
    justify-content: flex-start;
  }

  /* Nodos circulares en el centro de la línea */
  .timeline-node {
    position: absolute;
    top: 1.5rem;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 3px solid var(--bm-red);
    box-shadow: 0 0 0 4px rgba(232, 38, 28, 0.12), var(--shadow-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .timeline-item.left .timeline-node {
    right: -13px;
  }

  .timeline-item.right .timeline-node {
    left: -13px;
    border-color: var(--bm-orange);
    box-shadow: 0 0 0 4px rgba(238, 108, 31, 0.12), var(--shadow-sm);
  }

  .timeline-item:nth-child(5) .timeline-node {
    border-color: var(--bm-amber);
    box-shadow: 0 0 0 4px rgba(242, 169, 59, 0.15), var(--shadow-sm);
  }

  .timeline-node-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bm-red);
  }

  .timeline-item.right .timeline-node-dot {
    background: var(--bm-orange);
  }

  .timeline-item:nth-child(5) .timeline-node-dot {
    background: var(--bm-amber);
  }

  .timeline-item:hover .timeline-node {
    transform: scale(1.18);
    box-shadow: 0 0 0 7px rgba(238, 108, 31, 0.25), var(--shadow-md);
  }

  /* Tarjetas del Timeline */
  .timeline-card {
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.6rem 1.45rem;
    box-shadow: var(--shadow-sm);
    position: relative;
    width: 100%;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .timeline-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: rgba(238, 108, 31, 0.35);
  }

  /* Puntas indicadoras hacia la espina central */
  .timeline-item.left .timeline-card::after {
    content: "";
    position: absolute;
    top: 1.7rem;
    right: -7px;
    width: 12px;
    height: 12px;
    background: #FFFFFF;
    border-top: 1px solid var(--border-subtle);
    border-right: 1px solid var(--border-subtle);
    transform: rotate(45deg);
  }

  .timeline-item.right .timeline-card::after {
    content: "";
    position: absolute;
    top: 1.7rem;
    left: -7px;
    width: 12px;
    height: 12px;
    background: #FFFFFF;
    border-bottom: 1px solid var(--border-subtle);
    border-left: 1px solid var(--border-subtle);
    transform: rotate(45deg);
  }

  .timeline-card:hover::after {
    border-color: rgba(238, 108, 31, 0.35);
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }

  .timeline-year {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--bm-red);
    line-height: 1;
  }

  .timeline-badge {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--bm-orange);
    background: rgba(238, 108, 31, 0.08);
    border: 1px solid rgba(238, 108, 31, 0.2);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
    letter-spacing: 0.02em;
  }

  .timeline-badge.highlight {
    color: var(--bm-red);
    background: rgba(232, 38, 28, 0.08);
    border-color: rgba(232, 38, 28, 0.25);
  }

  .timeline-title {
    font-family: var(--font-heading);
    font-size: 1.12rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.6rem;
    line-height: 1.3;
  }

  .timeline-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* Soporte Responsivo Robusto para Móviles y Tablets */
  @media (max-width: 768px) {
    .timeline-container {
      margin-top: 2rem;
      padding: 0.5rem 0;
    }

    /* La espina se desplaza hacia la izquierda */
    .timeline-track {
      left: 18px;
      transform: none;
    }

    .timeline-item {
      width: 100%;
      left: 0 !important;
      padding-left: 52px !important;
      padding-right: 0 !important;
      justify-content: flex-start !important;
      margin-bottom: 1.75rem;
    }

    .timeline-item.left .timeline-node,
    .timeline-item.right .timeline-node {
      left: 5px;
      right: auto;
      top: 1.4rem;
    }

    /* En móviles todas las flechas apuntan a la izquierda hacia la espina */
    .timeline-item.left .timeline-card::after,
    .timeline-item.right .timeline-card::after {
      left: -7px;
      right: auto;
      top: 1.6rem;
      border-top: none;
      border-right: none;
      border-bottom: 1px solid var(--border-subtle);
      border-left: 1px solid var(--border-subtle);
    }
  }

  @media (max-width: 480px) {
    .timeline-track {
      left: 14px;
    }

    .timeline-item {
      padding-left: 44px !important;
      margin-bottom: 1.5rem;
    }

    .timeline-item.left .timeline-node,
    .timeline-item.right .timeline-node {
      left: 2px;
      width: 24px;
      height: 24px;
    }

    .timeline-node-dot {
      width: 6px;
      height: 6px;
    }

    .timeline-card {
      padding: 1.25rem 1.1rem;
    }

    .timeline-year {
      font-size: 1.2rem;
    }

    .timeline-title {
      font-size: 1.02rem;
    }

    .timeline-desc {
      font-size: 0.88rem;
    }
  }

  /* Pilares */
  .pillars-section {
    margin-bottom: 4rem;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.75rem;
  }

  .pillar-card {
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2rem 1.75rem;
