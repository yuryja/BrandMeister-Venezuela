---
import Layout from '../layouts/Layout.astro';
import seedPosts from '../data/galeria.json';

// Si en el futuro se desea consultar la BD directamente en build o fallback
const initialPosts = seedPosts;
---

<Layout
  title="Galería · BrandMeister Venezuela"
  description="Fotografías de campo, montajes en repetidores, estaciones y videos de la comunidad de radioaficionados @brandmeister_yv."
>
  <main class="gallery-page">
    <!-- Hero 50vh con fotografía de radioafición y tratamiento de marca -->
    <section class="gallery-hero">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            <span>Comunidad @brandmeister_yv</span>
          </div>
          <h1 class="hero-title">Galería BrandMeister</h1>
          <p class="hero-subtitle">
            La voz, las vivencias y la tecnología que unen a los radioaficionados de Venezuela. Descubre las activaciones de campo, instalaciones en cerros, configuraciones de hotspots y transmisiones compartidas en nuestra red.
          </p>
          <div class="hero-actions">
            <a
              href="https://www.instagram.com/brandmeister_yv/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ig-follow"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
              <span>Seguir en Instagram @brandmeister_yv</span>
              <span class="btn-arrow">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Franja divisoria con degradado de 3 colores BrandMeister -->
    <div class="bm-stripe"></div>

    <!-- Sección Principal de Galería -->
    <section class="gallery-section section-padding">
      <div class="container">
        
        <!-- Barra de Filtros por Tipo de Medio -->
        <div class="gallery-toolbar">
          <div class="filter-pills" id="gallery-filters">
            <button class="filter-pill is-active" data-filter="all">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
              <span>Todos ({initialPosts.length})</span>
            </button>
            <button class="filter-pill" data-filter="IMAGE">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                <circle cx="12" cy="13" r="4"></circle>
              </svg>
              <span>Fotos</span>
            </button>
            <button class="filter-pill" data-filter="CAROUSEL_ALBUM">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="14" height="14" rx="2" ry="2"></rect>
                <path d="M7 21h12a2 2 0 0 0 2-2V7"></path>
              </svg>
              <span>Carruseles / Álbumes</span>
            </button>
            <button class="filter-pill" data-filter="VIDEO">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
              <span>Videos & Reels</span>
            </button>
          </div>

          <div class="gallery-legend">
            <span>Comunidad y actividades de la red BrandMeister Venezuela</span>
          </div>
        </div>

        <!-- Cuadrícula de Publicaciones -->
        <div class="gallery-grid" id="gallery-grid">
          {initialPosts.map((post, index) => (
            <article
              class="gallery-card"
              data-type={post.media_type}
              data-index={index}
              tabindex="0"
              role="button"
              aria-label={`Ver publicación de ${post.author}`}
            >
              <div class="card-media-wrap">
                <img
                  src={post.thumbnail_url || post.media_url}
                  alt={post.caption?.substring(0, 80) || "Publicación BrandMeister Venezuela"}
                  loading="lazy"
                  class="card-img"
                />

                <!-- Insignia de Tipo de Contenido -->
                <div class="card-type-badge">
                  {post.media_type === 'CAROUSEL_ALBUM' && (
                    <span class="badge-carousel" title="Publicación con múltiples imágenes">
                      <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                        <path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12z"/>
                      </svg>
                      <span>{post.carousel_media?.length || 2} fotos</span>
                    </span>
                  )}

                  {post.media_type === 'VIDEO' && (
                    <span class="badge-video" title="Video / Reel interactivo">
                      <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                      </svg>
                      <span>Video</span>
                    </span>
                  )}

                  {post.media_type === 'IMAGE' && (
                    <span class="badge-image" title="Fotografía individual">
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                        <circle cx="12" cy="13" r="4"></circle>
                      </svg>
                    </span>
                  )}
                </div>

                <!-- Overlay con Información y Efecto Hover -->
                <div class="card-hover-overlay">
                  <div class="overlay-stats">
                    <span class="stat-item">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                      </svg>
                      <span>{post.likes_count}</span>
                    </span>
                    <span class="stat-item">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                        <path d="M21.99 4c0-1.1-.89-2-1.99-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14l4 4-.01-18z"/>
                      </svg>
                      <span>{post.comments_count}</span>
                    </span>
                  </div>
                  <p class="overlay-caption">
                    {post.caption?.replace(/#experienciadmr/gi, '').trim().substring(0, 110)}...
                  </p>
                  <span class="overlay-cta">Ver en detalle →</span>
                </div>
              </div>

              <!-- Pie de Tarjeta con Autor y Fecha -->
              <div class="card-footer-info">
                <span class="card-author">{post.author}</span>
                <span class="card-date">
                  {new Date(post.published_at).toLocaleDateString('es-VE', { month: 'short', day: 'numeric', year: 'numeric' })}
                </span>
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>

    <!-- MODAL / LIGHTBOX INTERACTIVO -->
    <div id="gallery-lightbox" class="lightbox-modal is-hidden" role="dialog" aria-modal="true">
      <div class="lightbox-backdrop" id="lightbox-backdrop"></div>
      
      <div class="lightbox-container">
        <!-- Barra Superior del Modal -->
        <div class="lightbox-header">
          <div class="lightbox-author-block">
            <div class="author-avatar">BM</div>
            <div>
              <span class="author-handle" id="modal-author">@brandmeister_yv</span>
              <span class="author-date" id="modal-date">Fecha</span>
            </div>
          </div>

          <div class="lightbox-actions">
            <a href="#" target="_blank" rel="noopener noreferrer" class="btn-modal-ig" id="modal-ig-link">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span>Ver en Instagram</span>
            </a>
            <button type="button" class="btn-close-modal" id="btn-close-modal" aria-label="Cerrar visor">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        </div>

        <!-- Área Central de Visualización de Medios -->
        <div class="lightbox-body">
          <div class="lightbox-media-container" id="modal-media-wrap">
            <!-- El contenido dinámico (Imagen, Carrusel o Video) se inserta aquí vía JS -->
          </div>

          <!-- Controles de Carrusel (Solo visibles si es CAROUSEL_ALBUM) -->
          <div class="carousel-nav-controls is-hidden" id="carousel-nav">
            <button type="button" class="btn-carousel-prev" id="btn-carousel-prev" aria-label="Imagen anterior">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <div class="carousel-counter-badge" id="carousel-counter">1 / 4</div>
            <button type="button" class="btn-carousel-next" id="btn-carousel-next" aria-label="Imagen siguiente">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        </div>

        <!-- Pie del Modal con Texto y Hashtags -->
        <div class="lightbox-footer">
          <div class="lightbox-caption" id="modal-caption"></div>
          <div class="lightbox-stats-footer">
            <span class="footer-stat">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
              <span id="modal-likes">0</span> Me gusta
            </span>
            <span class="footer-stat">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                <path d="M21.99 4c0-1.1-.89-2-1.99-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14l4 4-.01-18z"/>
              </svg>
              <span id="modal-comments">0</span> Comentarios
            </span>
          </div>
        </div>

      </div>
    </div>

  </main>
</Layout>

<!-- Datos iniciales embebidos para acceso del script cliente -->
<script define:vars={{ initialPosts }} is:inline>
  window.__GALLERY_POSTS__ = initialPosts;
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const posts = window.__GALLERY_POSTS__ || [];
    const filterButtons = document.querySelectorAll('#gallery-filters .filter-pill');
    const cards = document.querySelectorAll('.gallery-card');
    
    // Elementos del Modal Lightbox
    const modal = document.getElementById('gallery-lightbox');
    const backdrop = document.getElementById('lightbox-backdrop');
    const btnClose = document.getElementById('btn-close-modal');
    const modalMediaWrap = document.getElementById('modal-media-wrap');
    const modalAuthor = document.getElementById('modal-author');
    const modalDate = document.getElementById('modal-date');
    const modalIgLink = document.getElementById('modal-ig-link');
    const modalCaption = document.getElementById('modal-caption');
    const modalLikes = document.getElementById('modal-likes');
    const modalComments = document.getElementById('modal-comments');
    const carouselNav = document.getElementById('carousel-nav');
    const carouselCounter = document.getElementById('carousel-counter');
    const btnCarouselPrev = document.getElementById('btn-carousel-prev');
    const btnCarouselNext = document.getElementById('btn-carousel-next');

    let currentPostIndex = 0;
    let currentCarouselIndex = 0;

    // 1. Filtrado de Publicaciones (Todos / Fotos / Carruseles / Videos)
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        const filter = btn.getAttribute('data-filter');
        cards.forEach(card => {
          const type = card.getAttribute('data-type');
          if (filter === 'all' || type === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // 2. Abrir Modal Lightbox
    const openLightbox = (index) => {
      const post = posts[index];
      if (!post) return;

      currentPostIndex = index;
      currentCarouselIndex = 0;

      modalAuthor.textContent = post.author || '@brandmeister_yv';
      modalDate.textContent = new Date(post.published_at).toLocaleDateString('es-VE', { 
        year: 'numeric', month: 'long', day: 'numeric' 
      });
      modalIgLink.href = post.permalink || 'https://www.instagram.com/brandmeister_yv/';
      modalLikes.textContent = post.likes_count || 0;
      modalComments.textContent = post.comments_count || 0;

      // Resaltar hashtags y menciones en el caption (excluyendo #experienciadmr de la vista)
      const rawCaption = (post.caption || '').replace(/#experienciadmr\s*/gi, '').trim();
      const formattedCaption = rawCaption
        .replace(/(#\w+)/g, '<span class="hl-hashtag">$1</span>')
        .replace(/(@\w+)/g, '<span class="hl-mention">$1</span>');
      modalCaption.innerHTML = formattedCaption;

      // Renderizar el medio correspondiente
      renderMedia(post);

      modal.classList.remove('is-hidden');
      document.body.style.overflow = 'hidden';
    };

    // Renderizado según tipo de medio (IMAGE, CAROUSEL_ALBUM, VIDEO)
    const renderMedia = (post) => {
      modalMediaWrap.innerHTML = '';

      if (post.media_type === 'CAROUSEL_ALBUM') {
        const carousel = post.carousel_media || [];
        carouselNav.classList.remove('is-hidden');
        updateCarouselSlide(carousel);
      } else if (post.media_type === 'VIDEO') {
        carouselNav.classList.add('is-hidden');
        if (post.video_url) {
          modalMediaWrap.innerHTML = `
            <div class="video-player-wrapper">
              <video 
                src="${post.video_url}" 
                controls 
                autoplay 
                playsinline 
                loop 
                poster="${post.thumbnail_url || post.media_url}"
                class="lightbox-video"
              >
                Tu navegador no soporta reproducción de video HTML5.
              </video>
            </div>
          `;
        } else {
          modalMediaWrap.innerHTML = `
            <img src="${post.media_url}" alt="${post.caption}" class="lightbox-img" />
          `;
        }
      } else {
        // IMAGE sencilla
        carouselNav.classList.add('is-hidden');
        modalMediaWrap.innerHTML = `
          <img src="${post.media_url}" alt="${post.caption}" class="lightbox-img" />
        `;
      }
    };

    // Actualizar diapositiva de Carrusel
    const updateCarouselSlide = (carousel) => {
      if (!carousel || carousel.length === 0) return;
      
      const slide = carousel[currentCarouselIndex];
      carouselCounter.textContent = `${currentCarouselIndex + 1} / ${carousel.length}`;

      modalMediaWrap.innerHTML = `
        <div class="carousel-slide-view">
          <img src="${slide.url}" alt="Foto ${currentCarouselIndex + 1}" class="lightbox-img" />
          ${slide.caption ? `<div class="slide-caption-bar">${slide.caption}</div>` : ''}
        </div>
      `;
    };

    // Navegación de Carrusel (Anterior / Siguiente)
    btnCarouselPrev?.addEventListener('click', (e) => {
      e.stopPropagation();
      const post = posts[currentPostIndex];
      const carousel = post?.carousel_media || [];
      if (carousel.length > 0) {
        currentCarouselIndex = (currentCarouselIndex - 1 + carousel.length) % carousel.length;
        updateCarouselSlide(carousel);
      }
    });

    btnCarouselNext?.addEventListener('click', (e) => {
      e.stopPropagation();
      const post = posts[currentPostIndex];
      const carousel = post?.carousel_media || [];
      if (carousel.length > 0) {
        currentCarouselIndex = (currentCarouselIndex + 1) % carousel.length;
        updateCarouselSlide(carousel);
      }
    });

    // Cerrar Modal
    const closeLightbox = () => {
      modal.classList.add('is-hidden');
      document.body.style.overflow = '';
      // Detener video si estaba reproduciéndose
      const vid = modalMediaWrap.querySelector('video');
      if (vid) vid.pause();
    };

    btnClose?.addEventListener('click', closeLightbox);
    backdrop?.addEventListener('click', closeLightbox);

    // Tecla ESC para cerrar modal y flechas para carrusel
    document.addEventListener('keydown', (e) => {
      if (modal.classList.contains('is-hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') btnCarouselPrev?.click();
      if (e.key === 'ArrowRight') btnCarouselNext?.click();
    });

    // Eventos Click en Tarjetas
    cards.forEach(card => {
      card.addEventListener('click', () => {
        const idx = parseInt(card.getAttribute('data-index') || '0', 10);
        openLightbox(idx);
      });

      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const idx = parseInt(card.getAttribute('data-index') || '0', 10);
          openLightbox(idx);
        }
      });
    });
  });
</script>

<style>
  .gallery-page {
    background-color: var(--bg-page);
    min-height: 100vh;
  }

  /* ====================================================================
     HERO SECTION (50vh) - Con tratamiento oficial de marca
     ==================================================================== */
  .gallery-hero {
    position: relative;
    min-height: 50vh;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #FFFFFF;
    background-image:
      linear-gradient(90deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.94) 45%, rgba(255, 255, 255, 0.65) 75%, rgba(255, 255, 255, 0.2) 100%),
      linear-gradient(0deg, #FAFAFA 0%, rgba(255, 255, 255, 0.8) 12%, transparent 35%),
      url('/assets/hero-dmr-venezuela-landscape.jpg');
    background-size: cover;
    background-position: right center;
    background-repeat: no-repeat;
    padding: 3.5rem 0;
  }

  @media (max-width: 768px) {
    .gallery-hero {
      min-height: 50vh;
      background-image:
        linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.92) 50%, rgba(255, 255, 255, 0.65) 80%, rgba(255, 255, 255, 0.35) 100%),
        url('/assets/hero-dmr-venezuela-landscape.jpg');
      background-position: center top;
      background-size: cover;
      padding: 2.5rem 0;
    }
  }

  .hero-content {
    max-width: 820px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #E1306C;
    border: 1px solid rgba(225, 48, 108, 0.4);
    background: rgba(225, 48, 108, 0.05);
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #E1306C;
    box-shadow: 0 0 8px rgba(225, 48, 108, 0.6);
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.3rem, 4.8vw, 3.5rem);
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.12;
    margin-bottom: 1.1rem;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 1.8vw, 1.22rem);
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    max-width: 740px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .btn-ig-follow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: linear-gradient(45deg, #F58529, #DD2A7B, #8134AF);
    color: #FFFFFF;
    font-size: 0.92rem;
    font-weight: 700;
    padding: 0.65rem 1.25rem;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 14px rgba(221, 42, 123, 0.25);
  }

  .btn-ig-follow:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(221, 42, 123, 0.35);
  }

  .btn-arrow {
    font-weight: 800;
  }

  .hero-hashtag-pill {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--bm-red);
    background: rgba(232, 38, 28, 0.08);
    padding: 0.5rem 1rem;
