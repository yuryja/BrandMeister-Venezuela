---
import Layout from '../layouts/Layout.astro';

// Las publicaciones se cargan en el navegador desde /api/gallery.php (subidas desde el panel)
---

<Layout
  heroImage={{ desktop: '/assets/hero-dmr-venezuela-landscape.webp', mobile: '/assets/hero-dmr-venezuela-landscape-m.webp' }}
  title="Galería · BrandMeister Venezuela"
  description="Fotografías de campo, montajes en repetidores, estaciones y videos de la comunidad de radioaficionados @brandmeister_yv."
>
  <main class="gallery-page">
    <!-- Hero 50vh con fotografía de radioafición y tratamiento de marca -->
    <section class="gallery-hero">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">
            <span>Comunidad @brandmeister_yv</span>
          </div>
          <h1 class="hero-title">Galería BrandMeister</h1>
          <p class="hero-subtitle">
            La voz, las vivencias y la tecnología que unen a los radioaficionados de Venezuela. Descubre las activaciones de campo, instalaciones en cerros, configuraciones de hotspots y transmisiones compartidas en nuestra red.
          </p>
          <div class="hero-actions">
            <a
              href="https://www.instagram.com/brandmeister_yv/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ig-follow"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
              <span>Seguir en Instagram @brandmeister_yv</span>
              <span class="btn-arrow">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Franja divisoria con degradado de 3 colores BrandMeister -->
    <div class="bm-stripe"></div>

    <!-- Sección Principal de Galería -->
    <section class="gallery-section section-padding">
      <div class="container">
        
        <!-- Barra de Filtros por Tipo de Medio -->
        <div class="gallery-toolbar">
          <div class="filter-pills" id="gallery-filters">
            <button class="filter-pill is-active" data-filter="all">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
              <span>Todos <span class="filter-count" data-count="all"></span></span>
            </button>
            <button class="filter-pill" data-filter="IMAGE">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                <circle cx="12" cy="13" r="4"></circle>
              </svg>
              <span>Fotos</span>
            </button>
            <button class="filter-pill" data-filter="CAROUSEL_ALBUM">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="14" height="14" rx="2" ry="2"></rect>
                <path d="M7 21h12a2 2 0 0 0 2-2V7"></path>
              </svg>
              <span>Carruseles / Álbumes</span>
            </button>
            <button class="filter-pill" data-filter="VIDEO">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
              <span>Videos & Reels</span>
            </button>
          </div>

          <div class="gallery-legend">
            <span>Comunidad y actividades de la red BrandMeister Venezuela</span>
          </div>
        </div>

        <!-- Cuadrícula de Publicaciones -->
        <div class="gallery-grid" id="gallery-grid" aria-live="polite" aria-busy="true">
          {Array.from({ length: 6 }).map(() => (
            <div class="gallery-card is-skeleton" aria-hidden="true">
              <div class="card-media-wrap"></div>
              <div class="card-content">
                <span class="skeleton-line" style="width: 28%;"></span>
                <span class="skeleton-line" style="width: 85%;"></span>
              </div>
            </div>
          ))}
        </div>

        <div class="gallery-empty" id="gallery-empty" hidden>
          <h2>Pronto verás aquí las fotos de la comunidad</h2>
          <p>Estamos preparando la galería con las activaciones, montajes y estaciones de la red. Vuelve pronto.</p>
        </div>
        </div>

      </div>
    </section>

    <!-- MODAL / LIGHTBOX INTERACTIVO -->
    <div id="gallery-lightbox" class="lightbox-modal is-hidden" role="dialog" aria-modal="true">
      <div class="lightbox-backdrop" id="lightbox-backdrop"></div>
      
      <div class="lightbox-container" id="lightbox-container">
        <!-- Barra Superior del Modal (Ver original a la izquierda, Cerrar a la derecha) -->
        <div class="lightbox-header">
          <a href="#" target="_blank" rel="noopener noreferrer" class="btn-modal-ig" id="modal-ig-link">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>Ver original</span>
          </a>
          <button type="button" class="btn-close-modal" id="btn-close-modal" aria-label="Cerrar visor">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <!-- Área Central de Visualización de Medios -->
        <div class="lightbox-body">
          <div class="lightbox-media-container" id="modal-media-wrap">
            <!-- El contenido dinámico (Imagen, Carrusel o Video) se inserta aquí vía JS -->
          </div>

          <!-- Controles de Carrusel (Solo visibles si es CAROUSEL_ALBUM) -->
          <div class="carousel-nav-controls is-hidden" id="carousel-nav">
            <button type="button" class="btn-carousel-prev" id="btn-carousel-prev" aria-label="Imagen anterior">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <div class="carousel-counter-badge" id="carousel-counter">1 / 4</div>
            <button type="button" class="btn-carousel-next" id="btn-carousel-next" aria-label="Imagen siguiente">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        </div>

        <!-- Pie del Modal con Fecha y Texto Amplio -->
        <div class="lightbox-footer">
          <div class="lightbox-footer-meta">
            <span class="lightbox-date" id="modal-date"></span>
          </div>
          <div class="lightbox-caption" id="modal-caption"></div>
        </div>

      </div>
    </div>

  </main>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    let posts = [];
    const grid = document.getElementById('gallery-grid');
    const emptyState = document.getElementById('gallery-empty');
    const filterButtons = document.querySelectorAll('#gallery-filters .filter-pill');

    // Elementos del Modal Lightbox
    const modal = document.getElementById('gallery-lightbox');
    const modalContainer = document.getElementById('lightbox-container');
    const backdrop = document.getElementById('lightbox-backdrop');
    const btnClose = document.getElementById('btn-close-modal');
    const modalMediaWrap = document.getElementById('modal-media-wrap');
    const modalDate = document.getElementById('modal-date');
    const modalIgLink = document.getElementById('modal-ig-link');
    const modalCaption = document.getElementById('modal-caption');
    const carouselNav = document.getElementById('carousel-nav');
    const carouselCounter = document.getElementById('carousel-counter');
    const btnCarouselPrev = document.getElementById('btn-carousel-prev');
    const btnCarouselNext = document.getElementById('btn-carousel-next');

    let currentPostIndex = 0;
    let currentCarouselIndex = 0;

    const escapeHtml = (value) =>
      String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

    // Solo URLs http(s) o rutas del propio sitio; evita javascript:, data:, etc.
    const safeUrl = (value, fallback = '') => {
      try {
        const url = new URL(String(value ?? ''), window.location.origin);
        return url.protocol === 'http:' || url.protocol === 'https:' ? url.href : fallback;
      } catch {
        return fallback;
      }
    };

    const formatDate = (ts, opts) => new Date(ts * 1000).toLocaleDateString('es-VE', opts);

    const ICONS = {
      carousel: '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12z"/></svg>',
    };

    const cardHtml = (post, index) => {
      const caption = String(post.caption || '').trim();
      const excerpt = caption.length > 115 ? caption.slice(0, 115) + '…' : caption;
      const isVideo = post.media_type === 'VIDEO';
      const isCarousel = post.media_type === 'CAROUSEL_ALBUM';
      const carouselCount = (post.carousel_media || []).length || 2;
      const thumbSrc = safeUrl(post.thumbnail_url || post.media_url);

      return `
        <article class="gallery-card" data-type="${escapeHtml(post.media_type)}" data-index="${index}" tabindex="0" role="button" aria-label="Ver publicación">
          <div class="card-media-wrap">
            <img src="${escapeHtml(thumbSrc)}" alt="${escapeHtml(caption.slice(0, 80) || 'Publicación BrandMeister Venezuela')}" loading="lazy" class="card-img" />
            ${isVideo ? `
              <div class="card-play-button" aria-label="Reproducir video">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                  <polygon points="8 5 19 12 8 19 8 5"></polygon>
                </svg>
              </div>` : ''}
            ${isCarousel ? `
              <div class="card-type-badge">
                <span class="badge-carousel" title="Álbum con múltiples fotos">${ICONS.carousel}<span>${carouselCount}</span></span>
              </div>` : ''}
            <div class="card-hover-overlay">
              <span class="overlay-cta">${isVideo ? 'Reproducir video →' : 'Ver en detalle →'}</span>
            </div>
          </div>
          <div class="card-content">
            <div class="card-meta">
              <time class="card-date">${formatDate(post.published_ts, { month: 'short', day: 'numeric', year: 'numeric' })}</time>
            </div>
            ${excerpt ? `<p class="card-preview-caption">${escapeHtml(excerpt)}</p>` : ''}
          </div>
        </article>`;
    };

    const render = () => {
      grid.setAttribute('aria-busy', 'false');
      grid.innerHTML = posts.map(cardHtml).join('');
      emptyState.hidden = posts.length > 0;
      const allCount = document.querySelector('[data-count="all"]');
      if (allCount) allCount.textContent = `(${posts.length})`;
      applyFilter(document.querySelector('#gallery-filters .filter-pill.is-active')?.getAttribute('data-filter') || 'all');
    };

    const applyFilter = (filter) => {
      grid.querySelectorAll('.gallery-card').forEach((card) => {
        card.style.display = filter === 'all' || card.getAttribute('data-type') === filter ? 'flex' : 'none';
      });
    };

    // Datos de muestra para previsualización en entorno de desarrollo local (localhost)
    const sampleDevPosts = [
      {
        id: 'dev-1',
        media_type: 'VIDEO',
        media_url: '/assets/hero-dmr-venezuela-landscape.webp',
        thumbnail_url: '/assets/hero-dmr-venezuela-landscape.webp',
        video_url: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4',
        caption: 'Prueba de enlace y transmisión en repetidor DMR Caracas #BrandMeister #DMR @brandmeister_yv con excelente modulación en Slot 1 TG 734.',
        author: '@brandmeister_yv',
        permalink: 'https://www.instagram.com/p/sample1/',
        published_ts: 1789700000,
      },
      {
        id: 'dev-2',
        media_type: 'IMAGE',
        media_url: '/assets/hero-dmr-venezuela-landscape.webp',
        thumbnail_url: '/assets/hero-dmr-venezuela-landscape.webp',
        video_url: null,
        caption: 'Instalación de antena y duplexor en Cerro El Ávila para la red nacional #Venezuela #Radioaficionados #BrandMeister.',
        author: '@brandmeister_yv',
        permalink: 'https://www.instagram.com/p/sample2/',
        published_ts: 1789600000,
      },
      {
        id: 'dev-3',
        media_type: 'CAROUSEL_ALBUM',
        media_url: '/assets/hero-dmr-venezuela-landscape.webp',
        thumbnail_url: '/assets/hero-dmr-venezuela-landscape.webp',
        carousel_media: [
          { url: '/assets/hero-dmr-venezuela-landscape.webp', caption: 'Montaje de torre y mástil' },
          { url: '/assets/hero-dmr-venezuela-landscape-m.webp', caption: 'Verificación de ROE y potencia' }
        ],
        video_url: null,
        caption: 'Álbum completo de la jornada de mantenimiento técnico en la estación repetidora #Comunidad #Radio #TG734.',
        author: '@brandmeister_yv',
        permalink: null,
        published_ts: 1789500000,
      }
    ];

    // 1. Carga de publicaciones sincronizadas
    fetch('/api/gallery.php', { headers: { Accept: 'application/json' } })
      .then((res) => {
        if (!res.ok) throw new Error('API no disponible');
        return res.json();
      })
      .then((data) => {
        posts = Array.isArray(data?.posts) && data.posts.length > 0 ? data.posts : (window.location.hostname === 'localhost' ? sampleDevPosts : []);
        render();
      })
      .catch(() => {
        posts = window.location.hostname === 'localhost' ? sampleDevPosts : [];
        render();
      });

    // 2. Filtrado de Publicaciones (Todos / Fotos / Carruseles / Videos)
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        applyFilter(btn.getAttribute('data-filter'));
      });
    });

    // 3. Abrir Modal Lightbox
    const openLightbox = (index) => {
      const post = posts[index];
      if (!post) return;

      currentPostIndex = index;
      currentCarouselIndex = 0;

      modalDate.textContent = formatDate(post.published_ts, { year: 'numeric', month: 'long', day: 'numeric' });
      const external = post.permalink ? safeUrl(post.permalink) : '';
      modalIgLink.href = external || '#';
      modalIgLink.style.display = external ? 'inline-flex' : 'none';

      // Resaltar hashtags y menciones en el texto
      const cleanCaption = escapeHtml(String(post.caption || '').trim())
        .replace(/(#[\p{L}\p{N}_]+)/gu, '<span class="hl-hashtag">$1</span>')
        .replace(/(@[\w.]+)/g, '<span class="hl-mention">$1</span>');
      modalCaption.innerHTML = cleanCaption || '<em style="color: var(--text-muted); font-style: normal;">Publicación sin texto descriptivo.</em>';

      renderMedia(post);

      modal.classList.remove('is-hidden');
      document.body.style.overflow = 'hidden';
    };

    let currentMediaSizer = null;

    // Ajusta perfectamente el modal a la proporción del video o imagen (sin espacios negros)
    const adjustToMediaProportion = (w, h, mediaEl) => {
      if (!w || !h || !modalContainer) return;
      const ratio = w / h;
      const isMobile = window.innerWidth <= 640;

      // Límites del visor según el dispositivo
      const maxAvailableW = isMobile ? Math.min(window.innerWidth * 0.96, 520) : Math.min(window.innerWidth * 0.90, 880);
      const maxAvailableH = isMobile ? window.innerHeight * 0.50 : Math.min(window.innerHeight * 0.60, 620);

      let targetW = maxAvailableH * ratio;
      let targetH = maxAvailableH;

      if (targetW > maxAvailableW) {
        targetW = maxAvailableW;
        targetH = targetW / ratio;
      }

      targetW = Math.round(targetW);
      targetH = Math.round(targetH);

      modalContainer.style.width = `${targetW}px`;
      modalContainer.style.maxWidth = `${targetW}px`;

      if (mediaEl) {
        mediaEl.style.width = '100%';
        mediaEl.style.height = `${targetH}px`;
        mediaEl.style.aspectRatio = `${w} / ${h}`;
        mediaEl.style.objectFit = 'contain';
      }

      const wrapper = modalMediaWrap.querySelector('.video-player-wrapper') || modalMediaWrap.querySelector('.carousel-slide-view');
      if (wrapper) {
        wrapper.style.width = `${targetW}px`;
        wrapper.style.height = `${targetH}px`;
        wrapper.style.aspectRatio = `${w} / ${h}`;
      }
    };

    window.addEventListener('resize', () => {
      if (!modal.classList.contains('is-hidden') && typeof currentMediaSizer === 'function') {
        currentMediaSizer();
      }
    });

    // Renderizado según tipo de medio (IMAGE, CAROUSEL_ALBUM, VIDEO)
    const renderMedia = (post) => {
      modalMediaWrap.innerHTML = '';
      currentMediaSizer = null;

      if (post.media_type === 'CAROUSEL_ALBUM' && (post.carousel_media || []).length) {
        carouselNav.classList.remove('is-hidden');
        updateCarouselSlide(post.carousel_media);
      } else if (post.media_type === 'VIDEO' && (post.video_url || post.media_url)) {
        carouselNav.classList.add('is-hidden');
        const videoSrc = safeUrl(post.video_url || post.media_url);
        const posterSrc = post.thumbnail_url ? safeUrl(post.thumbnail_url) : '';
        modalMediaWrap.innerHTML = `
          <div class="video-player-wrapper">
            <video src="${escapeHtml(videoSrc)}" controls autoplay playsinline loop muted
              ${posterSrc ? `poster="${escapeHtml(posterSrc)}"` : ''} class="lightbox-video">
              Tu navegador no soporta reproducción de video HTML5.
            </video>
          </div>`;

        const video = modalMediaWrap.querySelector('video');
        if (video) {
          video.loop = true;
          video.autoplay = true;
          video.playsInline = true;
          video.currentTime = 0;

          // Ajuste exacto al ratio del video
          currentMediaSizer = () => adjustToMediaProportion(video.videoWidth, video.videoHeight, video);

          if (video.readyState >= 1) {
            currentMediaSizer();
          } else {
            video.addEventListener('loadedmetadata', currentMediaSizer, { once: true });
          }

          // Reproducción automática inmediata con fallback a muted por políticas del navegador
          const playPromise = video.play();
          if (playPromise !== undefined) {
            playPromise.catch(() => {
              video.muted = true;
              video.play().catch(() => {});
            });
          }

          // Garantizar reproducción infinita
          video.addEventListener('ended', () => {
            video.currentTime = 0;
            video.play().catch(() => {});
          });
        }
      } else {
        carouselNav.classList.add('is-hidden');
        const imgSrc = safeUrl(post.media_url || post.thumbnail_url);
        modalMediaWrap.innerHTML = `<img src="${escapeHtml(imgSrc)}" alt="${escapeHtml(String(post.caption || '').trim().slice(0, 120))}" class="lightbox-img" />`;

        const img = modalMediaWrap.querySelector('img');
        if (img) {
          currentMediaSizer = () => adjustToMediaProportion(img.naturalWidth, img.naturalHeight, img);
          if (img.complete && img.naturalWidth) currentMediaSizer();
          else img.addEventListener('load', currentMediaSizer, { once: true });
        }
      }
    };

    // Actualizar diapositiva de Carrusel
    const updateCarouselSlide = (carousel) => {
      if (!carousel || carousel.length === 0) return;
      const slide = carousel[currentCarouselIndex];
      carouselCounter.textContent = `${currentCarouselIndex + 1} / ${carousel.length}`;
      modalMediaWrap.innerHTML = `
        <div class="carousel-slide-view">
          <img src="${escapeHtml(safeUrl(slide.url))}" alt="Foto ${currentCarouselIndex + 1}" class="lightbox-img" />
          ${slide.caption ? `<div class="slide-caption-bar">${escapeHtml(slide.caption)}</div>` : ''}
        </div>`;

      const img = modalMediaWrap.querySelector('img');
      if (img) {
        currentMediaSizer = () => adjustToMediaProportion(img.naturalWidth, img.naturalHeight, img);
        if (img.complete && img.naturalWidth) currentMediaSizer();
        else img.addEventListener('load', currentMediaSizer, { once: true });
      }
    };

    const stepCarousel = (delta) => {
      const carousel = posts[currentPostIndex]?.carousel_media || [];
      if (carousel.length > 0) {
        currentCarouselIndex = (currentCarouselIndex + delta + carousel.length) % carousel.length;
        updateCarouselSlide(carousel);
      }
    };

    btnCarouselPrev?.addEventListener('click', (e) => {
      e.stopPropagation();
      stepCarousel(-1);
    });
    btnCarouselNext?.addEventListener('click', (e) => {
      e.stopPropagation();
      stepCarousel(1);
    });

    // Cerrar Modal
    const closeLightbox = () => {
      modal.classList.add('is-hidden');
      document.body.style.overflow = '';
      modalMediaWrap.querySelectorAll('video').forEach((v) => {
        v.pause();
        v.currentTime = 0;
      });
      if (modalContainer) {
        modalContainer.style.width = '';
        modalContainer.style.maxWidth = '';
      }
      currentMediaSizer = null;
    };

    btnClose?.addEventListener('click', closeLightbox);
    backdrop?.addEventListener('click', closeLightbox);

    // Tecla ESC para cerrar modal y flechas para carrusel
    document.addEventListener('keydown', (e) => {
      if (modal.classList.contains('is-hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') stepCarousel(-1);
      if (e.key === 'ArrowRight') stepCarousel(1);
    });

    // Tarjetas generadas dinámicamente: delegación de eventos
    const cardIndex = (target) => {
      const card = target.closest('.gallery-card:not(.is-skeleton)');
      return card ? parseInt(card.getAttribute('data-index') || '0', 10) : null;
    };
    grid.addEventListener('click', (e) => {
      const idx = cardIndex(e.target);
      if (idx !== null) openLightbox(idx);
    });
    grid.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const idx = cardIndex(e.target);
      if (idx !== null) {
        e.preventDefault();
        openLightbox(idx);
      }
    });
  });
</script>

