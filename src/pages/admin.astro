---
import Layout from '../layouts/Layout.astro';
import UsersView from '../components/admin/UsersView.astro';
import ProfileView from '../components/admin/ProfileView.astro';
import GalleryView from '../components/admin/GalleryView.astro';
import PostsView from '../components/admin/PostsView.astro';
import '../styles/admin-accounts.css';
import '../styles/admin-gallery.css';
import '../styles/admin-posts.css';
import '../styles/admin-analytics.css';
---

<Layout
  title="Escritorio ‹ BrandMeister Venezuela"
  description="Panel de administración de BrandMeister Venezuela: noticias, galería y usuarios."
  chrome={false}
>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" slot="head" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" slot="head" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" slot="head"></script>
  <script is:inline src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js" slot="head"></script>
  <!-- WP LOGIN SCREEN (Shown if not authenticated) -->
  <div id="wp-login-screen" class="wp-login-wrapper">
    <div class="wp-login-card">
      <div class="wp-login-logo">
        <img src="/assets/logo.webp" alt="BrandMeister Venezuela" width="220" height="55" />
      </div>
      
      <div data-account-panel="login" id="account-panel-login">
      <div class="wp-login-header">
        <h2>Iniciar sesión</h2>
        <p>Acceso administrativo para Sysops y colaboradores autorizados</p>
      </div>

      <form id="login-form" class="wp-login-form">
        <div class="form-group">
          <label for="login-username">Usuario o Indicativo</label>
          <input type="text" id="login-username" class="form-input" placeholder="ej: YV5OF o yy3big" autocomplete="username" required />
        </div>

        <div class="form-group">
          <label for="login-password">Contraseña</label>
          <input type="password" id="login-password" class="form-input" placeholder="••••••••" autocomplete="current-password" required />
        </div>

        <p id="login-error" class="wp-login-error" role="alert" hidden></p>

        <button type="submit" id="login-submit" class="btn btn-primary wp-login-btn">
          <span>Acceder al Escritorio</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </form>
      <p class="wp-login-links"><a href="#" data-show-panel="forgot">¿Olvidaste tu contraseña?</a></p>
      </div>

      <!-- ¿Olvidaste tu contraseña? -->
      <div data-account-panel="forgot" id="account-panel-forgot" hidden>
        <div class="wp-login-header">
          <h2>Restablecer contraseña</h2>
          <p>Escribe tu usuario, indicativo o correo y te enviaremos un enlace.</p>
        </div>
        <form id="forgot-form" class="wp-login-form">
          <div class="form-group">
            <label for="forgot-identifier">Usuario, indicativo o correo</label>
            <input type="text" id="forgot-identifier" class="form-input" autocomplete="username" maxlength="120" required />
          </div>
          <p id="forgot-message" class="wp-login-error" role="status" hidden></p>
          <button type="submit" id="forgot-submit" class="btn btn-primary wp-login-btn">Enviar enlace</button>
        </form>
        <p class="wp-login-links"><a href="#" data-show-panel="login">← Volver a iniciar sesión</a></p>
      </div>

      <!-- Crear / restablecer contraseña desde el enlace del correo (?clave=) -->
      <div data-account-panel="set-password" id="account-panel-set-password" hidden>
        <div class="wp-login-header">
          <h2 id="set-password-title">Comprobando enlace…</h2>
          <p id="set-password-intro"></p>
        </div>
        <form id="set-password-form" class="wp-login-form">
          <input type="text" name="username" autocomplete="username" hidden />
          <div class="form-group">
            <label for="sp-password">Nueva contraseña</label>
            <div class="password-field">
              <input type="password" id="sp-password" class="form-input" autocomplete="new-password" minlength="10" maxlength="200" required />
              <button type="button" class="btn btn-secondary btn-sm" data-toggle-password="sp-password">Mostrar</button>
            </div>
            <span class="field-hint">Mínimo 10 caracteres.</span>
          </div>
          <div class="form-group">
            <label for="sp-password-confirm">Repite la contraseña</label>
            <input type="password" id="sp-password-confirm" class="form-input" autocomplete="new-password" minlength="10" maxlength="200" required />
          </div>
          <p id="set-password-message" class="wp-login-error" role="alert" hidden></p>
          <button type="submit" id="set-password-submit" class="btn btn-primary wp-login-btn">Guardar contraseña</button>
        </form>
        <p class="wp-login-links"><a href="#" data-show-panel="login">Ir a iniciar sesión</a></p>
      </div>
    </div>
  </div>

  <!-- PANEL DE ADMINISTRACIÓN (ESTILO WORDPRESS) -->
  <div id="wp-app" class="wp-admin-app" style="display: none;">
    <!-- TOP WP ADMIN BAR -->
    <header class="wp-adminbar">
      <div class="adminbar-left">
        <a href="/" class="adminbar-site-link" target="_blank" title="Ver sitio público">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--bm-orange)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span class="site-name">BrandMeister Venezuela</span>
          <span class="visit-label">↗</span>
        </a>
      </div>

      <div class="adminbar-right">
        <div class="user-profile-menu">
          <button type="button" class="greeting greeting-link" data-view="profile" title="Editar tu perfil">Hola, <strong id="bar-user-name"></strong></button>
          <span id="bar-user-role" class="role-badge"></span>
          <button id="btn-logout" class="btn-logout" title="Cerrar sesión">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Salir</span>
          </button>
        </div>
      </div>
    </header>

    <div class="wp-admin-layout">
      <!-- LEFT WP SIDEBAR -->
      <aside class="wp-sidebar">
        <ul class="wp-menu">
          <li class="wp-menu-item">
            <button class="menu-link is-active" data-view="dashboard">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
              <span>Escritorio</span>
            </button>
          </li>

          <li class="wp-menu-item has-submenu">
            <button class="menu-link" data-view="posts">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
              <span>Noticias</span>
              <span class="count-pill" id="menu-posts-count" hidden></span>
            </button>
            <ul class="wp-submenu">
              <li><button class="submenu-link is-active" data-view="posts">Todas las noticias</button></li>
              <li><button class="submenu-link" data-view="new-post">Añadir nueva</button></li>
            </ul>
          </li>

          <li class="wp-menu-item" id="menu-site-content-item">
            <button class="menu-link" data-view="site-content">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
              </svg>
              <span>Textos del Portal</span>
            </button>
          </li>

          <li class="wp-menu-item has-submenu" id="menu-gallery-item">
            <button class="menu-link" data-view="gallery">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
              <span>Galería</span>
            </button>
            <ul class="wp-submenu">
              <li><button class="submenu-link" data-view="gallery">Todas</button></li>
              <li><button class="submenu-link" data-view="gallery-edit">Añadir publicación</button></li>
            </ul>
          </li>

          <!-- Usuarios (solo Administrador) -->
          <li class="wp-menu-item has-submenu" id="menu-users-item">
            <button class="menu-link" data-view="users">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
              <span>Usuarios</span>
            </button>
            <ul class="wp-submenu">
              <li><button class="submenu-link" data-view="users">Todos los usuarios</button></li>
              <li><button class="submenu-link" data-view="user-new">Añadir nuevo</button></li>
              <li><button class="submenu-link" data-view="profile">Perfil</button></li>
            </ul>
          </li>

          <!-- Perfil (Editor y Autor; el Administrador lo tiene dentro de Usuarios) -->
          <li class="wp-menu-item" id="menu-profile-item">
            <button class="menu-link" data-view="profile">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <span>Perfil</span>
            </button>
          </li>

        </ul>
      </aside>

      <!-- MAIN CONTENT STAGE -->
      <main class="wp-content-stage">
        <!-- ========================================================= -->
        <!-- VIEW 1: ESCRITORIO (DASHBOARD) -->
        <!-- ========================================================= -->
        <!-- ========================================================= -->
        <!-- VIEW 1: ESCRITORIO (DASHBOARD & ANALYTICS) -->
        <!-- ========================================================= -->
        <section id="view-dashboard" class="wp-view is-active">
          <div class="view-header">
            <div>
              <h1 class="view-title">Escritorio y Analíticas</h1>
              <p class="view-subtitle">Métricas de oyentes, clics en enlaces, lectura de publicaciones y compartidos.</p>
            </div>
            <div class="analytics-time-filter">
              <span class="filter-indicator">● En vivo</span>
              <button type="button" class="btn-time-range is-active" data-range="7d">7 días</button>
              <button type="button" class="btn-time-range" data-range="30d">30 días</button>
              <button type="button" class="btn-time-range" data-range="all">Histórico</button>
            </div>
          </div>

          <!-- 1. KPI SUMMARY CARDS -->
          <div class="analytics-kpi-grid">
            <div class="kpi-card">
              <div class="kpi-header">
                <span class="kpi-label">Reproductor Audio</span>
                <span class="kpi-icon-wrap icon-audio">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                    <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                  </svg>
                </span>
              </div>
              <div class="kpi-value" id="kpi-player-plays">--</div>
              <div class="kpi-footer">
                <span class="kpi-subtext"><strong id="kpi-unique-listeners">--</strong> oyentes únicos</span>
                <span class="kpi-badge">TG 734</span>
              </div>
            </div>

            <div class="kpi-card">
              <div class="kpi-header">
                <span class="kpi-label">Clics en Enlaces</span>
                <span class="kpi-icon-wrap icon-links">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                  </svg>
                </span>
              </div>
              <div class="kpi-value" id="kpi-link-clicks">--</div>
              <div class="kpi-footer">
                <span class="kpi-subtext">Red, Masters y RadioID</span>
                <span class="kpi-trend">Tráfico activo</span>
              </div>
            </div>

            <div class="kpi-card">
              <div class="kpi-header">
                <span class="kpi-label">Lectura de Noticias</span>
                <span class="kpi-icon-wrap icon-posts">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                  </svg>
                </span>
              </div>
              <div class="kpi-value" id="kpi-post-views">--</div>
              <div class="kpi-footer">
                <span class="kpi-subtext">Visitas al blog</span>
                <span class="kpi-trend">+14% mes</span>
              </div>
            </div>

            <div class="kpi-card">
              <div class="kpi-header">
                <span class="kpi-label">Compartidos</span>
                <span class="kpi-icon-wrap icon-shares">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="18" cy="5" r="3"></circle>
                    <circle cx="6" cy="12" r="3"></circle>
                    <circle cx="18" cy="19" r="3"></circle>
                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                  </svg>
                </span>
              </div>
              <div class="kpi-value" id="kpi-post-shares">--</div>
              <div class="kpi-footer">
                <span class="kpi-subtext">WhatsApp & Telegram</span>
                <span class="kpi-trend">Difusión</span>
              </div>
            </div>

            <div class="kpi-card">
              <div class="kpi-header">
                <span class="kpi-label">Países Conectados</span>
                <span class="kpi-icon-wrap icon-geo">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                  </svg>
                </span>
              </div>
              <div class="kpi-value" id="kpi-active-countries">--</div>
              <div class="kpi-footer">
                <span class="kpi-subtext">VE, US, ES, CO, CL, AR...</span>
                <span class="kpi-badge">Global</span>
              </div>
            </div>
          </div>

          <!-- 2. LARGE LEAFLET MAP WIDGET (With marker clusters) -->
          <div class="wp-box analytics-map-card">
            <div class="wp-box-head">
              <div class="map-head-title">
                <div class="map-title-row">
                  <span class="status-dot"></span>
                  <h3>Distribución Geográfica y Conexiones</h3>
                </div>
                <p class="map-subtitle">Mapa en vivo con agrupamiento (cluster) de oyentes, lectores y visitantes por país y ciudad.</p>
              </div>
              <div class="map-controls">
                <div class="map-filter-pills">
                  <button type="button" class="map-pill is-active" data-map-filter="all">Todos</button>
                  <button type="button" class="map-pill" data-map-filter="player_play">Reproductor</button>
                  <button type="button" class="map-pill" data-map-filter="link_click">Enlaces</button>
                  <button type="button" class="map-pill" data-map-filter="post_view">Publicaciones</button>
                </div>
                <button type="button" class="btn-map-reset" id="btn-reset-map" title="Centrar en Venezuela">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M3 12h3m12 0h3M12 3v3m0 12v3"></path>
                  </svg>
                  <span>Centrar</span>
                </button>
              </div>
            </div>
            <div class="wp-box-body" style="padding: 0; position: relative;">
              <div id="analytics-leaflet-map" style="width: 100%; height: 440px; background: #F8FAFC;"></div>
              <div class="map-legend">
                <span class="legend-item"><span class="cluster-sample sm"></span> 2 - 9 conexiones</span>
                <span class="legend-item"><span class="cluster-sample md"></span> 10 - 24 conexiones</span>
                <span class="legend-item"><span class="cluster-sample lg"></span> 25+ conexiones</span>
              </div>
            </div>
          </div>

          <!-- 3. AUDIO PLAYER TELEMETRY (Countries & IPs / Frequency) -->
          <div class="analytics-row-grid">
            <!-- Left: Player Countries -->
            <div class="wp-box">
              <div class="wp-box-head">
                <div>
                  <h3>Reproductor: Oyentes por País</h3>
                  <p class="box-sub">Distribución porcentual de reproducciones en TG 734</p>
                </div>
                <span class="badge-mini">Audio Hoseline</span>
              </div>
              <div class="wp-box-body">
                <div class="country-bars-list" id="player-countries-list">
                  <!-- Inyectado dinámicamente -->
                </div>
              </div>
            </div>

            <!-- Right: IP Listener Frequency ("cuantas veces lo hacen") -->
            <div class="wp-box">
              <div class="wp-box-head">
                <div>
                  <h3>Registro de Oyentes (IPs y Frecuencia)</h3>
                  <p class="box-sub">Direcciones IP, ciudad y cuántas veces han reproducido el audio</p>
                </div>
                <span class="badge-mini" id="listeners-total-count">Oyentes Activos</span>
              </div>
              <div class="wp-box-body" style="padding: 0;">
                <div class="table-responsive-minimal">
                  <table class="analytics-table">
                    <thead>
                      <tr>
                        <th>Dirección IP</th>
                        <th>Ubicación</th>
                        <th style="text-align: center;">Reproducciones</th>
                        <th style="text-align: right;">Última Actividad</th>
                      </tr>
                    </thead>
                    <tbody id="player-listeners-tbody">
                      <!-- Inyectado dinámicamente -->
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>

          <!-- 4. LINK CLICKS & SOCIAL SHARES ROW -->
          <div class="analytics-row-grid" style="margin-top: 1.5rem;">
            <!-- Clics en Enlaces -->
            <div class="wp-box">
              <div class="wp-box-head">
                <div>
                  <h3>Clics en Enlaces y Recursos</h3>
                  <p class="box-sub">Destinos más consultados por los operadores</p>
                </div>
                <span class="badge-mini">Enlaces salientes</span>
              </div>
              <div class="wp-box-body" style="padding: 0;">
                <div class="table-responsive-minimal">
                  <table class="analytics-table">
                    <thead>
                      <tr>
                        <th>Destino / Recurso</th>
                        <th>Categoría</th>
                        <th style="text-align: right;">Clics</th>
                      </tr>
                    </thead>
                    <tbody id="link-clicks-tbody">
                      <!-- Inyectado dinámicamente -->
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <!-- Compartidos en Redes Sociales -->
            <div class="wp-box">
              <div class="wp-box-head">
                <div>
                  <h3>Difusión en Redes Sociales</h3>
                  <p class="box-sub">Publicaciones compartidas por plataforma</p>
                </div>
                <span class="badge-mini">Viralidad</span>
              </div>
              <div class="wp-box-body">
                <div class="shares-distribution" id="social-shares-container">
                  <!-- Inyectado dinámicamente -->
                </div>
              </div>
            </div>
          </div>

          <!-- 5. PUBLICATIONS PERFORMANCE TABLE -->
          <div class="wp-box" style="margin-top: 1.5rem;">
            <div class="wp-box-head">
              <div>
                <h3>Rendimiento de Publicaciones y Artículos</h3>
                <p class="box-sub">Noticias con mayor lectura e interés de los operadores</p>
              </div>
              <button type="button" class="btn btn-secondary btn-sm" onclick="window.switchView('posts')">Ver Noticias</button>
            </div>
            <div class="wp-box-body" style="padding: 0;">
              <div class="table-responsive-minimal">
                <table class="analytics-table">
                  <thead>
                    <tr>
                      <th>Artículo</th>
                      <th>Categoría</th>
                      <th style="text-align: center;">Lecturas Totales</th>
                      <th style="text-align: center;">Compartidos</th>
                      <th style="text-align: right;">Interés</th>
                    </tr>
                  </thead>
                  <tbody id="posts-views-tbody">
