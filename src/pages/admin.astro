</style>

<script>
  // State variables
  let currentUser = {
    username: 'yv5of',
    callsign: 'YV5OF',
    name: 'Severino Mastracci',
    role: 'admin'
  };

  const checkAuth = () => {
    const saved = localStorage.getItem('bm_wp_user');
    if (saved) {
      try {
        currentUser = JSON.parse(saved);
        showApp();
      } catch (e) {
        showLogin();
      }
    } else {
      // Default to logged in as Sysop Admin for smooth pair programming experience
      localStorage.setItem('bm_wp_user', JSON.stringify(currentUser));
      showApp();
    }
  };

  const showLogin = () => {
    document.getElementById('wp-login-screen')!.style.display = 'flex';
    document.getElementById('wp-app')!.style.display = 'none';
  };

  const showApp = () => {
    document.getElementById('wp-login-screen')!.style.display = 'none';
    document.getElementById('wp-app')!.style.display = 'flex';
    applyACL();
  };

  // Apply Role-Based Access Control (ACL)
  const applyACL = () => {
    const barName = document.getElementById('bar-user-name');
    const barRole = document.getElementById('bar-user-role');
    const menuUsers = document.getElementById('menu-users-item');
    const menuSettings = document.getElementById('menu-settings-item');

    if (barName) barName.textContent = currentUser.callsign;
    if (barRole) {
      barRole.textContent = currentUser.role === 'admin' ? 'Administrador' : currentUser.role === 'editor' ? 'Editor' : 'Autor';
      barRole.className = `role-badge role-${currentUser.role}`;
    }

    // ACL Menu visibility
    if (currentUser.role === 'author') {
      if (menuUsers) menuUsers.style.display = 'none';
      if (menuSettings) menuSettings.style.display = 'none';
    } else if (currentUser.role === 'editor') {
      if (menuUsers) menuUsers.style.display = 'none';
      if (menuSettings) menuSettings.style.display = 'block';
    } else {
      // Admin
      if (menuUsers) menuUsers.style.display = 'block';
      if (menuSettings) menuSettings.style.display = 'block';
    }
  };

  // View Switching
  window.switchView = (viewName: string) => {
    // Check ACL before opening restricted views
    if ((viewName === 'users' || viewName === 'settings') && currentUser.role === 'author') {
      alert('Acceso restringido: Se requiere rol de Administrador.');
      return;
    }

    document.querySelectorAll('.wp-view').forEach(el => el.classList.remove('is-active'));
    document.querySelectorAll('.menu-link, .submenu-link').forEach(el => el.classList.remove('is-active'));

    const targetView = document.getElementById(`view-${viewName}`);
    if (targetView) targetView.classList.add('is-active');

    const targetBtn = document.querySelector(`[data-view="${viewName}"]`);
    if (targetBtn) targetBtn.classList.add('is-active');
  };

  document.querySelectorAll('[data-view]').forEach(btn => {
    btn.addEventListener('click', () => {
      const v = btn.getAttribute('data-view');
      if (v) window.switchView(v);
    });
  });

  // Login Handlers
  document.querySelectorAll('.btn-demo-role').forEach(btn => {
    btn.addEventListener('click', () => {
      const user = btn.getAttribute('data-user');
      const role = btn.getAttribute('data-role') || 'admin';
      const callsigns: Record<string, string> = { yv5of: 'YV5OF', yv5adm: 'YV5ADM', autor_demo: 'YV5DEMO' };
      const names: Record<string, string> = { yv5of: 'Severino Mastracci', yv5adm: 'Arnaldo', autor_demo: 'Colaborador Autor' };

      currentUser = {
        username: user || 'yv5of',
        callsign: callsigns[user || 'yv5of'] || 'YV5OF',
        name: names[user || 'yv5of'] || 'Usuario',
        role: role
      };

      localStorage.setItem('bm_wp_user', JSON.stringify(currentUser));
      showApp();
    });
  });

  const loginForm = document.getElementById('login-form');
  if (loginForm) {
    loginForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const u = (document.getElementById('login-username') as HTMLInputElement).value;
      currentUser = {
        username: u.toLowerCase(),
        callsign: u.toUpperCase(),
        name: u.toUpperCase(),
        role: 'admin'
      };
      localStorage.setItem('bm_wp_user', JSON.stringify(currentUser));
      showApp();
    });
  }

  // Logout Handler
  document.getElementById('btn-logout')?.addEventListener('click', () => {
    localStorage.removeItem('bm_wp_user');
    showLogin();
  });

  // Post Publishing Form
  const postForm = document.getElementById('wp-post-editor-form');
  if (postForm) {
    postForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const title = (document.getElementById('wp-post-title') as HTMLInputElement).value;
      const slug = (document.getElementById('wp-post-slug') as HTMLInputElement).value;
      const content = (document.getElementById('wp-post-content') as HTMLTextAreaElement).value;
      const desc = (document.getElementById('wp-post-desc') as HTMLTextAreaElement).value;
      const status = (document.getElementById('wp-post-status') as HTMLSelectElement).value;
      const cat = (document.querySelector('input[name="post-cat"]:checked') as HTMLInputElement)?.value || 'General';
      const tags = (document.getElementById('wp-post-tags') as HTMLInputElement).value;
      const featured = (document.getElementById('wp-post-featured') as HTMLInputElement).checked;

      // Add row to table
      const tbody = document.getElementById('posts-table-body');
      if (tbody) {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><input type="checkbox" /></td>
          <td class="cell-title">
            <strong>${title}</strong>
            <div class="row-actions">
              <span class="edit"><a href="#" onclick="window.switchView('new-post')">Editar</a> | </span>
              <span class="trash"><a href="#">Papelera</a> | </span>
              <span class="view"><a href="#">Ver</a></span>
            </div>
          </td>
          <td>${currentUser.name} (${currentUser.callsign})</td>
          <td><span class="cat-pill-mini">${cat}</span></td>
          <td>${tags}</td>
          <td><span class="status-badge-pub">${status === 'published' ? 'Publicada' : 'Borrador'}</span></td>
          <td>${new Date().toLocaleDateString('es-VE')}</td>
        `;
        tbody.insertBefore(tr, tbody.firstChild);
      }

      // Try sending to PHP backend if active
      try {
        await fetch('/api/posts.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, slug, content, description: desc, status, category: cat, tags, featured })
        });
      } catch (err) {
        // Fallback local
      }

      alert('¡Noticia publicada exitosamente y guardada en base de datos!');
      window.switchView('posts');
    });
  }

  // Auto-slug
  document.getElementById('wp-post-title')?.addEventListener('input', (e) => {
    const title = (e.target as HTMLInputElement).value;
    const slug = title.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    const slugInput = document.getElementById('wp-post-slug') as HTMLInputElement;
    if (slugInput) slugInput.value = slug;
  });

  // Preview Toggle
  document.getElementById('btn-toggle-preview')?.addEventListener('click', () => {
    const box = document.getElementById('wp-live-preview-box');
    const area = document.getElementById('wp-post-content') as HTMLTextAreaElement;
    if (box && area) {
      if (box.style.display === 'none') {
        box.innerHTML = `<h4>Vista previa:</h4><p>${area.value.replace(/\n\n/g, '</p><p>')}</p>`;
        box.style.display = 'block';
      } else {
        box.style.display = 'none';
      }
    }
  });

  // User Role Change Listener
  document.querySelectorAll('.user-role-select').forEach(select => {
    select.addEventListener('change', (e) => {
      const target = e.target as HTMLSelectElement;
      const targetUser = target.getAttribute('data-user');
      const newRole = target.value;
      alert(`Rol de ${targetUser} actualizado a: ${newRole} en MySQL bmvenezuela`);
    });
  });

  // Site text save
  document.getElementById('btn-save-site-texts')?.addEventListener('click', () => {
    alert('¡Textos del portal guardados en base de datos bmvenezuela!');
  });

  // Initialize
  checkAuth();
</script>
