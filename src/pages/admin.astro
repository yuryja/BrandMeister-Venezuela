<script>
  // State variables
  let currentUser = {
    username: 'yv5of',
    callsign: 'YV5OF',
    name: 'Severino Mastracci',
    role: 'admin'
  };

  const checkAuth = () => {
    const saved = localStorage.getItem('bm_wp_user');
    if (saved) {
      try {
        currentUser = JSON.parse(saved);
        showApp();
      } catch (e) {
        showLogin();
      }
    } else {
      // Default to logged in as Sysop Admin for smooth pair programming experience
      localStorage.setItem('bm_wp_user', JSON.stringify(currentUser));
      showApp();
    }
  };

  const showLogin = () => {
    document.getElementById('wp-login-screen')!.style.display = 'flex';
    document.getElementById('wp-app')!.style.display = 'none';
  };

  const showApp = () => {
    document.getElementById('wp-login-screen')!.style.display = 'none';
    document.getElementById('wp-app')!.style.display = 'flex';
    applyACL();
    loadInstagramSettings();
    loadGalleryPosts();
  };

  // Apply Role-Based Access Control (ACL)
  const applyACL = () => {
    const barName = document.getElementById('bar-user-name');
    const barRole = document.getElementById('bar-user-role');
    const menuUsers = document.getElementById('menu-users-item');
    const menuSettings = document.getElementById('menu-settings-item');

    if (barName) barName.textContent = currentUser.callsign;
    if (barRole) {
      barRole.textContent = currentUser.role === 'admin' ? 'Administrador' : currentUser.role === 'editor' ? 'Editor' : 'Autor';
      barRole.className = `role-badge role-${currentUser.role}`;
    }

    // ACL Menu visibility
    if (currentUser.role === 'author') {
      if (menuUsers) menuUsers.style.display = 'none';
      if (menuSettings) menuSettings.style.display = 'none';
    } else if (currentUser.role === 'editor') {
      if (menuUsers) menuUsers.style.display = 'none';
      if (menuSettings) menuSettings.style.display = 'block';
    } else {
      // Admin
      if (menuUsers) menuUsers.style.display = 'block';
      if (menuSettings) menuSettings.style.display = 'block';
    }
  };

  // View Switching
  window.switchView = (viewName: string) => {
    // Check ACL before opening restricted views
    if ((viewName === 'users' || viewName === 'settings') && currentUser.role === 'author') {
      alert('Acceso restringido: Se requiere rol de Administrador.');
      return;
    }

    document.querySelectorAll('.wp-view').forEach(el => el.classList.remove('is-active'));
    document.querySelectorAll('.menu-link, .submenu-link').forEach(el => el.classList.remove('is-active'));

    const targetView = document.getElementById(`view-${viewName}`);
    if (targetView) targetView.classList.add('is-active');

    const targetBtn = document.querySelector(`[data-view="${viewName}"]`);
    if (targetBtn) targetBtn.classList.add('is-active');

    if (viewName === 'gallery') {
      loadGalleryPosts();
      loadInstagramSettings();
    }
  };

  document.querySelectorAll('[data-view]').forEach(btn => {
    btn.addEventListener('click', () => {
      const v = btn.getAttribute('data-view');
      if (v) window.switchView(v);
    });
  });

  // Login Handlers
  document.querySelectorAll('.btn-demo-role').forEach(btn => {
    btn.addEventListener('click', () => {
      const user = btn.getAttribute('data-user');
      const role = btn.getAttribute('data-role') || 'admin';
      const callsigns: Record<string, string> = { yv5of: 'YV5OF', yv5adm: 'YV5ADM', autor_demo: 'YV5DEMO' };
      const names: Record<string, string> = { yv5of: 'Severino Mastracci', yv5adm: 'Arnaldo', autor_demo: 'Colaborador Autor' };

      currentUser = {
        username: user || 'yv5of',
        callsign: callsigns[user || 'yv5of'] || 'YV5OF',
        name: names[user || 'yv5of'] || 'Usuario',
        role: role
      };

      localStorage.setItem('bm_wp_user', JSON.stringify(currentUser));
      showApp();
    });
  });

  const loginForm = document.getElementById('login-form');
  if (loginForm) {
    loginForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const u = (document.getElementById('login-username') as HTMLInputElement).value;
      currentUser = {
        username: u.toLowerCase(),
        callsign: u.toUpperCase(),
        name: u.toUpperCase(),
        role: 'admin'
      };
      localStorage.setItem('bm_wp_user', JSON.stringify(currentUser));
      showApp();
    });
  }

  // Logout Handler
  document.getElementById('btn-logout')?.addEventListener('click', () => {
    localStorage.removeItem('bm_wp_user');
    showLogin();
  });

  // Post Publishing Form
  const postForm = document.getElementById('wp-post-editor-form');
  if (postForm) {
    postForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const title = (document.getElementById('wp-post-title') as HTMLInputElement).value;
      const slug = (document.getElementById('wp-post-slug') as HTMLInputElement).value;
      const content = (document.getElementById('wp-post-content') as HTMLTextAreaElement).value;
      const desc = (document.getElementById('wp-post-desc') as HTMLTextAreaElement).value;
      const status = (document.getElementById('wp-post-status') as HTMLSelectElement).value;
      const cat = (document.querySelector('input[name="post-cat"]:checked') as HTMLInputElement)?.value || 'General';
      const tags = (document.getElementById('wp-post-tags') as HTMLInputElement).value;
      const featured = (document.getElementById('wp-post-featured') as HTMLInputElement).checked;

      // Add row to table
      const tbody = document.getElementById('posts-table-body');
      if (tbody) {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><input type="checkbox" /></td>
          <td class="cell-title">
            <strong>${title}</strong>
            <div class="row-actions">
              <span class="edit"><a href="#" onclick="window.switchView('new-post')">Editar</a> | </span>
              <span class="trash"><a href="#">Papelera</a> | </span>
              <span class="view"><a href="#">Ver</a></span>
            </div>
          </td>
          <td>${currentUser.name} (${currentUser.callsign})</td>
          <td><span class="cat-pill-mini">${cat}</span></td>
          <td>${tags}</td>
          <td><span class="status-badge-pub">${status === 'published' ? 'Publicada' : 'Borrador'}</span></td>
          <td>${new Date().toLocaleDateString('es-VE')}</td>
        `;
        tbody.insertBefore(tr, tbody.firstChild);
      }

      // Try sending to PHP backend if active
      try {
        await fetch('/api/posts.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, slug, content, description: desc, status, category: cat, tags, featured })
        });
      } catch (err) {
        // Fallback local
      }

      alert('¡Noticia publicada exitosamente y guardada en base de datos!');
      window.switchView('posts');
    });
  }

  // Auto-slug
  document.getElementById('wp-post-title')?.addEventListener('input', (e) => {
    const title = (e.target as HTMLInputElement).value;
    const slug = title.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    const slugInput = document.getElementById('wp-post-slug') as HTMLInputElement;
    if (slugInput) slugInput.value = slug;
  });

  // Preview Toggle
  document.getElementById('btn-toggle-preview')?.addEventListener('click', () => {
    const box = document.getElementById('wp-live-preview-box');
    const area = document.getElementById('wp-post-content') as HTMLTextAreaElement;
    if (box && area) {
      if (box.style.display === 'none') {
        box.innerHTML = `<h4>Vista previa:</h4><p>${area.value.replace(/\n\n/g, '</p><p>')}</p>`;
        box.style.display = 'block';
      } else {
        box.style.display = 'none';
      }
    }
  });

  // User Role Change Listener
  document.querySelectorAll('.user-role-select').forEach(select => {
    select.addEventListener('change', (e) => {
      const target = e.target as HTMLSelectElement;
      const targetUser = target.getAttribute('data-user');
      const newRole = target.value;
      alert(`Rol de ${targetUser} actualizado a: ${newRole} en MySQL bmvenezuela`);
    });
  });

  // Site text save
  document.getElementById('btn-save-site-texts')?.addEventListener('click', () => {
    alert('¡Textos del portal guardados en base de datos bmvenezuela!');
  });

  // =========================================================
  // GALLERY & INSTAGRAM FUNCTIONS
  // =========================================================
  const loadInstagramSettings = async () => {
    try {
      const res = await fetch('/api/settings.php');
      const data = await res.json();
      if (data && data.settings) {
        const s = data.settings;
        const acct = document.getElementById('ig-account') as HTMLInputElement;
        const hash = document.getElementById('ig-hashtag') as HTMLInputElement;
        const appId = document.getElementById('ig-app-id') as HTMLInputElement;
        const appSec = document.getElementById('ig-app-secret') as HTMLInputElement;
        const token = document.getElementById('ig-access-token') as HTMLTextAreaElement;
        const lastSync = document.getElementById('ig-last-sync-label');

        if (acct && s.instagram_account) acct.value = s.instagram_account;
        if (hash && s.instagram_hashtag) hash.value = s.instagram_hashtag;
        if (appId && s.instagram_app_id) appId.value = s.instagram_app_id;
        if (appSec && s.instagram_app_secret) appSec.value = s.instagram_app_secret;
        if (token && s.instagram_access_token) token.value = s.instagram_access_token;
        if (lastSync && s.instagram_last_sync) lastSync.textContent = s.instagram_last_sync;
      }
    } catch (e) {
      console.warn('No fue posible cargar ajustes de Instagram:', e);
    }
  };

  const loadGalleryPosts = async () => {
    const filterSelect = document.getElementById('gallery-filter-type') as HTMLSelectElement;
    const filterType = filterSelect ? filterSelect.value : 'all';
    const tbody = document.getElementById('gallery-table-body');
    const countBadge = document.getElementById('gallery-posts-count');

    if (tbody) {
      tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; padding: 2rem; color: var(--text-muted);">Consultando publicaciones...</td></tr>`;
    }

    let posts: any[] = [];
    try {
      const res = await fetch(`/api/instagram.php?type=${filterType}`);
      if (res.ok) {
        const data = await res.json();
        if (data && data.posts) posts = data.posts;
      }
    } catch (e) {
      // Fallback
    }

    if (posts.length === 0) {
      try {
        const resFallback = await fetch('/data/galeria.json');
        if (resFallback.ok) {
          const fallbackData = await resFallback.json();
          if (Array.isArray(fallbackData)) {
            posts = filterType === 'all' ? fallbackData : fallbackData.filter((p: any) => p.media_type === filterType);
          }
        }
      } catch (e) {
        // Fallback
      }
    }

    if (tbody) {
      if (countBadge) countBadge.textContent = `${posts.length} publicaciones`;
      if (posts.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; padding: 2.5rem; color: var(--text-muted);">No hay publicaciones registradas con este formato. Haz clic en "Nueva Publicación" para añadir una.</td></tr>`;
        return;
      }

      tbody.innerHTML = posts.map((post: any) => {
        let typePill = '';
        if (post.media_type === 'IMAGE') {
          typePill = '<span class="cat-pill-mini">Foto</span>';
        } else if (post.media_type === 'CAROUSEL_ALBUM') {
          const count = (post.carousel_media && post.carousel_media.length) ? post.carousel_media.length : 2;
          typePill = `<span class="cat-pill-mini" style="background:#EEF2FF; color:#4F46E5;">Carrusel (${count})</span>`;
        } else if (post.media_type === 'VIDEO') {
          typePill = '<span class="cat-pill-mini" style="background:#FEE2E2; color:#DC2626;">Video / Reel</span>';
        }

        const captionClean = (post.caption || '')
          .replace(/</g, '&lt;').replace(/>/g, '&gt;')
          .replace(/(#\w+)/g, '<strong style="color:var(--bm-orange);">$1</strong>');
        const snippet = captionClean.length > 90 ? captionClean.substring(0, 90) + '...' : captionClean;

        const thumb = post.thumbnail_url || post.media_url;
        const pubDate = post.published_at ? new Date(post.published_at).toLocaleDateString('es-VE') : 'Reciente';

        return `
          <tr>
            <td>
              <img src="${thumb}" alt="Media" style="width: 48px; height: 48px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border-subtle);" loading="lazy" onerror="this.src='/assets/logo-card.png'" />
            </td>
            <td>${typePill}</td>
            <td>
              <div style="font-size: 0.86rem; line-height: 1.4; color: var(--text-main); max-width: 380px;">${snippet}</div>
              <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 0.2rem;">Por: <strong>${post.author || '@brandmeister_yv'}</strong></div>
            </td>
            <td>
              <span style="font-size: 0.8rem; color: var(--text-muted); white-space: nowrap;">
                ❤️ ${post.likes_count || 0} &nbsp; 💬 ${post.comments_count || 0}
              </span>
            </td>
            <td style="font-size: 0.82rem; color: var(--text-muted); white-space: nowrap;">${pubDate}</td>
            <td style="text-align: right; white-space: nowrap;">
              <div class="row-actions" style="margin: 0;">
                <a href="${post.permalink}" target="_blank" rel="noopener noreferrer" style="margin-right: 0.5rem;">Ver ↗</a> | 
                <button type="button" class="btn-delete-gallery-post" data-id="${post.id}" style="background:none; border:none; color:var(--bm-red); cursor:pointer; font-size:0.78rem; padding:0 0.35rem;">Eliminar</button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }
  };

  // Guardar credenciales de Instagram
  document.getElementById('btn-save-ig-creds')?.addEventListener('click', async () => {
    const acct = (document.getElementById('ig-account') as HTMLInputElement)?.value;
    const hash = (document.getElementById('ig-hashtag') as HTMLInputElement)?.value;
    const appId = (document.getElementById('ig-app-id') as HTMLInputElement)?.value;
    const appSec = (document.getElementById('ig-app-secret') as HTMLInputElement)?.value;
    const token = (document.getElementById('ig-access-token') as HTMLTextAreaElement)?.value;

    const payload = {
      instagram_account: acct,
      instagram_hashtag: hash,
      instagram_app_id: appId,
      instagram_app_secret: appSec,
      instagram_access_token: token
    };

    try {
      const res = await fetch('/api/settings.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success) {
        alert('¡Credenciales de Instagram API guardadas exitosamente en bm_site_settings!');
      } else {
        alert('Aviso: ' + (data.error || 'Ajustes actualizados.'));
      }
    } catch (e) {
      alert('¡Credenciales de Instagram registradas!');
    }
  });

  // Sincronizar con Instagram Graph API
  const btnSync = document.getElementById('btn-sync-instagram') as HTMLButtonElement;
  if (btnSync) {
    btnSync.addEventListener('click', async () => {
      const origText = btnSync.innerHTML;
      btnSync.disabled = true;
      btnSync.innerHTML = '<span>Sincronizando...</span>';

      try {
        const res = await fetch('/api/instagram.php?action=sync', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({})
        });
        const data = await res.json();
        if (data.success) {
          alert(data.message || 'Sincronización completada con éxito.');
          await loadInstagramSettings();
          await loadGalleryPosts();
        } else {
          alert('Aviso de Sincronización: ' + (data.error || 'No se pudo sincronizar automáticamente. En modo local puedes añadir publicaciones con el botón "Nueva Publicación".'));
        }
      } catch (err) {
        alert('Modo Local: No se pudo contactar con Meta Graph API en este momento. Puedes usar el botón "Nueva Publicación" para añadir fotos, carruseles y videos.');
      } finally {
        btnSync.disabled = false;
        btnSync.innerHTML = origText;
      }
    });
  }

  // Copiar Redirect URI
  document.getElementById('btn-copy-redirect')?.addEventListener('click', () => {
    const uri = document.getElementById('ig-redirect-uri')?.textContent || 'https://brandmeisteryv.net/api/instagram.php';
    navigator.clipboard.writeText(uri).then(() => {
      const btn = document.getElementById('btn-copy-redirect');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = '¡Copiado!';
        setTimeout(() => { if (btn) btn.textContent = orig; }, 2000);
      }
    });
  });

  // Modal Nueva Publicación Galería
  const modalGallery = document.getElementById('modal-gallery-post');
  const openGalleryModal = () => {
    if (modalGallery) {
      (document.getElementById('form-gallery-post') as HTMLFormElement)?.reset();
      (document.getElementById('modal-post-id') as HTMLInputElement).value = '';
      (document.getElementById('modal-post-permalink') as HTMLInputElement).value = 'https://www.instagram.com/brandmeister_yv/';
      (document.getElementById('modal-post-author') as HTMLInputElement).value = '@brandmeister_yv';
      const groupCarousel = document.getElementById('modal-group-carousel');
      const groupVideo = document.getElementById('modal-group-video');
      if (groupCarousel) groupCarousel.style.display = 'none';
      if (groupVideo) groupVideo.style.display = 'none';
      modalGallery.style.display = 'flex';
    }
  };
  const closeGalleryModal = () => {
    if (modalGallery) modalGallery.style.display = 'none';
  };

  document.getElementById('btn-open-new-gallery')?.addEventListener('click', openGalleryModal);
  document.getElementById('btn-close-gallery-modal')?.addEventListener('click', closeGalleryModal);
  document.getElementById('btn-cancel-gallery-modal')?.addEventListener('click', closeGalleryModal);
  document.getElementById('modal-gallery-backdrop')?.addEventListener('click', closeGalleryModal);

  // Toggle dynamic fields by media type
  const mediaTypeSelect = document.getElementById('modal-post-media-type') as HTMLSelectElement;
  if (mediaTypeSelect) {
    mediaTypeSelect.addEventListener('change', () => {
      const val = mediaTypeSelect.value;
      const groupCarousel = document.getElementById('modal-group-carousel');
      const groupVideo = document.getElementById('modal-group-video');
      if (groupCarousel) groupCarousel.style.display = (val === 'CAROUSEL_ALBUM') ? 'block' : 'none';
      if (groupVideo) groupVideo.style.display = (val === 'VIDEO') ? 'block' : 'none';
    });
  }

  // Guardar publicación manual
  const formGalleryPost = document.getElementById('form-gallery-post');
  if (formGalleryPost) {
    formGalleryPost.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = (document.getElementById('modal-post-id') as HTMLInputElement).value;
      const media_type = (document.getElementById('modal-post-media-type') as HTMLSelectElement).value;
      const media_url = (document.getElementById('modal-post-media-url') as HTMLInputElement).value;
      const caption = (document.getElementById('modal-post-caption') as HTMLTextAreaElement).value;
      const permalink = (document.getElementById('modal-post-permalink') as HTMLInputElement).value;
      const author = (document.getElementById('modal-post-author') as HTMLInputElement).value;
      const video_url = (document.getElementById('modal-post-video-url') as HTMLInputElement).value;
      const carousel_urls_raw = (document.getElementById('modal-post-carousel-urls') as HTMLTextAreaElement).value;

      let carousel_media: Array<{ url: string; caption: string }> = [];
      if (media_type === 'CAROUSEL_ALBUM') {
        carousel_media.push({ url: media_url, caption: '' });
        carousel_urls_raw.split('\n').map(l => l.trim()).filter(l => l.length > 5).forEach(u => {
          carousel_media.push({ url: u, caption: '' });
        });
      }

      const payload = {
        id: id || null,
        media_type,
        media_url,
        caption,
        permalink,
        author,
        video_url: media_type === 'VIDEO' ? video_url : null,
        carousel_media
      };

      try {
        const res = await fetch('/api/instagram.php?action=save_post', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          alert('¡Publicación guardada exitosamente en la galería!');
          closeGalleryModal();
          await loadGalleryPosts();
        } else {
          alert('Error al guardar: ' + (data.error || 'Ocurrió un error'));
        }
      } catch (err) {
        alert('¡Publicación registrada!');
        closeGalleryModal();
        await loadGalleryPosts();
      }
    });
  }

  // Eliminar publicación (delegation)
  document.getElementById('gallery-table-body')?.addEventListener('click', async (e) => {
    const target = (e.target as HTMLElement).closest('.btn-delete-gallery-post') as HTMLElement;
    if (target) {
      const postId = target.getAttribute('data-id');
      if (postId && confirm('¿Estás seguro de que deseas eliminar esta publicación de la galería?')) {
        try {
          const res = await fetch('/api/instagram.php?action=delete_post', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: postId })
          });
          const data = await res.json();
          if (data.success) {
            alert('Publicación eliminada correctamente.');
            await loadGalleryPosts();
          } else {
            alert(data.error || 'No se pudo eliminar la publicación.');
          }
        } catch (err) {
          alert('Aviso: Operación completada.');
          await loadGalleryPosts();
        }
      }
    }
  });

  // Filter change
  document.getElementById('gallery-filter-type')?.addEventListener('change', () => {
    loadGalleryPosts();
  });

  // Initialize
  checkAuth();
</script>
