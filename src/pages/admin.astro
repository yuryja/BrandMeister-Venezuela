    border: 1px solid var(--border-subtle);
    border-bottom: none;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }

  .wp-tool-btn {
    padding: 0.25rem 0.55rem;
    font-size: 0.78rem;
    font-weight: 700;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    cursor: pointer;
  }

  .wp-tool-btn:hover {
    background: var(--bm-orange-light);
