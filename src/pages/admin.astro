  }

  /* DB Settings View */
  .db-params-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .param-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.92rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .param-label {
    width: 160px;
    color: var(--text-faint);
    font-weight: 600;
  }

  .db-instructions {
    background: var(--bg-page);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
  }

  .db-instructions h4 {
    font-size: 1.05rem;
    margin-bottom: 0.75rem;
  }

  .db-instructions ol {
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* Gallery & Modal Styles */
  .wp-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .wp-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
  }

  .wp-modal-dialog {
    position: relative;
    z-index: 1;
    background: #FFFFFF;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xl);
    width: 100%;
    max-width: 580px;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .wp-modal-header {
    padding: 1.15rem 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #F8FAFC;
  }

  .wp-modal-header h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .btn-close-modal {
    background: transparent;
    border: none;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0 0.4rem;
  }

  .btn-close-modal:hover {
    color: var(--bm-red);
  }

  .wp-modal-body {
    padding: 1.5rem;
    overflow-y: auto;
  }

  .wp-modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--border-subtle);
    background: #F8FAFC;
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }
</style>

<script>
  import { ROLE_LABELS, type SessionUser } from '../scripts/admin/api';
  import { initUsers } from '../scripts/admin/users';
  import { initProfile } from '../scripts/admin/profile';
  import { initGallery } from '../scripts/admin/gallery';
  import { initAccount, showAccountPanel } from '../scripts/admin/account';

  // Usuario autenticado según la sesión PHP (nunca desde localStorage)
  let currentUser: SessionUser = { id: 0, username: '', callsign: '', full_name: '', email: '', role: 'author' };

  // Vistas que requieren un rol concreto (el servidor también lo exige)
  const VIEW_ROLES: Record<string, SessionUser['role'][]> = {
    users: ['admin'],
    'user-new': ['admin'],
    settings: ['admin', 'editor'],
  };

  const setSession = (user: SessionUser) => {
    currentUser = user;
    document.dispatchEvent(new CustomEvent('bm:session', { detail: user }));
  };

  const escapeHtml = (value: unknown): string =>
    String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');

  // Solo permite URLs http(s); cualquier otra cosa (javascript:, data:...) se sustituye
  const safeUrl = (value: unknown, fallback = '#'): string => {
    try {
      const url = new URL(String(value ?? ''), window.location.origin);
      return url.protocol === 'http:' || url.protocol === 'https:' ? url.href : fallback;
    } catch {
      return fallback;
    }
  };

  // Si el servidor responde 401 la sesión expiró: volver al login
  const handleUnauthorized = (res: Response): boolean => {
    if (res.status === 401) {
      showLogin('Tu sesión expiró. Inicia sesión nuevamente.');
      return true;
    }
    return false;
  };

  const checkAuth = async () => {
    try {
      const res = await fetch('/api/auth.php?action=status', { credentials: 'same-origin' });
      const data = await res.json();
      if (data?.logged_in && data.user) {
        setSession(data.user);
        showApp();
        return;
      }
    } catch (e) {
      showLogin('No fue posible contactar al servidor de autenticación.');
      return;
    }
    showLogin();
  };

  const showLogin = (message = '') => {
    document.getElementById('wp-login-screen')!.style.display = 'flex';
    document.getElementById('wp-app')!.style.display = 'none';
    showAccountPanel('login');
    const errorEl = document.getElementById('login-error');
    if (errorEl) {
      errorEl.className = 'wp-login-error';
      errorEl.textContent = message;
      errorEl.hidden = !message;
    }
  };

  const showApp = () => {
    document.getElementById('wp-login-screen')!.style.display = 'none';
    document.getElementById('wp-app')!.style.display = 'flex';
    applyACL();
    window.switchView('dashboard');
  };

  // Apply Role-Based Access Control (ACL)
  const applyACL = () => {
    const barName = document.getElementById('bar-user-name');
    const barRole = document.getElementById('bar-user-role');
    if (barName) barName.textContent = currentUser.callsign;
    if (barRole) {
      barRole.textContent = ROLE_LABELS[currentUser.role];
      barRole.className = `role-badge role-${currentUser.role}`;
    }

    const show = (id: string, visible: boolean) => {
      const el = document.getElementById(id);
      if (el) el.style.display = visible ? 'block' : 'none';
    };
    show('menu-users-item', currentUser.role === 'admin');
    show('menu-profile-item', currentUser.role !== 'admin');
    show('menu-settings-item', currentUser.role !== 'author');
  };

  document.addEventListener('bm:session', applyACL);
  document.addEventListener('bm:unauthorized', () => showLogin('Tu sesión expiró. Inicia sesión nuevamente.'));

  // View Switching: cada módulo escucha `bm:view` para cargar sus datos
  window.switchView = (viewName: string) => {
    const allowed = VIEW_ROLES[viewName];
    if (allowed && !allowed.includes(currentUser.role)) {
      viewName = 'dashboard';
    }

    document.querySelectorAll('.wp-view').forEach(el => el.classList.remove('is-active'));
    document.querySelectorAll('.menu-link, .submenu-link').forEach(el => el.classList.remove('is-active'));

    const targetView = document.getElementById(`view-${viewName}`);
    if (targetView) targetView.classList.add('is-active');

    // Resaltar el enlace del menú (y su menú padre si es un submenú)
    document.querySelectorAll(`.wp-sidebar [data-view="${viewName}"]`).forEach(btn => {
      btn.classList.add('is-active');
      btn.closest('.has-submenu')?.querySelector(':scope > .menu-link')?.classList.add('is-active');
    });

    document.dispatchEvent(new CustomEvent('bm:view', { detail: viewName }));
    window.scrollTo({ top: 0 });
  };

  document.querySelectorAll('[data-view]').forEach(btn => {
    btn.addEventListener('click', () => {
      const v = btn.getAttribute('data-view');
      if (v) window.switchView(v);
    });
  });

  // Login Handler
  const loginForm = document.getElementById('login-form');
  if (loginForm) {
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const usernameInput = document.getElementById('login-username') as HTMLInputElement;
      const passwordInput = document.getElementById('login-password') as HTMLInputElement;
      const submitBtn = document.getElementById('login-submit') as HTMLButtonElement | null;
      if (submitBtn) submitBtn.disabled = true;

      try {
        const res = await fetch('/api/auth.php?action=login', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: usernameInput.value, password: passwordInput.value })
        });
        const data = await res.json().catch(() => null);
        if (res.ok && data?.success && data.user) {
          setSession(data.user);
          passwordInput.value = '';
          showApp();
        } else {
          showLogin(data?.error || 'No fue posible iniciar sesión.');
        }
      } catch (err) {
        showLogin('No fue posible contactar al servidor de autenticación.');
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }

  // Logout Handler
  document.getElementById('btn-logout')?.addEventListener('click', async () => {
    try {
      await fetch('/api/auth.php?action=logout', { method: 'POST', credentials: 'same-origin' });
    } catch (e) {
      // Aunque falle la red, se oculta el panel
    }
    showLogin();
  });

  // Post Publishing Form
  const postForm = document.getElementById('wp-post-editor-form');
  if (postForm) {
    postForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const title = (document.getElementById('wp-post-title') as HTMLInputElement).value;
      const slug = (document.getElementById('wp-post-slug') as HTMLInputElement).value;
      const content = (document.getElementById('wp-post-content') as HTMLTextAreaElement).value;
      const desc = (document.getElementById('wp-post-desc') as HTMLTextAreaElement).value;
      const status = (document.getElementById('wp-post-status') as HTMLSelectElement).value;
      const cat = (document.querySelector('input[name="post-cat"]:checked') as HTMLInputElement)?.value || 'General';
      const tags = (document.getElementById('wp-post-tags') as HTMLInputElement).value;
      const featured = (document.getElementById('wp-post-featured') as HTMLInputElement).checked;

      let data: any = null;
      try {
        const res = await fetch('/api/posts.php', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, slug, content, description: desc, status, category: cat, tags, featured })
        });
        if (handleUnauthorized(res)) return;
        data = await res.json().catch(() => null);
      } catch (err) {
        alert('No fue posible contactar al servidor. La noticia no se guardó.');
        return;
      }

      if (!data?.success) {
        alert('Error al guardar: ' + (data?.error || 'Ocurrió un error'));
        return;
      }

      // Add row to table
      const tbody = document.getElementById('posts-table-body');
      if (tbody) {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><input type="checkbox" /></td>
          <td class="cell-title">
            <strong>${escapeHtml(title)}</strong>
            <div class="row-actions">
              <span class="edit"><a href="#" onclick="window.switchView('new-post')">Editar</a> | </span>
              <span class="trash"><a href="#">Papelera</a> | </span>
              <span class="view"><a href="#">Ver</a></span>
            </div>
          </td>
          <td>${escapeHtml(currentUser.full_name)} (${escapeHtml(currentUser.callsign)})</td>
          <td><span class="cat-pill-mini">${escapeHtml(cat)}</span></td>
          <td>${escapeHtml(tags)}</td>
          <td><span class="status-badge-pub">${status === 'published' ? 'Publicada' : 'Borrador'}</span></td>
          <td>${new Date().toLocaleDateString('es-VE')}</td>
        `;
        tbody.insertBefore(tr, tbody.firstChild);
      }

      alert(data.message || '¡Noticia guardada exitosamente!');
      window.switchView('posts');
    });
  }

  // Auto-slug
  document.getElementById('wp-post-title')?.addEventListener('input', (e) => {
    const title = (e.target as HTMLInputElement).value;
    const slug = title.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    const slugInput = document.getElementById('wp-post-slug') as HTMLInputElement;
    if (slugInput) slugInput.value = slug;
  });

  // Preview Toggle
  document.getElementById('btn-toggle-preview')?.addEventListener('click', () => {
    const box = document.getElementById('wp-live-preview-box');
    const area = document.getElementById('wp-post-content') as HTMLTextAreaElement;
    if (box && area) {
      if (box.style.display === 'none') {
        box.innerHTML = `<h4>Vista previa:</h4><p>${escapeHtml(area.value).replace(/\n\n/g, '</p><p>')}</p>`;
        box.style.display = 'block';
      } else {
        box.style.display = 'none';
      }
    }
  });

  // Site text save
  document.getElementById('btn-save-site-texts')?.addEventListener('click', () => {
    alert('¡Textos del portal guardados en base de datos bmvenezuela!');
  });

  // Initialize
  initUsers();
  initProfile();
  initGallery();
  initAccount().then((handledToken) => {
    if (!handledToken) checkAuth();
  });
</script>
