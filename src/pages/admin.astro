  }

  .wp-content-area {
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    font-size: 0.95rem;
    line-height: 1.7;
    resize: vertical;
  }

  .wp-live-preview-box {
    padding: 1.5rem;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-top: none;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    max-height: 400px;
    overflow-y: auto;
  }

  .metabox {
    margin-bottom: 1.25rem;
  }

  .meta-setting-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
