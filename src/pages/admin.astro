  }

  .metabox-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .checkbox-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.85rem;
  }

  .field-hint {
    font-size: 0.75rem;
    color: var(--text-faint);
    margin-top: 0.35rem;
    display: block;
  }

  /* ACL Users View */
  .acl-notice {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-left: 4px solid var(--bm-orange);
    padding: 1rem 1.5rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .callsign-badge {
    font-weight: 800;
    color: var(--bm-red);
    background: var(--bm-red-light);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .user-active-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #16A34A;
    margin-right: 0.3rem;
  }

  .matrix-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  .matrix-table th {
    background: #F8FAFC;
    padding: 0.75rem 1rem;
    text-align: center;
    border-bottom: 1px solid var(--border-subtle);
  }

  .matrix-table th:first-child {
    text-align: left;
  }

  .matrix-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
    text-align: center;
  }

  .matrix-table td:first-child {
    text-align: left;
    font-weight: 600;
    color: var(--text-main);
  }

  .check-yes {
    color: #16A34A;
