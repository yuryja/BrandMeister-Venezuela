---
import Layout from '../layouts/Layout.astro';
import UsersView from '../components/admin/UsersView.astro';
import ProfileView from '../components/admin/ProfileView.astro';
import GalleryView from '../components/admin/GalleryView.astro';
import PostsView from '../components/admin/PostsView.astro';
import '../styles/admin-accounts.css';
import '../styles/admin-gallery.css';
import '../styles/admin-posts.css';

const days = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
const getCellIntensity = (hour: number) => {
  if (hour >= 18 && hour <= 22) return hour % 2 === 0 ? 'level-3' : 'level-2';
  if (hour >= 11 && hour <= 14) return 'level-1';
  if (hour >= 1 && hour <= 5) return 'level-0';
  return 'level-1';
};
---

<Layout
  title="Escritorio ‹ BrandMeister Venezuela"
  description="Panel de administración de BrandMeister Venezuela: noticias, galería y usuarios."
  chrome={false}
>
  <!-- WP LOGIN SCREEN (Shown if not authenticated) -->
  <div id="wp-login-screen" class="wp-login-wrapper">
    <div class="wp-login-card">
      <div class="wp-login-logo">
        <img src="/assets/logo.webp" alt="BrandMeister Venezuela" width="220" height="55" />
      </div>
      
      <div data-account-panel="login" id="account-panel-login">
      <div class="wp-login-header">
        <h2>Iniciar sesión</h2>
        <p>Acceso administrativo para Sysops y colaboradores autorizados</p>
      </div>

      <form id="login-form" class="wp-login-form">
        <div class="form-group">
          <label for="login-username">Usuario o Indicativo</label>
          <input type="text" id="login-username" class="form-input" placeholder="ej: YV5OF o yy3big" autocomplete="username" required />
        </div>

        <div class="form-group">
          <label for="login-password">Contraseña</label>
          <input type="password" id="login-password" class="form-input" placeholder="••••••••" autocomplete="current-password" required />
        </div>

        <p id="login-error" class="wp-login-error" role="alert" hidden></p>

        <button type="submit" id="login-submit" class="btn btn-primary wp-login-btn">
          <span>Acceder al Escritorio</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </form>
      <p class="wp-login-links"><a href="#" data-show-panel="forgot">¿Olvidaste tu contraseña?</a></p>
      </div>

      <!-- ¿Olvidaste tu contraseña? -->
      <div data-account-panel="forgot" id="account-panel-forgot" hidden>
        <div class="wp-login-header">
          <h2>Restablecer contraseña</h2>
          <p>Escribe tu usuario, indicativo o correo y te enviaremos un enlace.</p>
        </div>
        <form id="forgot-form" class="wp-login-form">
          <div class="form-group">
            <label for="forgot-identifier">Usuario, indicativo o correo</label>
            <input type="text" id="forgot-identifier" class="form-input" autocomplete="username" maxlength="120" required />
          </div>
          <p id="forgot-message" class="wp-login-error" role="status" hidden></p>
          <button type="submit" id="forgot-submit" class="btn btn-primary wp-login-btn">Enviar enlace</button>
        </form>
        <p class="wp-login-links"><a href="#" data-show-panel="login">← Volver a iniciar sesión</a></p>
      </div>

      <!-- Crear / restablecer contraseña desde el enlace del correo (?clave=) -->
      <div data-account-panel="set-password" id="account-panel-set-password" hidden>
        <div class="wp-login-header">
          <h2 id="set-password-title">Comprobando enlace…</h2>
          <p id="set-password-intro"></p>
        </div>
        <form id="set-password-form" class="wp-login-form">
          <input type="text" name="username" autocomplete="username" hidden />
          <div class="form-group">
            <label for="sp-password">Nueva contraseña</label>
            <div class="password-field">
              <input type="password" id="sp-password" class="form-input" autocomplete="new-password" minlength="10" maxlength="200" required />
              <button type="button" class="btn btn-secondary btn-sm" data-toggle-password="sp-password">Mostrar</button>
            </div>
            <span class="field-hint">Mínimo 10 caracteres.</span>
          </div>
          <div class="form-group">
            <label for="sp-password-confirm">Repite la contraseña</label>
            <input type="password" id="sp-password-confirm" class="form-input" autocomplete="new-password" minlength="10" maxlength="200" required />
          </div>
          <p id="set-password-message" class="wp-login-error" role="alert" hidden></p>
          <button type="submit" id="set-password-submit" class="btn btn-primary wp-login-btn">Guardar contraseña</button>
        </form>
        <p class="wp-login-links"><a href="#" data-show-panel="login">Ir a iniciar sesión</a></p>
      </div>
    </div>
  </div>

  <!-- PANEL DE ADMINISTRACIÓN (ESTILO WORDPRESS) -->
  <div id="wp-app" class="wp-admin-app" style="display: none;">
    <!-- TOP WP ADMIN BAR -->
    <header class="wp-adminbar">
      <div class="adminbar-left">
        <a href="/" class="adminbar-site-link" target="_blank" title="Ver sitio público">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--bm-orange)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span class="site-name">BrandMeister Venezuela</span>
          <span class="visit-label">↗</span>
        </a>
      </div>

      <div class="adminbar-right">
        <div class="user-profile-menu">
          <button type="button" class="greeting greeting-link" data-view="profile" title="Editar tu perfil">Hola, <strong id="bar-user-name"></strong></button>
          <span id="bar-user-role" class="role-badge"></span>
          <button id="btn-logout" class="btn-logout" title="Cerrar sesión">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Salir</span>
          </button>
        </div>
      </div>
    </header>

    <div class="wp-admin-layout">
      <!-- LEFT WP SIDEBAR -->
      <aside class="wp-sidebar">
        <ul class="wp-menu">
          <li class="wp-menu-item">
            <button class="menu-link is-active" data-view="dashboard">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
              <span>Escritorio</span>
            </button>
          </li>

          <li class="wp-menu-item has-submenu">
            <button class="menu-link" data-view="posts">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
              <span>Noticias</span>
              <span class="count-pill" id="menu-posts-count" hidden></span>
            </button>
            <ul class="wp-submenu">
              <li><button class="submenu-link is-active" data-view="posts">Todas las noticias</button></li>
              <li><button class="submenu-link" data-view="new-post">Añadir nueva</button></li>
            </ul>
          </li>

          <li class="wp-menu-item" id="menu-site-content-item">
            <button class="menu-link" data-view="site-content">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
              </svg>
              <span>Textos del Portal</span>
            </button>
          </li>

          <li class="wp-menu-item has-submenu" id="menu-gallery-item">
            <button class="menu-link" data-view="gallery">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
              <span>Galería</span>
            </button>
            <ul class="wp-submenu">
              <li><button class="submenu-link" data-view="gallery">Todas</button></li>
              <li><button class="submenu-link" data-view="gallery-edit">Añadir publicación</button></li>
            </ul>
          </li>

          <!-- Usuarios (solo Administrador) -->
          <li class="wp-menu-item has-submenu" id="menu-users-item">
            <button class="menu-link" data-view="users">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
              <span>Usuarios</span>
            </button>
            <ul class="wp-submenu">
              <li><button class="submenu-link" data-view="users">Todos los usuarios</button></li>
              <li><button class="submenu-link" data-view="user-new">Añadir nuevo</button></li>
              <li><button class="submenu-link" data-view="profile">Perfil</button></li>
            </ul>
          </li>

          <!-- Perfil (Editor y Autor; el Administrador lo tiene dentro de Usuarios) -->
          <li class="wp-menu-item" id="menu-profile-item">
            <button class="menu-link" data-view="profile">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <span>Perfil</span>
            </button>
          </li>

        </ul>
      </aside>

      <!-- MAIN CONTENT STAGE -->
      <main class="wp-content-stage">
        <!-- ========================================================= -->
        <!-- VIEW 1: ESCRITORIO (DASHBOARD) -->
        <!-- ========================================================= -->
        <section id="view-dashboard" class="wp-view is-active">
          <div class="view-header">
            <h1 class="view-title">Escritorio</h1>
            <button class="btn btn-primary" onclick="window.switchView('new-post')">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>Añadir Noticia</span>
            </button>
          </div>

          <!-- Welcome Banner -->
          <div class="wp-welcome-panel">
            <div class="welcome-text">
              <h2>¡Bienvenido al panel de BrandMeister Venezuela!</h2>
              <p>Gestiona los canales, consulta telemetría del TG 734 y publica comunicados oficiales de la red nacional.</p>
            </div>
          </div>

          <!-- At a Glance & Quick Draft Grid -->
          <div class="dashboard-widgets-grid">
            <!-- At a Glance -->
            <div class="wp-box">
              <div class="wp-box-head">
                <h3>De un vistazo</h3>
              </div>
              <div class="wp-box-body">
                <ul class="glance-list">
                  <li>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--bm-orange)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path></svg>
                    <span><strong>4</strong> Noticias publicadas</span>
                  </li>
                  <li>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--bm-red)" stroke-width="2"><circle cx="12" cy="12" r="2"></circle><path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49"></path></svg>
                    <span><strong>8</strong> Repetidores enlazados</span>
                  </li>
                  <li>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#16A34A" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path></svg>
                    <span>Anunciador TG 734 <strong>Operativo</strong></span>
                  </li>
                  <li>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--bm-yellow)" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    <span>Pico diario: <strong>19:00 - 21:30 VET</strong></span>
                  </li>
                </ul>
              </div>
            </div>

            <!-- Quick Draft -->
            <div class="wp-box">
              <div class="wp-box-head">
                <h3>Borrador rápido</h3>
              </div>
              <div class="wp-box-body">
                <form id="quick-draft-form">
                  <div class="form-group">
                    <input type="text" id="qd-title" class="form-input" placeholder="Título de la noticia..." required />
                  </div>
                  <div class="form-group">
                    <textarea id="qd-content" class="form-input" rows="3" placeholder="¿Qué está sucediendo en la red hoy?..." required></textarea>
                  </div>
                  <button type="submit" class="btn btn-secondary" style="font-size: 0.85rem;">
                    Guardar borrador
                  </button>
                </form>
              </div>
            </div>
          </div>

          <!-- Activity Heatmap Panel -->
          <div class="wp-box" style="margin-top: 1.5rem;">
            <div class="wp-box-head">
              <h3>Telemetría de Ocupación del TG 734 (Semana Actual)</h3>
              <span class="badge-mini">Sistema Petra</span>
            </div>
            <div class="wp-box-body">
              <div class="heatmap-chart">
                <div class="chart-hours">
                  <span>00h</span>
                  <span>04h</span>
                  <span>08h</span>
                  <span>12h</span>
                  <span>16h</span>
                  <span>20h</span>
                  <span>23h</span>
                </div>

                <div class="heatmap-rows">
                  {days.map((day) => (
                    <div class="heatmap-day-row">
                      <span class="day-label">{day}</span>
                      <div class="heatmap-cells">
                        {Array.from({ length: 24 }).map((_, hour) => (
                          <div class={`heat-cell ${getCellIntensity(hour)}`} title={`${day} ${hour}:00 hrs`}></div>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ========================================================= -->
        <!-- NOTICIAS -->
        <!-- ========================================================= -->
        <PostsView />

        <!-- ========================================================= -->
        <!-- USUARIOS Y PERFIL -->
        <!-- ========================================================= -->
        <UsersView />
        <ProfileView />

        <!-- ========================================================= -->
        <!-- VIEW 5: TEXTOS DEL PORTAL -->
        <!-- ========================================================= -->
        <section id="view-site-content" class="wp-view">
          <div class="view-header">
            <h1 class="view-title">Textos del Portal Oficial</h1>
            <button id="btn-save-site-texts" class="btn btn-primary">
              Guardar Cambios
            </button>
          </div>

          <div class="wp-editor-layout">
            <div class="editor-main-col">
              <div class="wp-box">
                <div class="wp-box-head">
                  <h3>Página de Inicio (Hero)</h3>
                </div>
                <div class="wp-box-body">
                  <div class="form-group">
                    <label>Titular Principal</label>
                    <input type="text" id="sett-hero-title" class="form-input" value="La voz digital que une a los radioaficionados de Venezuela y el mundo." />
                  </div>
                  <div class="form-group" style="margin-top: 1rem;">
                    <label>Descripción Principal</label>
                    <textarea id="sett-hero-desc" class="form-input" rows="3">Infraestructura abierta y 100% digital basada en el estándar DMR. Conectamos repetidores, puntos de acceso de alta potencia y operadores en todo el territorio nacional con acceso directo a la red global BrandMeister.</textarea>
                  </div>
                </div>
              </div>

              <div class="wp-box" style="margin-top: 1.5rem;">
                <div class="wp-box-head">
                  <h3>Aviso Prioritario de Emergencias (TG 734911)</h3>
                </div>
                <div class="wp-box-body">
                  <div class="form-group">
                    <label>Texto de la Alerta EMCOM / YV5RNE</label>
                    <textarea id="sett-alert-text" class="form-input" rows="3">Reservado exclusivamente para prevención, boletines por fenómenos meteorológicos, alertas sísmicas o contingencias mayores. Se recomienda a todos los radioaficionados mantenerlo programado en su lista de recepción (RX List) bajo el Slot 1 en todos los repetidores del país.</textarea>
                  </div>
                </div>
              </div>
            </div>

            <div class="editor-sidebar-col">
              <div class="wp-box metabox">
                <div class="wp-box-head">
                  <h4>Frecuencias Recomendadas</h4>
                </div>
                <div class="wp-box-body">
                  <div class="form-group">
                    <label>Frecuencia VHF Hotspot</label>
                    <input type="text" id="sett-freq-vhf" class="form-input select-sm" value="146.550 MHz (Alterna: 146.490 MHz)" />
                  </div>
                  <div class="form-group" style="margin-top: 0.75rem;">
                    <label>Frecuencia UHF Hotspot</label>
                    <input type="text" id="sett-freq-uhf" class="form-input select-sm" value="436.550 MHz (Alterna: 436.490 MHz)" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ========================================================= -->
        <GalleryView />

      </main>

    </div>
  </div>
</Layout>

<!-- Global: el marcado de los componentes admin y el HTML generado por JS también usa estas clases (solo se carga en /admin) -->
<style is:global>
  /* =========================================================
     WORDPRESS ADMIN THEME STYLES - 100% LIGHT (NO BLACK)
     ========================================================= */

  /* Campos de formulario base (los modificadores como .select-sm van más abajo) */
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group + .form-group {
    margin-top: 0.85rem;
  }

  /* En el login la separación la da el gap del formulario */
  .wp-login-form .form-group + .form-group {
    margin-top: 0;
  }

  .form-group > label {
    color: var(--text-main);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .form-input {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    background: #FFFFFF;
    color: var(--text-main);
    font-size: 0.92rem;
    line-height: 1.4;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .form-input::placeholder {
    color: var(--text-faint);
  }

  .form-input:hover {
    border-color: rgba(15, 23, 42, 0.28);
  }

  .form-input:focus {
    outline: none;
    border-color: var(--bm-orange);
    box-shadow: 0 0 0 3px rgba(238, 108, 31, 0.18);
  }

  .form-input:disabled {
    background: var(--bg-subtle);
    color: var(--text-faint);
    cursor: not-allowed;
  }

  textarea.form-input {
    resize: vertical;
    min-height: 5rem;
  }

  select.form-input {
    cursor: pointer;
  }

  /* WP Login Card Screen */
  .wp-login-wrapper {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    justify-content: center;
    background: #F1F5F9;
    padding: 2rem 1.5rem;
  }

  .wp-login-card {
    width: 100%;
    max-width: 440px;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 2.5rem;
    box-shadow: var(--shadow-lg);
  }

  .wp-login-logo {
    display: flex;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .wp-login-logo img {
    height: 48px;
    width: auto;
    object-fit: contain;
  }

  .wp-login-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .wp-login-header h2 {
    font-size: 1.35rem;
    color: var(--text-main);
    margin-bottom: 0.35rem;
  }

  .wp-login-header p {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .wp-login-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .wp-login-btn {
    width: 100%;
    padding: 0.85rem;
    font-size: 0.95rem;
    margin-top: 0.5rem;
  }

  .wp-login-error {
    margin: 0;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    background: #FEF2F2;
    border: 1px solid #FECACA;
    color: #B91C1C;
    font-size: 0.85rem;
  }

  /* WP Admin Bar (Top Bar) */
  .wp-admin-app {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #F1F5F9;
  }

  .wp-adminbar {
    height: 46px;
    background: #FFFFFF;
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
    position: sticky;
    top: 0;
    z-index: 90;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .adminbar-left {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .adminbar-site-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .adminbar-site-link:hover {
