];

const internationalChannels = [
  { tg: "91", name: "Worldwide (Mundial)", slot: "Slot 1", lang: "Multilingüe", desc: "El canal global con mayor actividad del planeta. Ideal para QSO intercontinental en inglés y múltiples idiomas." },
  { tg: "913", name: "América Latina e Iberoamérica", slot: "Slot 1", lang: "Español", desc: "Canal común de habla hispana que vincula estaciones de Suramérica, Centroamérica, el Caribe y España." },
  { tg: "334", name: "México (Nacional)", slot: "Slot 1", lang: "Español", desc: "Red hermana vinculada históricamente a Venezuela a través del Máster 3341 pionero de Caracas." },
  { tg: "730", name: "Chile (Nacional)", slot: "Slot 1", lang: "Español", desc: "País anfitrión de nuestro Servidor Máster primario (7301.master.brandmeister.network)." },
  { tg: "732", name: "Colombia (Nacional)", slot: "Slot 1", lang: "Español", desc: "Enlace constante con la vecina república para coordinación y tráfico fraterno bilateral." },
  { tg: "214", name: "España (Nacional)", slot: "Slot 1", lang: "Español", desc: "Canal nacional de la radioafición española con alta presencia de colegas de habla hispana." }
];
---

<Layout
  heroImage={{ desktop: '/assets/services-dmr-composition.webp', mobile: '/assets/services-dmr-composition-m.webp' }}
  title="Talkgroups y Circuitos Regionales · BrandMeister Venezuela"
  description="Directorio completo de Talkgroups y Circuitos Regionales en BrandMeister Venezuela. Ranura 1 y 2, canal nacional TG 734, emergencias TG 734911 y frecuencias hotspot."
>
  <main class="tg-page">
    <!-- Hero 50vh con fondo services-dmr-composition.webp y tratamiento lateral -->
    <section class="tg-hero">
      <div class="container">
        <div class="tg-hero-content">
          <div class="tg-badge">
            <span>Estructura Oficial BrandMeister · MCC 734</span>
          </div>
          <h1 class="tg-hero-title">Talkgroups y Circuitos</h1>
          <p class="tg-hero-subtitle">
            Directorio completo y guía operativa de grupos de conversación DMR en Venezuela. Conoce la distribución de ranuras de tiempo (Slot 1 y Slot 2), canales de emergencia, circuitos regionales y frecuencias recomendadas.
          </p>
          <div class="tg-hero-meta">
            <span>MCC 734</span> · <span>9 Circuitos Regionales</span> · <span>Slot 1 (Nacional)</span> · <span>Slot 2 (Regional y Hotspots)</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Línea divisoria con degradado de 3 colores BrandMeister -->
    <div class="bm-stripe"></div>

    <!-- Contenido Principal -->
    <section class="tg-content-body section-padding">
      <div class="container">
        <!-- Banner Guía: Slot 1 vs Slot 2 -->
        <div class="slots-guide-card">
          <div class="slots-header">
            <div class="slots-tag">Norma de Oro TDMA</div>
            <h2 class="slots-h2">Uso Correcto de las Ranuras de Tiempo (Slots)</h2>
            <p class="slots-p">
              En tecnología digital DMR, un mismo repetidor físico transporta dos conversaciones independientes y simultáneas gracias al sistema de división de tiempo (TDMA). Para mantener la red ordenada y disponible, seguimos esta distribución:
            </p>
          </div>

          <div class="slots-grid">
            <div class="slot-column slot-1-col">
              <div class="slot-pill slot-1-pill">Slot 1 · Ranura de Tiempo 1</div>
              <h3 class="slot-col-title">Tráfico Nacional y Emergencias</h3>
              <ul class="slot-col-list">
                <li><strong>Canal Nacional Principal (TG 734)</strong>: Abre repetidores a escala nacional. Se utiliza para llamada general (CQ) y contactos breves.</li>
                <li><strong>Emergencias (TG 734911)</strong>: Prioridad absoluta para la Red Nacional de Emergencia YV5RNE y contingencias.</li>
                <li><strong>Regla de Paso a QSO (QSY)</strong>: Si tu contacto en TG 734 dura más de 2-3 minutos, pasa con tu corresponsal a un circuito regional en Slot 2.</li>
              </ul>
            </div>

            <div class="slot-column slot-2-col">
              <div class="slot-pill slot-2-pill">Slot 2 · Ranura de Tiempo 2</div>
              <h3 class="slot-col-title">Circuitos Regionales, Clubes y Hotspots</h3>
              <ul class="slot-col-list">
                <li><strong>Circuitos Regionales (TG 7341 - TG 7349)</strong>: Charlas extendidas (ragchew) entre colegas de una misma región o de paso.</li>
                <li><strong>Institucional y Tácticos</strong>: RCV (TG 73473), boletines (TG 73452) y canales tácticos (TG 7340 / TG 73499).</li>
                <li><strong>Uso en Hotspots Residenciales</strong>: Frecuencias simplex VHF 146.550 MHz y UHF 436.550 MHz configuradas en Slot 2.</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- 1. Canales Nacionales y de Servicio (Slot 1) -->
        <div class="directory-section" id="seccion-nacionales">
          <div class="section-intro">
            <span class="sub-label">Canales Primarios · Slot 1</span>
            <h2 class="section-h2">Talkgroups Nacionales de Cobertura Total</h2>
            <p class="intro-p">
              Canales con presencia permanente y enlace troncalizado entre repetidores fijos de Venezuela y los servidores centrales BrandMeister.
            </p>
          </div>

          <div class="tg-cards-grid">
            {nationalChannels.map((item) => (
              <div class="tg-detail-card">
                <div class="card-top-row">
                  <span class="tg-pill">{item.badge}</span>
                  <div class="tg-slot-tag">{item.slot} · {item.colorCode}</div>
                </div>

                <div class="card-tg-main">
                  <span class="card-tg-number">TG {item.tg}</span>
                </div>

                <h3 class="card-tg-name">{item.name}</h3>
                <p class="card-tg-desc">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- 2. Canales Institucionales y Tácticos (Slot 2) -->
        <div class="directory-section" id="seccion-institucionales">
          <div class="section-intro">
            <span class="sub-label">Enlace Comunitario · Slot 2</span>
            <h2 class="section-h2">Canales Institucionales y Tácticos</h2>
            <p class="intro-p">
              Espacios dedicados al Radio Club Venezolano, ruedas de confraternidad y canales de desborde táctico para eventos de campo.
            </p>
          </div>

          <div class="tg-cards-grid">
            {institutionalChannels.map((item) => (
              <div class="tg-detail-card">
                <div class="card-top-row">
                  <span class="tg-pill">{item.badge}</span>
                  <div class="tg-slot-tag">{item.slot} · {item.colorCode}</div>
                </div>

                <div class="card-tg-main">
                  <span class="card-tg-number">TG {item.tg}</span>
                </div>

                <h3 class="card-tg-name">{item.name}</h3>
                <p class="card-tg-desc">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- 3. Los 9 Circuitos Regionales (Slot 2) -->
        <div class="directory-section" id="seccion-circuitos">
          <div class="section-intro">
            <span class="sub-label">División Geográfica Nacional · Slot 2</span>
            <h2 class="section-h2">Los 9 Circuitos Regionales de Venezuela</h2>
            <p class="intro-p">
              Estructura organizada para el tráfico local e intercomunicación regional. Cada circuito agrupa estados geográficamente afines para conversaciones extendidas sin ocupar la Ranura 1 nacional.
            </p>
          </div>

          <div class="circuits-cards-grid">
            {regionalCircuits.map((c) => (
              <div class="circuit-card">
                <div class="circuit-card-header">
                  <span class="circuit-num-badge">{c.circuit}</span>
                  <span class="tg-slot-tag">Slot 2 · CC1</span>
                </div>

                <div class="card-tg-main">
                  <h3 class="circuit-tg-id">TG {c.tg}</h3>
                </div>

                <div class="circuit-region-name">{c.region}</div>

                <div class="circuit-states-pills">
                  {c.states.map((st) => (
                    <span class="state-pill">{st}</span>
                  ))}
                </div>

                <p class="circuit-desc">{c.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- 4. Frecuencias y Parámetros Estándar para Hotspots -->
        <div class="hotspot-standard-box">
          <div class="hotspot-box-header">
            <div class="sub-label">Guía de Configuración Rápida</div>
            <h2 class="hotspot-box-title">Frecuencias Simplex Recomendadas para Hotspots</h2>
            <p class="hotspot-box-p">
              Para evitar interferencias en zonas de alta densidad de radioaficionados y mantener compatibilidad con codeplugs compartidos, se recomienda utilizar las siguientes frecuencias estándar en puntos de acceso MMDVM / Pi-Star:
            </p>
          </div>

          <div class="hotspot-params-grid">
            <div class="hotspot-param-card">
              <div class="param-band-pill band-vhf">VHF · 2 Metros</div>
              <div class="param-freq">146.550 MHz</div>
              <div class="param-spec-row">
                <span>Modo: <strong>DMR Simplex</strong></span>
                <span>Slot: <strong>Slot 2</strong></span>
                <span>Color Code: <strong>CC 1</strong></span>
              </div>
              <p class="param-note">Frecuencia nacional estándar recomendada para puntos de acceso residenciales en VHF.</p>
            </div>

            <div class="hotspot-param-card">
              <div class="param-band-pill band-uhf">UHF · 70 Centímetros</div>
              <div class="param-freq">436.550 MHz</div>
              <div class="param-spec-row">
                <span>Modo: <strong>DMR Simplex</strong></span>
                <span>Slot: <strong>Slot 2</strong></span>
                <span>Color Code: <strong>CC 1</strong></span>
              </div>
              <p class="param-note">Frecuencia estándar en UHF para evitar solapamiento con entradas o salidas de repetidores activos.</p>
            </div>

            <div class="hotspot-param-card">
              <div class="param-band-pill band-server">Servidor Máster Oficial</div>
              <div class="param-freq">7301 Chile</div>
              <div class="param-spec-row">
                <span>Host: <strong>7301.master.brandmeister.network</strong></span>
                <span>Pass: <strong>Hotspot Security Password</strong></span>
              </div>
              <p class="param-note">Servidor de enlace primario con menor latencia para Venezuela y conectividad troncal directa.</p>
            </div>
          </div>
        </div>

        <!-- 5. Canales Internacionales y de Habla Hispana -->
        <div class="directory-section" id="seccion-internacionales">
          <div class="section-intro">
            <span class="sub-label">Interconexión Global · BrandMeister</span>
            <h2 class="section-h2">Talkgroups Internacionales y de Interés</h2>
            <p class="intro-p">
              Canales globales enlazados a través de la infraestructura mundial BrandMeister con alta presencia de radioaficionados de habla hispana.
            </p>
          </div>

          <div class="intl-table-wrap">
            <table class="intl-table">
              <thead>
                <tr>
                  <th>Talkgroup</th>
                  <th>Nombre del Canal</th>
                  <th>Ranura (Slot)</th>
                  <th>Idioma</th>
                  <th>Descripción Operativa</th>
                </tr>
              </thead>
              <tbody>
                {internationalChannels.map((intl) => (
                  <tr>
                    <td>
                      <span class="intl-tg-code">TG {intl.tg}</span>
                    </td>
                    <td class="intl-name-cell"><strong>{intl.name}</strong></td>
                    <td><span class="slot-badge-sm">{intl.slot}</span></td>
                    <td><span class="lang-badge">{intl.lang}</span></td>
                    <td class="intl-desc-cell">{intl.desc}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 6. Buenas Costumbres y Etiqueta en DMR -->
        <div class="etiquette-box">
          <div class="etiquette-badge">Código de Conducta Operativa</div>
          <h2 class="etiquette-title">Buenas Prácticas para Operar en BrandMeister Venezuela</h2>
          <div class="etiquette-grid">
            <div class="etiquette-item">
              <div class="etiquette-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
              <h4 class="etiquette-h4">Pausa de 3 Segundos</h4>
              <p class="etiquette-p">Espera 3 segundos entre cambios antes de pulsar PTT. Esto permite que los repetidores y enlaces IP liberen la portadora y que estaciones de emergencia puedan interrumpir.</p>
            </div>

            <div class="etiquette-item">
              <div class="etiquette-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </div>
              <h4 class="etiquette-h4">No Hablar Encima</h4>
              <p class="etiquette-p">A diferencia de la FM analógica, en DMR modular sobre otra estación genera pérdida completa de tramas de voz para todos los receptores de la red.</p>
            </div>

            <div class="etiquette-item">
              <div class="etiquette-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <h4 class="etiquette-h4">QSY a Circuitos</h4>
              <p class="etiquette-p">El TG 734 es para llamada y contacto breve. Si el QSO se extenderá, invita cordialmente a tu corresponsal a pasar al circuito regional correspondiente en Slot 2.</p>
            </div>

            <div class="etiquette-item">
              <div class="etiquette-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              </div>
              <h4 class="etiquette-h4">Identificación Oportuna</h4>
              <p class="etiquette-p">Identifica tu estación con nombre e indicativo reglamentario al inicio y cierre de cada transmisión, facilitando el registro y la confraternidad.</p>
            </div>
          </div>
        </div>

      </div>
    </section>
  </main>
</Layout>

<style>
  .tg-page {
    background: #FAFAFA;
    min-height: 100vh;
  }

  /* Hero 50vh con fondo services-dmr-composition.webp y tratamiento lateral */
  .tg-hero {
    position: relative;
    min-height: 50vh;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #FFFFFF;
    background-image:
      linear-gradient(90deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.94) 45%, rgba(255, 255, 255, 0.65) 75%, rgba(255, 255, 255, 0.18) 100%),
      linear-gradient(0deg, #FAFAFA 0%, rgba(255, 255, 255, 0.8) 12%, transparent 35%),
      url('/assets/services-dmr-composition.webp');
    background-size: cover;
    background-position: right center;
    background-repeat: no-repeat;
    padding: 3.5rem 0;
  }

  @media (max-width: 768px) {
    .tg-hero {
      min-height: 50vh;
      background-image:
        linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.95) 60%, rgba(255, 255, 255, 0.88) 100%),
        url('/assets/services-dmr-composition-m.webp');
      background-position: center top;
      background-size: cover;
      padding: 2.5rem 0;
    }
  }

  .tg-hero-content {
    max-width: 820px;
  }

  .tg-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--bm-red);
    border: 1px solid rgba(232, 38, 28, 0.45);
    background: rgba(232, 38, 28, 0.04);
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .tg-hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.15;
    margin-bottom: 0.85rem;
  }

  .tg-hero-subtitle {
    font-size: clamp(1.02rem, 1.8vw, 1.2rem);
    line-height: 1.6;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .tg-hero-meta {
    font-size: 0.95rem;
    color: var(--text-muted);
    font-weight: 500;
    line-height: 1.5;
  }

  /* Línea divisoria tricolor BrandMeister */
  .bm-stripe {
    height: 3px;
    background: linear-gradient(90deg, #E8261C 0%, #EE6C1F 50%, #F2A93B 100%);
    width: 100%;
    display: block;
    position: relative;
    z-index: 10;
  }

  .tg-content-body {
    padding-top: clamp(2.5rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 5vw, 5rem);
