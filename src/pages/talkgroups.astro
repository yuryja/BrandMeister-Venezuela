    badgeClass: "badge-institutional"
  },
  {
    tg: "7340",
    name: "Táctico 1 · Desborde General",
    slot: "Slot 2",
    colorCode: "CC1",
    type: "Táctico / QSO",
    desc: "Canal de desborde recomendado para trasladar conversaciones que se originan en el TG 734, liberando la Ranura 1 para nuevas llamadas.",
    badge: "Táctico",
    badgeClass: "badge-tactical"
  },
  {
    tg: "73499",
    name: "Táctico 2 · Expediciones y Eventos",
    slot: "Slot 2",
    colorCode: "CC1",
    type: "Operaciones Especiales",
    desc: "Reservado para activaciones de campo, concursos, actividades de radio en cimas (SOTA), parques y enlaces técnicos temporales.",
    badge: "Especial",
    badgeClass: "badge-tactical"
  }
];

const regionalCircuits = [
  {
    tg: "7341",
    circuit: "Circuito 1",
    region: "Occidente",
    states: ["Falcón", "Trujillo", "Zulia"],
    desc: "Costa Oriental del Lago, península de Paraguaná, Maracaibo y el eje andino-occidental trujillano.",
    highlight: "Zulia, Falcón, Trujillo"
  },
  {
    tg: "7342",
    circuit: "Circuito 2",
    region: "Los Andes y Piedemonte",
    states: ["Barinas", "Mérida", "Táchira"],
    desc: "Cordillera de Los Andes, San Cristóbal, Mérida metropolitana y el piedemonte barinés.",
    highlight: "Táchira, Mérida, Barinas"
  },
  {
    tg: "7343",
    circuit: "Circuito 3",
    region: "Centroccidente",
    states: ["Lara", "Portuguesa", "Yaracuy"],
    desc: "Barquisimeto, Valle del Turbio, San Felipe y la zona agrícola de Portuguesa.",
    highlight: "Lara, Portuguesa, Yaracuy"
  },
  {
    tg: "7344",
    circuit: "Circuito 4",
    region: "Región Central",
    states: ["Aragua", "Carabobo", "Cojedes"],
    desc: "Valencia, Maracay, Puerto Cabello, Lago de Valencia y los llanos de San Carlos.",
    highlight: "Carabobo, Aragua, Cojedes"
  },
  {
    tg: "7345",
    circuit: "Circuito 5",
    region: "Capital, Litoral y Llanos",
