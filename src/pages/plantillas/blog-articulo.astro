---
// Plantilla del artículo: Astro genera el HTML con el diseño y PHP (public/blog.php)
// sustituye los @@MARCADORES@@ por la noticia de la base de datos.
// No se enlaza desde el sitio y /plantillas está bloqueado en .htaccess.
import Layout from '../../layouts/Layout.astro';
---

<Layout title="@@META_TITULO@@" description="@@META_DESCRIPCION@@">
  <article class="article-page">
    <header class="article-header">
      <div class="container container-reading">
        <nav class="article-breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Inicio</a>
          <span>/</span>
          <a href="/blog">Noticias</a>
          <span>/</span>
          <span class="current">@@CATEGORIA@@</span>
        </nav>

        <div class="article-meta-badge">
          <span class="category-tag">@@CATEGORIA@@</span>
          <span class="read-time">@@TIEMPO_LECTURA@@</span>
        </div>

        <h1 class="article-headline">@@TITULO@@</h1>

        <p class="article-lead">@@DESCRIPCION@@</p>

        <div class="article-byline">
          <div class="author-details">
            <span class="by-text">Publicado por</span>
            <span class="author-name">@@AUTOR@@</span>
            <span class="callsign-chip">@@INDICATIVO@@</span>
          </div>

          <time datetime="@@FECHA_ISO@@" class="pub-date">@@FECHA_LARGA@@</time>
        </div>
      </div>
    </header>

    <figure class="article-hero-image" data-bm-opcional="imagen">
      <div class="container container-reading">
        <img src="@@IMAGEN@@" alt="@@TITULO@@" width="1920" height="1280" fetchpriority="high" />
      </div>
    </figure>

    <div class="article-body section-padding">
      <div class="container container-reading">
        <div class="prose-content">@@CONTENIDO@@</div>

        <div class="article-tags-row">
          <span class="tags-title">Etiquetas:</span>
          <div class="tags-list">
            <template data-bm-plantilla="etiqueta"><span class="tag-badge">#@@ETIQUETA@@</span></template>
            @@ETIQUETAS@@
          </div>
        </div>

        <div class="article-share-strip">
          <div class="share-actions">
            <span class="share-title">Compartir:</span>
            <a href="https://api.whatsapp.com/send?text=@@COMPARTIR_TEXTO_URL@@" target="_blank" rel="noopener noreferrer" class="share-btn whatsapp" aria-label="Compartir por WhatsApp" title="WhatsApp">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.48-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.38-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35z"/><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.38a9.87 9.87 0 0 0 4.75 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm0 18.02h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.13.82.84-3.05-.2-.31a8.17 8.17 0 0 1-1.25-4.35c0-4.53 3.69-8.22 8.23-8.22 2.2 0 4.26.86 5.81 2.41a8.16 8.16 0 0 1 2.41 5.82c0 4.54-3.69 8.21-8.22 8.21z"/></svg>
              <span class="share-label">WhatsApp</span>
            </a>
            <a href="https://t.me/share/url?url=@@URL_CODIFICADA@@&text=@@TITULO_URL@@" target="_blank" rel="noopener noreferrer" class="share-btn telegram" aria-label="Compartir por Telegram" title="Telegram">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M21.94 4.3 18.9 19.1c-.23 1.02-.84 1.27-1.7.79l-4.7-3.46-2.27 2.18c-.25.25-.46.46-.94.46l.34-4.78 8.7-7.86c.38-.34-.08-.53-.59-.19L6.99 13.4l-4.63-1.45c-1.01-.31-1.03-1 .21-1.48l18.1-6.98c.84-.31 1.57.19 1.27 1.81z"/></svg>
              <span class="share-label">Telegram</span>
            </a>
            <a href="https://twitter.com/intent/tweet?text=@@TITULO_URL@@&url=@@URL_CODIFICADA@@" target="_blank" rel="noopener noreferrer" class="share-btn twitter" aria-label="Compartir en X" title="X (Twitter)">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7.1 8.1L23.2 22h-6.6l-5.2-6.8L5.4 22H2.3l7.6-8.7L1.1 2h6.8l4.7 6.2L18.9 2zm-1.1 18.1h1.7L7.3 3.8H5.5l12.3 16.3z"/></svg>
              <span class="share-label">X</span>
            </a>
            <a href="https://www.facebook.com/sharer/sharer.php?u=@@URL_CODIFICADA@@" target="_blank" rel="noopener noreferrer" class="share-btn facebook" aria-label="Compartir en Facebook" title="Facebook">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.5-3.91 3.77-3.91 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.45 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94z"/></svg>
              <span class="share-label">Facebook</span>
            </a>
            <button type="button" class="share-btn copiar" id="btn-copiar-enlace" data-url="@@URL@@" aria-label="Copiar enlace" title="Copiar enlace">
              <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
              <span class="share-label">Copiar enlace</span>
            </button>
          </div>

          <a href="/blog" class="btn btn-secondary">← Volver a Noticias</a>
        </div>
      </div>
    </div>
  </article>
</Layout>

<script is:inline>
  document.getElementById('btn-copiar-enlace')?.addEventListener('click', async (e) => {
    const boton = e.currentTarget;
    try {
      await navigator.clipboard.writeText(boton.dataset.url || location.href);
      const etiqueta = boton.querySelector('.share-label');
      const original = etiqueta.textContent;
      etiqueta.textContent = '¡Copiado!';
      boton.classList.add('is-copied');
      setTimeout(() => {
        etiqueta.textContent = original;
        boton.classList.remove('is-copied');
      }, 1800);
    } catch {
      /* Sin permiso de portapapeles: el usuario puede copiar la URL de la barra */
    }
  });
</script>

<!-- Global con prefijo .article-page: PHP inserta el contenido del artículo -->
<style is:global>
  .article-page .container-reading {
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
  }

  .article-page .article-header {
    background: #FFFFFF;
    border-bottom: 1px solid var(--border-subtle);
    padding-top: clamp(3rem, 5vw, 4.5rem);
    padding-bottom: clamp(3rem, 5vw, 4rem);
  }

  .article-page .article-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-faint);
    margin-bottom: 1.5rem;
  }

  .article-page .article-breadcrumbs a {
    color: var(--bm-orange);
  }

  .article-page .article-breadcrumbs .current {
    color: var(--text-muted);
  }

  .article-page .article-meta-badge {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .article-page .category-tag {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--bm-red);
    background: rgba(232, 38, 28, 0.08);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  .article-page .read-time {
    font-size: 0.82rem;
    color: var(--text-faint);
  }

  .article-page .article-headline {
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.2;
    margin-bottom: 1.25rem;
    color: var(--text-main);
  }

  .article-page .article-lead {
    font-size: 1.25rem;
    line-height: 1.65;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .article-page .article-byline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .article-page .author-details {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
  }

  .article-page .by-text {
    color: var(--text-faint);
  }

  .article-page .author-name {
    font-weight: 700;
    color: var(--text-main);
  }

  .article-page .callsign-chip {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--bm-orange);
    background: rgba(238, 108, 31, 0.1);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .article-page .pub-date {
    font-size: 0.85rem;
    color: var(--text-faint);
    text-transform: capitalize;
  }

  /* Prose Content Styling (Strictly NO monospace, letter-spacing 0) */
  .article-page .article-body {
    background: var(--bg-page);
  }

  .article-page .prose-content {
    font-size: 1.12rem;
    line-height: 1.8;
    color: #1E293B;
  }

  .article-page .prose-content h2 {
    font-size: 1.85rem;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    color: var(--text-main);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.5rem;
  }

  .article-page .prose-content h3 {
    font-size: 1.45rem;
    margin-top: 2.2rem;
    margin-bottom: 0.85rem;
    color: var(--text-main);
  }

  .article-page .prose-content p {
    margin-bottom: 1.5rem;
    font-size: 1.12rem;
    line-height: 1.8;
    color: #334155;
  }

  .article-page .prose-content ul, .article-page .prose-content ol {
    margin-bottom: 1.75rem;
    padding-left: 1.75rem;
  }

  .article-page .prose-content li {
    margin-bottom: 0.6rem;
    line-height: 1.7;
    color: #334155;
  }

  .article-page .prose-content a {
    color: var(--bm-orange);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
  }

  .article-page .prose-content a:hover {
    color: var(--bm-red);
  }

  .article-page .prose-content strong {
    color: var(--text-main);
    font-weight: 700;
  }

  /* Code-like tags styled with sans-serif font instead of monospace */
  .article-page .prose-content code {
    font-family: 'Plus Jakarta Sans', sans-serif !important;
    font-size: 0.95em;
    background: #E2E8F0;
    color: #0F172A;
    padding: 0.2rem 0.45rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  /* Tags Row */
  .article-page .article-tags-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .article-page .tags-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-faint);
  }

  .article-page .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .article-page .tag-badge {
    font-size: 0.8rem;
    color: var(--bm-orange);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  /* Share Strip */
  .article-page .article-share-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
    padding: 1.5rem 2rem;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .article-page .share-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .article-page .share-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .article-page .share-btn {
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    transition: all 0.18s ease;
  }

  .article-page .share-btn.whatsapp:hover {
    background: #25D366;
    color: #FFFFFF;
    border-color: #25D366;
  }

  .article-page .share-btn.telegram:hover {
    background: #0088CC;
    color: #FFFFFF;
    border-color: #0088CC;
  }

  .article-page .share-btn.twitter:hover {
    background: #000000;
    color: #FFFFFF;
    border-color: #000000;
  }

  /* Compartir: iconos de marca con la etiqueta oculta en móvil */
  .article-page .share-actions {
    flex-wrap: wrap;
  }

  .article-page .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid var(--border-subtle);
    background: #FFFFFF;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
  }

  .article-page .share-btn:hover {
    transform: translateY(-1px);
  }

  /* Al pasar el ratón, cada icono toma el color de su red */
  .article-page .share-btn.facebook:hover {
    background: #1877F2;
    color: #FFFFFF;
    border-color: #1877F2;
  }

  .article-page .share-btn.copiar:hover,
  .article-page .share-btn.copiar.is-copied {
    background: var(--bm-orange);
    color: #FFFFFF;
    border-color: var(--bm-orange);
  }

  @media (max-width: 640px) {
    .article-page .share-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .article-page .share-btn {
      padding: 0.55rem;
      border-radius: 50%;
    }
  }

  .article-page .article-hero-image {
    margin: 0;
    padding: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    background: var(--bg-page);
  }

  .article-page .article-hero-image img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    background: var(--bg-subtle);
  }
</style>
