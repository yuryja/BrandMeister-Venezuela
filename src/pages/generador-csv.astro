---
import Layout from '../layouts/Layout.astro';
import '../styles/generador-csv.css';
import { OPCIONES_PERSONALIZADAS } from '../scripts/codeplug';

const metaTitle = "Generador de CSV y Codeplugs DMR · BrandMeister Venezuela";
const metaDescription = "Genera y descarga archivos CSV formateados para programar tu radio DMR (Baofeng DM-32UV, DM-1701, OpenGD77, Retevis RT3S, AnyTone, TYT, Motorola). Incluye Talkgroups oficiales de Venezuela y base de contactos de RadioID.";
---

<Layout
  heroImage={{ desktop: '/assets/news-motorola-bg.webp', mobile: '/assets/news-motorola-bg-m.webp' }}
  title={metaTitle}
  description={metaDescription}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Generador de CSV para Radios DMR · BrandMeister Venezuela",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "url": "https://brandmeisteryv.net/generador-csv",
      "description": metaDescription,
      "browserRequirements": "Requires JavaScript. Requires HTML5."
    })} />
  </Fragment>

  <main class="codeplug-page">
    <!-- Hero Section con la imagen Motorola del post de RadioID -->
    <section class="codeplug-hero">
      <div class="container">
        <div class="codeplug-hero__content">
          <div class="codeplug-hero__badge">
            <span>Herramientas de Programación DMR</span>
          </div>
          <h1 class="codeplug-hero__title">Generador de Archivos CSV para Radios</h1>
          <p class="codeplug-hero__subtitle">
            Exporta al instante los Talkgroups oficiales de Venezuela (Plan 734) y la libreta de contactos digitales de RadioID en el formato exacto que exige el CPS de tu modelo de radio.
          </p>
          <div class="codeplug-hero__meta">
            <span>Baofeng DM-32UV · DM-1701 · OpenGD77 · Retevis RT3S · AnyTone · TYT · Motorola</span>
            <i class="codeplug-hero__dot" aria-hidden="true"></i>
            <span>Formato Nativo CPS</span>
            <i class="codeplug-hero__dot" aria-hidden="true"></i>
            <span>Datos Oficiales RadioID</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Franja con degradado BrandMeister -->
    <div class="codeplug-stripe" aria-hidden="true"></div>

    <!-- Cuerpo del Generador -->
    <section class="codeplug-body">
      <div class="container">
        <div class="codeplug-main-card">

          <!-- PASO 1: Seleccionar Modelo de Radio (Select Grueso) -->
          <div class="config-step">
            <div class="step-header">
              <div class="step-header__main">
                <span class="step-number">1</span>
                <div>
                  <h2 class="step-title">Selecciona el modelo o software de tu radio</h2>
                  <p class="step-subtitle">El generador adaptará los encabezados, columnas y estructura según tu software de programación (CPS).</p>
                </div>
              </div>
            </div>

            <div class="model-select-wrapper">
              <div class="select-wrapper select-wrapper--model">
                <select id="select-model" class="form-control-select form-control-select--model" aria-label="Seleccionar modelo de radio">
                  <optgroup label="Firmware Alternativo / Comunitario">
                    <option value="opengd77">OpenGD77 / OpenUV380 · Firmware Libre (DM-32UV, DM-1701, RT3S, TYT UV380/390, GD-77)</option>
                  </optgroup>
                  <optgroup label="Software CPS Oficial de Fábrica">
                    <option value="anytone" selected>AnyTone & BTECH / Alinco · AT-D878UV (I/II Plus), AT-D578UV, BTECH DMR-6X2, Alinco DJ-MD5</option>
                    <option value="baofeng">Baofeng CPS Oficial · DM-32UV, DM-1701, DM-1801, RD-5R (Software original de fábrica)</option>
                    <option value="tyt">TYT & Retevis CPS Oficial · Retevis RT3S, RT3, RT82, RT84, TYT MD-UV380, MD-9600, MD-380</option>
                    <option value="radioddity">Radioddity CPS Oficial · GD-77 original de fábrica, DB25-D</option>
                    <option value="motorola">Motorola MOTOTRBO · Serie DGP (8550/5550), DGM, DP, Serie XPR</option>
                  </optgroup>
                  <optgroup label="Formatos Universales">
                    <option value="universal">Universal / Excel · CSV estándar, Chirp, Planillas de cálculo y otros CPS</option>
                  </optgroup>
                </select>
                <span class="select-chevron"></span>
              </div>

              <!-- Detalle del modelo seleccionado (Limpio: sin icono, sin píldora y sin borde grueso) -->
              <div class="model-info-banner" id="model-info-banner">
                <div class="model-info-banner__main">
                  <span class="model-info-banner__name" id="model-box-title">AnyTone & BTECH / Alinco</span>
                  <span class="model-info-banner__desc" id="model-box-desc">Compatible con AnyTone AT-D878UV (I/II Plus), AT-D578UV, BTECH DMR-6X2 y Alinco DJ-MD5.</span>
                </div>
                <div class="model-info-banner__badge">
                  <span class="model-info-banner__format-tag" id="model-box-format">TalkGroups.csv + DigitalContactList.csv (Pack ZIP)</span>
                </div>
              </div>
            </div>
          </div>

          <!-- PASO 2: Opciones de Contenido y Alcance -->
          <div class="config-step">
            <div class="step-header">
              <div class="step-header__main">
                <span class="step-number">2</span>
                <div>
                  <h2 class="step-title">Personaliza el contenido y los Talkgroups</h2>
                  <p class="step-subtitle">Configura los canales digitales nacionales o regionales y la libreta de contactos de RadioID.</p>
                </div>
              </div>
            </div>

            <div class="form-nested-grid">
              <!-- Select 1: Tipo de Contenido -->
              <div class="form-select-card" id="card-content-type">
                <label class="form-select-label" for="select-content-type">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                  </svg>
                  <span>1. ¿Qué deseas incluir?</span>
                </label>
                <div class="select-wrapper">
                  <select id="select-content-type" class="form-control-select">
                    <option value="all" selected>Pack Completo (Talkgroups + Contactos)</option>
                    <option value="talkgroups">Solo Talkgroups (TGs)</option>
                    <option value="contacts">Solo Directorio de Contactos (RadioID)</option>
                  </select>
                  <span class="select-chevron"></span>
                </div>
                <p class="form-select-hint" id="type-hint">Generará tanto los canales digitales (Talkgroups) como la libreta para identificar llamadas.</p>
              </div>

              <!-- Select 2: Selección de Talkgroups (Solo 3 opciones solicitadas) -->
              <div class="form-select-card" id="card-talkgroups-config">
                <label class="form-select-label" for="select-tg-filter">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9"></path>
                    <path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5"></path>
                    <circle cx="12" cy="12" r="2"></circle>
                    <path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5"></path>
                    <path d="M19.1 4.9C23 8.8 23 15.2 19.1 19.1"></path>
                  </svg>
                  <span>2. Canales Talkgroups:</span>
                </label>
                <div class="select-wrapper">
                  <select id="select-tg-filter" class="form-control-select">
                    <option value="oficiales" selected>TGs Oficiales</option>
                    <option value="globales">TGs Globales</option>
                    <option value="personalizado">Personalizado</option>
                  </select>
                  <span class="select-chevron"></span>
                </div>
                <p class="form-select-hint" id="tg-hint">TGs Oficiales de Venezuela (16 TGs: Troncales Nacionales + 9 Circuitos Regionales).</p>
              </div>

              <!-- Select 3: Alcance de Contactos RadioID -->
              <div class="form-select-card" id="card-contacts-config">
                <label class="form-select-label" for="select-scope">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                  <span>3. Libreta de Contactos (Capacidad):</span>
                </label>
                <div class="select-wrapper">
                  <select id="select-scope" class="form-control-select">
                    <option value="venezuela" selected>Venezuela (MCC 734 · ~720 IDs - Todos los radios)</option>
                    <option value="latam">Iberoamérica / Latam (~31.000 IDs - Radios gama media/alta)</option>
                    <option value="global">Mundial Completo (Global ~314.000 IDs - AnyTone 878 / OpenGD77 flash)</option>
                  </select>
                  <span class="select-chevron"></span>
                </div>
                <p class="form-select-hint" id="scope-hint">~720 indicativos venezolanos. Compatible con todos los radios sin agotar memoria.</p>
              </div>
            </div>

            <!-- Panel de TGs Personalizados: AHORA A ANCHO COMPLETO -->
            <div class="custom-tgs-wrapper custom-tgs-wrapper--fullwidth" id="custom-tgs-wrapper" style="display: none;">
              <div class="custom-tgs-header">
                <div class="custom-tgs-header__left">
                  <div class="custom-tgs-header__icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                  </div>
                  <div>
                    <h3 class="custom-tgs-title">Elige los canales y circuitos que deseas incluir:</h3>
                    <p class="custom-tgs-subtitle">Marca o desmarca los paquetes troncales, los 9 circuitos regionales o los enlaces internacionales para tu archivo.</p>
                  </div>
                </div>

                <div class="custom-tgs-actions">
                  <button type="button" class="btn-check-all" id="btn-tg-select-all">Todos</button>
                  <button type="button" class="btn-check-all" id="btn-tg-select-vzla">Solo Venezuela</button>
                  <button type="button" class="btn-check-all btn-check-all--clear" id="btn-tg-deselect-all">Desmarcar Todos</button>
                  <div class="custom-tgs-counter-pill" id="custom-tgs-counter">Total: 16 TGs</div>
                </div>
              </div>

              <div class="custom-tgs-grid" id="custom-tgs-list">
                {OPCIONES_PERSONALIZADAS.map(opc => (
                  <label class={`custom-tg-card ${(opc.categoria === 'Venezuela' || opc.categoria.includes('Circuitos')) ? 'is-checked' : ''}`}>
                    <input
                      type="checkbox"
                      class="custom-tg-checkbox"
                      value={opc.id}
                      checked={opc.categoria === 'Venezuela' || opc.categoria.includes('Circuitos')}
                    />
                    <div class="custom-tg-card__body">
                      <div class="custom-tg-card__top">
                        <span class="custom-tg-card__cat">{opc.categoria}</span>
                        <span class="custom-tg-card__badge">{opc.tgs.length} TG{opc.tgs.length > 1 ? 's' : ''}</span>
                      </div>
                      <div class="custom-tg-card__name">{opc.nombre}</div>
                      <div class="custom-tg-card__desc">{opc.descripcion}</div>
                    </div>
                  </label>
                ))}
              </div>
            </div>
          </div>

          <!-- Panel de Acción y Descarga -->
          <div class="download-action-card">
            <div class="download-summary">
              <div class="download-summary__icon">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
              </div>
              <div>
                <h3 class="download-summary__title" id="summary-title">AnyTone · Pack Completo (Venezuela)</h3>
                <p class="download-summary__details" id="summary-desc">Generará archivo ZIP con TalkGroups.csv y DigitalContactList.csv listos para importar.</p>
                <p class="download-summary__meta" id="summary-meta"></p>
              </div>
            </div>

            <div class="download-btn-group">
              <!-- Botón con el ojito (Abre el Modal) -->
              <button type="button" class="btn-preview-toggle" id="btn-toggle-preview" aria-label="Ver vista previa en modal">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <span>Ver Previa</span>
              </button>

              <button type="button" id="btn-download" class="btn-codeplug-download">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>Descargar Archivos</span>
              </button>
            </div>
          </div>

          <!-- Progreso: los contactos se descargan en el dispositivo del visitante -->
          <div class="download-progress" id="download-progress" hidden>
            <div class="download-progress__bar" id="download-progress-bar" role="progressbar" aria-label="Descarga de contactos" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
              <div class="download-progress__fill" id="download-progress-fill"></div>
            </div>
            <p class="download-progress__text" id="download-progress-text" aria-live="polite"></p>
          </div>

          <!-- Modal de Previsualización (Opción 3: Ojito en Modal) -->
          <div class="preview-modal-overlay" id="preview-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-title" style="display: none;">
            <div class="preview-modal">
              <div class="preview-modal__header">
                <div class="preview-modal__header-left">
                  <div class="preview-modal__icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                  </div>
                  <div>
                    <h3 class="preview-modal__title" id="modal-title">Vista previa del archivo</h3>
                    <p class="preview-modal__subtitle" id="modal-subtitle">Estructura adaptada para AnyTone CPS</p>
                  </div>
                </div>
                <button type="button" class="preview-modal__close" id="btn-close-modal" aria-label="Cerrar ventana">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>

              <div class="preview-modal__body">
                <div class="preview-notice">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                  </svg>
                  <span>Muestra preliminar de las primeras columnas y registros según la selección activa.</span>
                </div>

                <div class="preview-table-container">
                  <table class="preview-table" id="preview-table">
                    <!-- Se llena dinámicamente con JavaScript -->
                  </table>
                </div>
              </div>

              <div class="preview-modal__footer">
                <button type="button" class="btn-modal-secondary" id="btn-modal-close-footer">Cerrar</button>
                <button type="button" class="btn-modal-primary" id="btn-modal-download">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                  </svg>
                  <span>Descargar Archivos</span>
                </button>
              </div>
            </div>
          </div>

        </div>

        <!-- Guía de Importación en CPS -->
        <div class="codeplug-guide-section">
          <h2 class="guide-section-title">Instrucciones de Importación en el CPS</h2>
          <p class="guide-section-desc">Sigue estos sencillos pasos para cargar los archivos descargados directamente en la memoria de tu radio.</p>

          <div class="guide-cards-grid">
            <!-- AnyTone -->
            <div class="guide-card">
              <div class="guide-card__header">
                <h3 class="guide-card__title">AnyTone (D878 / D578)</h3>
              </div>
              <ul class="guide-card__steps">
                <li>Abre el software <strong>AnyTone CPS</strong> y conecta tu equipo.</li>
                <li>Ve al menú superior <strong>Tool → Import</strong>.</li>
                <li>Selecciona <strong>TalkGroups</strong> e importa <code>TalkGroups.csv</code>.</li>
                <li>Selecciona <strong>Digital Contact List</strong> e importa <code>DigitalContactList.csv</code>.</li>
                <li>Haz clic en <strong>Write to Radio</strong> para transferir la programación.</li>
              </ul>
            </div>

            <!-- OpenGD77 / Baofeng DM-32UV / DM-1701 / Retevis RT3S -->
            <div class="guide-card">
              <div class="guide-card__header">
                <h3 class="guide-card__title">OpenGD77 (DM-32UV / DM-1701 / RT3S / UV380)</h3>
              </div>
              <ul class="guide-card__steps">
                <li>Conecta tu radio por USB y abre <strong>OpenGD77 CPS</strong>.</li>
                <li><strong>Cargar Talkgroups:</strong> En el árbol lateral ve a <strong>Contacts</strong>, presiona <strong>CSV Import</strong> y selecciona <code>OpenGD77_Talkgroups.csv</code>.</li>
                <li><strong>Cargar Libreta de Indicativos (DMR ID):</strong> Ve al menú superior <strong>DMR ID</strong> (o Radio ID Database), presiona <strong>Import CSV</strong> y selecciona <code>OpenGD77_DMRID_Database.csv</code>.</li>
                <li><strong>Escribir al radio:</strong> Haz clic en <strong>Write Codeplug</strong> (canales) y luego en <strong>Write DMR ID</strong> (pantalla).</li>
              </ul>
            </div>

            <!-- TYT MD-380 / Retevis -->
            <div class="guide-card">
              <div class="guide-card__header">
                <h3 class="guide-card__title">TYT / Retevis (MD-380 / RT3)</h3>
              </div>
              <ul class="guide-card__steps">
                <li>Abre el <strong>CPS oficial de TYT o Retevis</strong>.</li>
                <li>Selecciona <strong>Contacts → Digital Contacts</strong>.</li>
                <li>Usa la opción de importación masiva CSV y elige <code>TYT_MD380_Contacts.csv</code>.</li>
                <li>Guarda una copia de seguridad (<code>.rdx</code>) de tu codeplug original.</li>
                <li>Transfiere la nueva libreta a tu radio con <strong>Write Data</strong>.</li>
              </ul>
            </div>
          </div>

          <!-- Nota Aclaratoria sobre Marcas y Protocolos -->
          <div class="brands-protocol-notice">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <div>
              <strong>¿Por qué no están Icom o Yaesu en los formatos nativos?</strong>
              <br />
              Los equipos de <strong>Yaesu</strong> utilizan el protocolo <strong>System Fusion (C4FM/WIRES-X)</strong> y los de <strong>Icom</strong> operan bajo <strong>D-STAR (o IDAS)</strong>, por lo que no emplean codeplugs DMR de forma nativa. Si deseas consultar o cargar estas frecuencias y contactos como canales analógicos o listas de referencia en radios Yaesu, Icom o Kenwood, utiliza la opción <strong>Universal / Excel</strong> para exportar todos los datos a una planilla de cálculo.
            </div>
          </div>
        </div>

      </div>
    </section>
  </main>
</Layout>

<script>
  import {
    cargarManifest,
    cargarContactos,
    generarArchivo,
    guardarArchivo,
    filtrarTalkgroups,
    type Alcance,
    type Manifest,
    type Modelo,
    type Tipo,
    type TgOptionMode,
    OPCIONES_PERSONALIZADAS,
    TALKGROUPS,
  } from '../scripts/codeplug';

  // Metadatos explicativos por modelo de radio
  const modelMeta: Record<Modelo, { title: string; desc: string; format: string }> = {
    anytone: {
      title: 'AnyTone & BTECH / Alinco',
      desc: 'Compatible con AnyTone AT-D878UV (I/II Plus), AT-D578UV, BTECH DMR-6X2 y Alinco DJ-MD5.',
      format: 'TalkGroups.csv + DigitalContactList.csv (Pack ZIP)'
    },
    opengd77: {
      title: 'OpenGD77 / OpenUV380 (Firmware Libre)',
      desc: 'Compatible con Baofeng DM-32UV, DM-1701, RT3S, TYT MD-UV380/390, MD-9600 y Radioddity GD-77 con OpenGD77.',
      format: 'OpenGD77_Talkgroups.csv + OpenGD77_DMRID_Database.csv (Pack ZIP)'
    },
    baofeng: {
      title: 'Baofeng (CPS Oficial de Fábrica)',
      desc: 'Compatible con el software original de Baofeng para DM-32UV, DM-1701, DM-1801 y RD-5R sin OpenGD77.',
      format: 'Pack ZIP: Contacts.csv + DMR ID Database'
    },
    tyt: {
      title: 'TYT & Retevis (CPS Oficial de Fábrica)',
      desc: 'Compatible con Retevis RT3S, RT3, RT82, RT84, TYT MD-UV380, MD-UV390, MD-9600 y MD-380.',
      format: 'Contact.csv (Nombre de contacto máx. 16 caracteres)'
    },
    radioddity: {
      title: 'Radioddity CPS',
      desc: 'Compatible con Radioddity GD-77 (CPS original de fábrica) y DB25-D.',
      format: 'DigitalContacts.csv'
    },
    motorola: {
      title: 'Motorola MOTOTRBO',
      desc: 'Compatible con MOTOTRBO Serie DGP (8550/5550), DGM, DP y Serie XPR.',
      format: 'Contacts.csv (Group Call / Private Call)'
    },
    universal: {
      title: 'Universal / Planillas de Cálculo',
      desc: 'Formato estándar compatible con Chirp, Excel, LibreOffice Calc y respaldos generales.',
      format: 'CSV Completo con todos los atributos DMR'
    }
  };

  const scopeNames: Record<string, string> = {
    venezuela: 'Venezuela (MCC 734)',
    latam: 'Iberoamérica / Latam',
    global: 'Mundial Completo'
  };

  // Estado del generador
  let currentModel: Modelo = 'anytone';
  let currentType: Tipo = 'all';
  let currentScope: Alcance = 'venezuela';
  let currentTgMode: TgOptionMode = 'oficiales';
  let currentCustomIds: string[] = OPCIONES_PERSONALIZADAS
    .filter(o => o.categoria === 'Venezuela' || o.categoria.includes('Circuitos'))
    .map(o => o.id);
  let manifest: Manifest | null = null;

  // Elementos DOM: Paso 1 (Select Grueso)
  const selectModel = document.getElementById('select-model') as HTMLSelectElement | null;
  const modelBoxTitle = document.getElementById('model-box-title');
  const modelBoxDesc = document.getElementById('model-box-desc');
  const modelBoxFormat = document.getElementById('model-box-format');

  // Elementos DOM: Paso 2 (Selects)
  const selectContentType = document.getElementById('select-content-type') as HTMLSelectElement | null;
  const selectTgFilter = document.getElementById('select-tg-filter') as HTMLSelectElement | null;
  const selectScope = document.getElementById('select-scope') as HTMLSelectElement | null;

  const cardTalkgroupsConfig = document.getElementById('card-talkgroups-config');
  const cardContactsConfig = document.getElementById('card-contacts-config');

  const customTgsWrapper = document.getElementById('custom-tgs-wrapper');
  const customTgCheckboxes = document.querySelectorAll('.custom-tg-checkbox') as NodeListOf<HTMLInputElement>;
  const customTgsCounter = document.getElementById('custom-tgs-counter');
  const btnTgSelectAll = document.getElementById('btn-tg-select-all');
  const btnTgSelectVzla = document.getElementById('btn-tg-select-vzla');
  const btnTgDeselectAll = document.getElementById('btn-tg-deselect-all');

  const typeHint = document.getElementById('type-hint');
  const tgHint = document.getElementById('tg-hint');
  const scopeHint = document.getElementById('scope-hint');

  // Elementos DOM: Descarga y Resumen
  const downloadBtn = document.getElementById('btn-download') as HTMLButtonElement | null;
  const summaryTitle = document.getElementById('summary-title');
  const summaryDesc = document.getElementById('summary-desc');

  // Elementos DOM: Modal de Previsualización (Opción 3)
  const btnTogglePreview = document.getElementById('btn-toggle-preview');
  const previewModalOverlay = document.getElementById('preview-modal-overlay');
  const btnCloseModal = document.getElementById('btn-close-modal');
  const btnModalCloseFooter = document.getElementById('btn-modal-close-footer');
  const btnModalDownload = document.getElementById('btn-modal-download');
  const modalSubtitle = document.getElementById('modal-subtitle');
  const previewTable = document.getElementById('preview-table');

  const numero = (n: number) => n.toLocaleString('es-VE');
  const megas = (bytes: number) =>
    bytes < 1024 * 1024 ? `${Math.max(1, Math.round(bytes / 1024))} KB` : `${(bytes / 1048576).toFixed(1).replace('.', ',')} MB`;

  function getActiveTalkgroups() {
    return filtrarTalkgroups(currentTgMode, currentCustomIds);
  }

  // 1. Selector Grueso de Modelo de Radio
  selectModel?.addEventListener('change', () => {
    currentModel = (selectModel.value as Modelo) || 'anytone';
    const meta = modelMeta[currentModel] || modelMeta.anytone;
    if (modelBoxTitle) modelBoxTitle.textContent = meta.title;
    if (modelBoxDesc) modelBoxDesc.textContent = meta.desc;
    if (modelBoxFormat) modelBoxFormat.textContent = meta.format;
    updateState();
  });

  // 2. Select: Tipo de Contenido
  selectContentType?.addEventListener('change', () => {
    currentType = (selectContentType.value as Tipo) || 'all';
    if (currentType === 'all') {
      cardTalkgroupsConfig?.classList.remove('is-disabled');
      cardContactsConfig?.classList.remove('is-disabled');
      if (typeHint) typeHint.textContent = 'Generará tanto los canales digitales (Talkgroups) como la libreta para identificar llamadas.';
    } else if (currentType === 'talkgroups') {
      cardTalkgroupsConfig?.classList.remove('is-disabled');
      cardContactsConfig?.classList.add('is-disabled');
      if (typeHint) typeHint.textContent = 'Solo generará los canales de voz digitales (TGs) para tu radio.';
    } else if (currentType === 'contacts') {
      cardTalkgroupsConfig?.classList.add('is-disabled');
      cardContactsConfig?.classList.remove('is-disabled');
      if (typeHint) typeHint.textContent = 'Solo descargará la libreta de contactos RadioID (indicativos y nombres).';
    }
    updateState();
  });

  // 3. Select: Opciones de Talkgroups (Oficiales, Globales, Personalizado)
  selectTgFilter?.addEventListener('change', () => {
    currentTgMode = (selectTgFilter.value as TgOptionMode) || 'oficiales';
    if (currentTgMode === 'personalizado') {
      if (customTgsWrapper) customTgsWrapper.style.display = 'block';
    } else {
      if (customTgsWrapper) customTgsWrapper.style.display = 'none';
    }
    updateState();
  });

  // Checklist de Personalizado
  function syncCheckboxes() {
    customTgCheckboxes.forEach((cb) => {
      cb.checked = currentCustomIds.includes(cb.value);
      const card = cb.closest('.custom-tg-card');
      if (card) {
        card.classList.toggle('is-checked', cb.checked);
      }
    });
  }

  function readCheckboxes() {
    const seleccionados: string[] = [];
    customTgCheckboxes.forEach((cb) => {
      const card = cb.closest('.custom-tg-card');
      if (cb.checked) {
        seleccionados.push(cb.value);
        if (card) card.classList.add('is-checked');
      } else {
        if (card) card.classList.remove('is-checked');
      }
    });
    currentCustomIds = seleccionados;
    updateState();
  }

  customTgCheckboxes.forEach((cb) => {
    cb.addEventListener('change', readCheckboxes);
  });

  btnTgSelectAll?.addEventListener('click', () => {
    currentCustomIds = OPCIONES_PERSONALIZADAS.map(o => o.id);
    syncCheckboxes();
    updateState();
  });

  btnTgSelectVzla?.addEventListener('click', () => {
    currentCustomIds = OPCIONES_PERSONALIZADAS
      .filter(o => o.categoria === 'Venezuela' || o.categoria.includes('Circuitos'))
      .map(o => o.id);
    syncCheckboxes();
    updateState();
  });

  btnTgDeselectAll?.addEventListener('click', () => {
    currentCustomIds = [];
    syncCheckboxes();
    updateState();
  });

  // 4. Select: Alcance de Contactos
  selectScope?.addEventListener('change', () => {
    currentScope = (selectScope.value as Alcance) || 'venezuela';
    updateState();
  });

  function updateState() {
    const selectedTgs = getActiveTalkgroups();

    // Actualizar hints
    if (tgHint) {
      if (currentTgMode === 'oficiales') {
        tgHint.textContent = `TGs Oficiales de Venezuela (${selectedTgs.length} TGs: Troncales Nacionales + 9 Circuitos Regionales).`;
      } else if (currentTgMode === 'globales') {
        tgHint.textContent = `TGs Globales (${selectedTgs.length} TGs: Venezuela + América Latina + Enlaces Mundiales).`;
      } else {
        tgHint.textContent = `Selección Personalizada: ${selectedTgs.length} canales Talkgroups configurados.`;
      }
    }

    if (customTgsCounter) {
      customTgsCounter.textContent = `Total seleccionados: ${selectedTgs.length} TGs`;
    }

    if (scopeHint && manifest) {
      const info = manifest.alcances[currentScope];
      if (info) {
        scopeHint.textContent = `${numero(info.registros)} indicativos (${megas(info.bytes)}) sincronizados desde RadioID.`;
      }
    }

    // Actualizar resumen
    if (summaryTitle) {
      const typeLabel = currentType === 'all' ? 'Pack Completo' : currentType === 'talkgroups' ? 'Solo Talkgroups' : 'Directorio de Contactos';
      const meta = modelMeta[currentModel] || modelMeta.anytone;
      summaryTitle.textContent = `${meta.title} · ${typeLabel}`;
    }

    if (summaryDesc) {
      const scopeText = scopeNames[currentScope] || 'Venezuela';
      const meta = modelMeta[currentModel] || modelMeta.anytone;
      let desc = '';
      if (currentType === 'all') {
        desc = `Generará archivo ZIP para ${meta.title} con ${selectedTgs.length} Talkgroups y contactos de ${scopeText}.`;
      } else if (currentType === 'talkgroups') {
        desc = `Generará archivo CSV con ${selectedTgs.length} canales (Talkgroups) adaptados al formato de ${meta.title}.`;
      } else {
        desc = `Generará archivo CSV con la libreta de contactos RadioID (${scopeText}) para ${meta.title}.`;
      }

      const info = manifest?.alcances[currentScope];
      if (info && currentType !== 'talkgroups') {
        desc += ` Se descargarán ${numero(info.registros)} contactos (${megas(info.bytes)}) directamente en tu dispositivo.`;
      }
      summaryDesc.textContent = desc;
    }

    // Actualizar subtítulo en el modal
    if (modalSubtitle) {
      const meta = modelMeta[currentModel] || modelMeta.anytone;
      modalSubtitle.textContent = `Estructura adaptada para ${meta.title} (${selectedTgs.length} TGs)`;
    }
  }

  // 5. Modal de Previsualización (Opción 3)
  function openModal() {
    renderPreview();
    if (previewModalOverlay) {
      previewModalOverlay.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
  }

  function closeModal() {
    if (previewModalOverlay) {
      previewModalOverlay.style.display = 'none';
      document.body.style.overflow = '';
    }
  }

  btnTogglePreview?.addEventListener('click', openModal);
  btnCloseModal?.addEventListener('click', closeModal);
  btnModalCloseFooter?.addEventListener('click', closeModal);

  previewModalOverlay?.addEventListener('click', (e) => {
    if (e.target === previewModalOverlay) {
      closeModal();
    }
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && previewModalOverlay?.style.display === 'flex') {
      closeModal();
    }
  });

  btnModalDownload?.addEventListener('click', () => {
    closeModal();
    downloadBtn?.click();
  });

  function renderPreview() {
    if (!previewTable) return;
    const selectedTgs = getActiveTalkgroups();

    let headers: string[] = [];
    let rows: string[][] = [];

    if (currentModel === 'anytone') {
      headers = ['No.', 'Radio ID', 'Callsign', 'Name', 'City', 'State', 'Country', 'Call Type', 'Call Alert'];
      if (currentType !== 'contacts') {
        selectedTgs.slice(0, 5).forEach((tg, idx) => {
          rows.push([
            String(idx + 1),
            tg.tg,
            tg.name.slice(0, 16),
            tg.notes || tg.name,
            tg.city,
            tg.state,
            tg.country,
            'Group Call',
            'None'
          ]);
        });
      }
      if (currentType !== 'talkgroups') {
        rows.push(['6', '734001', 'YV5OF', 'Sysop BM-YV', 'Caracas', 'Miranda', 'Venezuela', 'Private Call', 'None']);
        rows.push(['7', '7341003', 'YV5VE', 'William Fourneau', 'Altagracia', 'Guárico', 'Venezuela', 'Private Call', 'None']);
      }
    } else if (currentModel === 'opengd77' || currentModel === 'baofeng') {
      headers = ['Contact Name (OpenGD77)', 'ID', 'Type', 'Timeslot'];
      if (currentType !== 'contacts') {
        selectedTgs.slice(0, 5).forEach((tg) => {
          rows.push([tg.name, tg.tg, 'Group Call', `TS${tg.slot}`]);
        });
      }
      if (currentType !== 'talkgroups') {
        rows.push(['YV5OF Sysop', '734001', 'Private Call', 'TS1']);
        rows.push(['YV5VE William', '7341003', 'Private Call', 'TS1']);
      }
    } else if (currentModel === 'tyt') {
      headers = ['Contact Name (máx 16 chars)', 'Call Type', 'Call ID', 'Call Receive Tone'];
      if (currentType !== 'contacts') {
        selectedTgs.slice(0, 5).forEach((tg) => {
          rows.push([tg.name.slice(0, 16), 'Group Call', tg.tg, 'No']);
        });
      }
      if (currentType !== 'talkgroups') {
        rows.push(['YV5OF Sysop', 'Private Call', '734001', 'No']);
        rows.push(['YV5VE William', 'Private Call', '7341003', 'No']);
      }
    } else if (currentModel === 'radioddity') {
      headers = ['Name', 'City/Callsign', 'Call ID', 'Call Type'];
      if (currentType !== 'contacts') {
        selectedTgs.slice(0, 5).forEach((tg) => {
          rows.push([tg.name.slice(0, 16), tg.city, tg.tg, 'Group Call']);
        });
      }
      if (currentType !== 'talkgroups') {
        rows.push(['William Fourneau', 'YV5VE', '7341003', 'Private Call']);
      }
    } else if (currentModel === 'motorola') {
      headers = ['Call Type', 'Call Name', 'Call ID'];
      if (currentType !== 'contacts') {
        selectedTgs.slice(0, 5).forEach((tg) => {
          rows.push(['Group Call', tg.name.slice(0, 16), tg.tg]);
        });
      }
      if (currentType !== 'talkgroups') {
        rows.push(['Private Call', 'YV5VE William', '7341003']);
      }
    } else {
      headers = ['Indice', 'Tipo', 'ID / Talkgroup', 'Indicativo', 'Nombre', 'Ciudad', 'Estado', 'País', 'Ranura', 'Notas'];
      if (currentType !== 'contacts') {
        selectedTgs.slice(0, 5).forEach((tg, idx) => {
          rows.push([String(idx + 1), 'Talkgroup', tg.tg, tg.name, tg.notes, tg.city, tg.state, tg.country, `Slot ${tg.slot}`, 'BM-YV']);
        });
      }
      if (currentType !== 'talkgroups') {
        rows.push(['6', 'Contacto', '7341003', 'YV5VE', 'William Fourneau', 'Altagracia', 'Guárico', 'Venezuela', 'Slot 1/2', 'RadioID']);
      }
    }

    let html = '<thead><tr>';
    headers.forEach(h => {
      html += `<th>${h}</th>`;
    });
    html += '</tr></thead><tbody>';

    rows.forEach(r => {
      html += '<tr>';
      r.forEach(col => {
        html += `<td>${col}</td>`;
      });
      html += '</tr>';
    });
    html += '</tbody>';

    previewTable.innerHTML = html;
  }

  // 6. Descarga y Generación
  const progreso = document.getElementById('download-progress');
  const progresoBarra = document.getElementById('download-progress-bar');
  const progresoRelleno = document.getElementById('download-progress-fill');
  const progresoTexto = document.getElementById('download-progress-text');

  function mostrarProgreso(porcentaje: number | null, texto: string, esError = false) {
    if (!progreso || !progresoRelleno || !progresoTexto || !progresoBarra) return;
    progreso.hidden = false;
    progreso.classList.toggle('is-error', esError);
    progreso.classList.toggle('is-indeterminate', porcentaje === null);
    const valor = porcentaje ?? 100;
    progresoRelleno.style.width = `${valor}%`;
    progresoBarra.setAttribute('aria-valuenow', String(Math.round(valor)));
    progresoTexto.textContent = texto;
  }

  let generando = false;
  downloadBtn?.addEventListener('click', async () => {
    if (generando) return;
    generando = true;
    const etiqueta = downloadBtn.querySelector('span');
    const textoOriginal = etiqueta?.textContent ?? 'Descargar Archivos';
    downloadBtn.disabled = true;
    if (etiqueta) etiqueta.textContent = 'Preparando…';

    try {
      const selectedTgs = getActiveTalkgroups();
      let contactos: Awaited<ReturnType<typeof cargarContactos>> = [];
      if (currentType !== 'talkgroups') {
        mostrarProgreso(0, 'Conectando con el directorio de RadioID…');
        contactos = await cargarContactos(currentScope, (recibidos, total) => {
          const pct = total ? (recibidos / total) * 100 : 0;
          mostrarProgreso(pct, `Descargando contactos… ${Math.round(pct)} % (${megas(recibidos)} de ${megas(total)})`);
        });
      }
      mostrarProgreso(null, 'Generando el archivo para tu radio…');
      await new Promise((r) => setTimeout(r, 30));
      const { nombre, blob } = generarArchivo(
        currentModel,
        currentType,
        currentScope,
        contactos,
        selectedTgs
      );
      guardarArchivo(blob, nombre);
      mostrarProgreso(100, `Listo: ${nombre} (${megas(blob.size)}).`);

      // Estadística del Escritorio
      fetch('/api/analytics.php?action=track', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          event_type: 'codeplug_download',
          event_category: currentModel,
          entity_id: currentScope,
          entity_title: currentType,
          metadata: { contactos: contactos.length, tgs: selectedTgs.length, modo_tg: currentTgMode },
        }),
        keepalive: true,
      }).catch(() => {});
    } catch (err) {
      mostrarProgreso(
        100,
        `No se pudo generar el archivo: ${(err as Error).message} Revisa tu conexión e inténtalo de nuevo.`,
        true
      );
    } finally {
      generando = false;
      downloadBtn.disabled = false;
      if (etiqueta) etiqueta.textContent = textoOriginal;
    }
  });

  // Cargar manifest
  cargarManifest()
    .then((m) => {
      manifest = m;
      const meta = document.getElementById('summary-meta');
      if (meta) {
        const fecha = new Date(m.actualizado).toLocaleDateString('es-VE', { day: 'numeric', month: 'long', year: 'numeric' });
        meta.textContent = `Contactos de RadioID actualizados el ${fecha}.`;
      }
      updateState();
    })
    .catch(() => {
      /* Sin índice se puede seguir */
    });

  // Inicializar estado
  updateState();
</script>
