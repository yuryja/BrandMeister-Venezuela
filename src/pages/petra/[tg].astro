---
import Layout from '../../layouts/Layout.astro';
import PetraDashboard from '../../components/petra/PetraDashboard.astro';
import { PETRA_TALKGROUPS, type PetraTalkgroup } from '../../lib/petra';

export function getStaticPaths() {
  return PETRA_TALKGROUPS.map((talkgroup) => ({ params: { tg: talkgroup.id }, props: { talkgroup } }));
}

interface Props {
  talkgroup: PetraTalkgroup;
}

const { talkgroup } = Astro.props;
---

<Layout
  title={`Petra · TG ${talkgroup.id} ${talkgroup.name} · BrandMeister Venezuela`}
  description={`Actividad en vivo del TG ${talkgroup.id} (${talkgroup.name}) en BrandMeister Venezuela: último escuchado, transmisiones, operadores y estadísticas de Petra.`}
>
  <PetraDashboard talkgroup={talkgroup} />
</Layout>
