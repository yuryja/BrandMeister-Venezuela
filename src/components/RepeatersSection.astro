---
const repeaters = [
  {
    id: "734500",
    callsign: "YV5DMR",
    location: "Caracas, Distrito Capital",
    band: "VHF",
    freqRx: "147.840 MHz",
    freqTx: "147.240 MHz",
    offset: "+0.600 MHz",
    status: "Activo",
    type: "Repetidor Oficial",
    notes: "Pionero en Venezuela desde 2010. Cobertura en la Gran Caracas y valles del Tuy."
  },
  {
    id: "734014",
    callsign: "YV5VE",
    location: "Caracas, Distrito Capital",
    band: "UHF",
    freqRx: "434.600 MHz",
    freqTx: "439.600 MHz",
    offset: "-5.000 MHz",
    status: "Activo",
    type: "Repetidor Oficial",
    notes: "Enlace UHF de alta penetración urbana en el área metropolitana."
  },
  {
