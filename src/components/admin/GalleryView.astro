---
// Galería multimedia en el panel: listado, subida y edición de publicaciones.
// Lógica en src/scripts/admin/gallery.ts y optimización de medios en src/scripts/admin/media.ts
---

<!-- ========================================================= -->
<!-- GALERÍA: LISTADO -->
<!-- ========================================================= -->
<section id="view-gallery" class="wp-view">
  <div class="view-header">
    <h1 class="view-title">
      Galería
      <button type="button" class="btn btn-secondary btn-sm page-title-action" data-view="gallery-edit">Añadir publicación</button>
    </h1>
  </div>

  <div id="gallery-notice"></div>

  <ul class="wp-subsubsub" id="gallery-status-filter">
    <li><a href="#" data-gallery-filter="all" class="is-current">Todas <span class="count" data-count="all">(0)</span></a></li>
    <li><a href="#" data-gallery-filter="published">Visibles <span class="count" data-count="published">(0)</span></a></li>
    <li><a href="#" data-gallery-filter="hidden">Ocultas <span class="count" data-count="hidden">(0)</span></a></li>
  </ul>

  <div class="table-container">
    <table class="wp-list-table gallery-table">
      <thead>
        <tr>
          <th class="col-thumb">Medio</th>
          <th>Publicación</th>
          <th>Autor</th>
          <th>Fecha</th>
        </tr>
      </thead>
      <tbody id="gallery-table-body">
        <tr><td colspan="4" class="table-empty">Cargando publicaciones…</td></tr>
      </tbody>
    </table>
  </div>
</section>

<!-- ========================================================= -->
<!-- GALERÍA: AÑADIR / EDITAR -->
<!-- ========================================================= -->
<section id="view-gallery-edit" class="wp-view">
  <div class="view-header">
    <h1 class="view-title" id="gallery-edit-title">Añadir publicación</h1>
  </div>

  <div id="gallery-edit-notice"></div>

  <form id="gallery-form" class="gallery-edit-layout" novalidate>
    <input type="hidden" name="id" />

    <div class="gallery-edit-main">
      <!-- Medios -->
      <div class="wp-box">
        <div class="wp-box-head">
          <h3>Fotos o video</h3>
          <span class="field-hint" id="gallery-media-summary"></span>
        </div>
        <div class="wp-box-body">
          <label class="drop-zone" id="gallery-drop-zone" for="gallery-file-input">
            <input type="file" id="gallery-file-input" accept="image/*,video/*" multiple class="screen-reader-text" />
            <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            <strong>Arrastra aquí tus fotos o un video</strong>
            <span>o haz clic para elegirlos · varias fotos forman un carrusel</span>
            <span class="drop-zone-rules">Fotos: JPG, PNG, HEIC o WebP → WebP de hasta 1500×1500 · Video: MP4, MOV o WebM de hasta 5 min → comprimido a 1080p</span>
          </label>

          <p class="field-hint" id="gallery-current-media-hint" hidden>
            Publicación actual abajo. Si añades archivos nuevos, <strong>reemplazarán</strong> a los actuales al guardar.
          </p>

          <ul class="media-grid" id="gallery-media-list" aria-live="polite"></ul>
        </div>
      </div>

      <!-- Texto -->
      <div class="wp-box">
        <div class="wp-box-head"><h3>Descripción</h3></div>
        <div class="wp-box-body">
          <div class="form-group">
            <label for="gf-caption" class="screen-reader-text">Descripción</label>
            <textarea id="gf-caption" name="caption" class="form-input" rows="5" maxlength="2200" placeholder="Cuenta qué se ve: lugar, indicativos, equipo, actividad…"></textarea>
            <span class="field-hint"><span id="gf-caption-count">0</span> / 2200 · Los #hashtags y @menciones se resaltan en la galería.</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Lateral: publicar -->
    <aside class="gallery-edit-side">
      <div class="wp-box">
        <div class="wp-box-head"><h3>Publicar</h3></div>
        <div class="wp-box-body">
          <div class="form-group">
            <label for="gf-status">Estado</label>
            <select id="gf-status" name="status" class="form-input">
              <option value="published">Visible en la galería</option>
              <option value="hidden">Oculta</option>
            </select>
          </div>
          <div class="form-group">
            <label for="gf-date">Fecha</label>
            <input type="date" id="gf-date" name="published_date" class="form-input" />
          </div>
          <div class="form-group">
            <label for="gf-author">Autor</label>
            <input type="text" id="gf-author" name="author" class="form-input" maxlength="80" />
          </div>
          <div class="form-group">
            <label for="gf-permalink">Enlace externo (opcional)</label>
            <input type="url" id="gf-permalink" name="permalink" class="form-input" placeholder="https://www.instagram.com/p/…" />
            <span class="field-hint">Si la publicación también está en redes, muestra el botón "Ver original".</span>
          </div>

          <div class="upload-progress" id="gallery-progress" hidden>
            <div class="upload-progress-bar"><span id="gallery-progress-bar"></span></div>
            <span class="field-hint" id="gallery-progress-label"></span>
          </div>

          <div class="metabox-actions">
            <button type="button" class="btn btn-secondary btn-sm" id="gallery-cancel">Cancelar</button>
            <button type="submit" class="btn btn-primary" id="gallery-submit">Publicar</button>
          </div>
        </div>
      </div>
    </aside>
  </form>
</section>
