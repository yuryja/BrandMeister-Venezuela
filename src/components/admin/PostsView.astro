---
// Noticias del panel: listado con filtros y editor. Lógica en src/scripts/admin/posts.ts
---

<!-- ========================================================= -->
<!-- NOTICIAS: LISTADO -->
<!-- ========================================================= -->
<section id="view-posts" class="wp-view">
  <div class="view-header">
    <h1 class="view-title">
      Noticias
      <button type="button" class="btn btn-secondary btn-sm page-title-action" data-view="new-post">Añadir nueva</button>
    </h1>
  </div>

  <div id="posts-notice"></div>

  <ul class="wp-subsubsub" id="posts-status-filter">
    <li><a href="#" data-post-filter="all" class="is-current">Todas <span class="count" data-count="all">(0)</span></a></li>
    <li><a href="#" data-post-filter="published">Publicadas <span class="count" data-count="published">(0)</span></a></li>
    <li><a href="#" data-post-filter="draft">Borradores <span class="count" data-count="draft">(0)</span></a></li>
    <li><a href="#" data-post-filter="trash">Papelera <span class="count" data-count="trash">(0)</span></a></li>
  </ul>

  <div class="wp-table-toolbar">
    <div class="toolbar-left">
      <label class="screen-reader-text" for="posts-bulk-action">Acciones en lote</label>
      <select id="posts-bulk-action" class="form-input select-bulk">
        <option value="">Acciones en lote</option>
        <option value="publish">Publicar</option>
        <option value="draft">Pasar a borrador</option>
        <option value="trash">Mover a la papelera</option>
        <option value="restore">Restaurar</option>
        <option value="delete">Eliminar definitivamente</option>
      </select>
      <button type="button" id="posts-bulk-apply" class="btn btn-secondary btn-sm">Aplicar</button>
    </div>
    <div class="toolbar-right">
      <label class="screen-reader-text" for="posts-search">Buscar noticias</label>
      <input type="search" id="posts-search" class="form-input select-filter" placeholder="Buscar por título, resumen o etiqueta…" />
      <span class="items-count" id="posts-count">0 elementos</span>
    </div>
  </div>

  <div class="table-container">
    <table class="wp-list-table posts-table">
      <thead>
        <tr>
          <th class="col-cb"><input type="checkbox" id="posts-select-all" aria-label="Seleccionar todas" /></th>
          <th>Título</th>
          <th>Autor</th>
          <th>Categoría</th>
          <th>Etiquetas</th>
          <th class="col-num">Lecturas</th>
          <th>Fecha</th>
        </tr>
      </thead>
      <tbody id="posts-table-body">
        <tr><td colspan="7" class="table-empty">Cargando noticias…</td></tr>
      </tbody>
    </table>
  </div>
</section>

<!-- ========================================================= -->
<!-- NOTICIAS: AÑADIR / EDITAR -->
<!-- ========================================================= -->
<section id="view-new-post" class="wp-view">
  <div class="view-header">
    <h1 class="view-title" id="post-form-title">Añadir nueva noticia</h1>
  </div>

  <div id="post-form-notice"></div>

  <form id="post-form" class="wp-editor-layout" novalidate>
    <input type="hidden" name="id" />

    <div class="editor-main-col">
      <div class="form-group">
        <label for="pf-title" class="screen-reader-text">Título</label>
        <input type="text" id="pf-title" name="title" class="form-input wp-title-input" placeholder="Título de la noticia" maxlength="255" required />
      </div>

      <div class="slug-permalink-bar">
        <span>Enlace:</span>
        <code>/blog/<input type="text" id="pf-slug" name="slug" class="slug-inline-input" placeholder="se-genera-solo" maxlength="180" /></code>
        <a href="#" id="pf-view-link" target="_blank" rel="noopener" hidden>Ver ↗</a>
      </div>

      <div class="form-group">
        <label for="pf-description">Resumen</label>
        <textarea id="pf-description" name="description" class="form-input" rows="2" maxlength="500" placeholder="Una o dos frases: es lo que se lee en el listado y en Google." required></textarea>
        <span class="field-hint"><span id="pf-description-count">0</span> / 500</span>
      </div>

      <div class="wp-editor-toolbar" role="toolbar" aria-label="Formato del texto">
        <button type="button" class="wp-tool-btn" data-md="bold" title="Negrita"><strong>B</strong></button>
        <button type="button" class="wp-tool-btn" data-md="italic" title="Cursiva"><em>I</em></button>
        <button type="button" class="wp-tool-btn" data-md="h2" title="Título de sección">H2</button>
        <button type="button" class="wp-tool-btn" data-md="h3" title="Subtítulo">H3</button>
        <button type="button" class="wp-tool-btn" data-md="ul" title="Lista con viñetas">• Lista</button>
        <button type="button" class="wp-tool-btn" data-md="ol" title="Lista numerada">1. Lista</button>
        <button type="button" class="wp-tool-btn" data-md="link" title="Enlace">🔗</button>
        <button type="button" class="wp-tool-btn" data-md="quote" title="Cita">❝</button>
        <button type="button" class="wp-tool-btn wp-tool-media" id="pf-insert-image" title="Insertar una imagen en el texto">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          Añadir imagen
        </button>
        <button type="button" class="wp-tool-btn" id="pf-preview-toggle" title="Vista previa">Vista previa</button>
      </div>

      <label for="pf-content" class="screen-reader-text">Contenido</label>
      <textarea id="pf-content" name="content" class="form-input wp-content-area" rows="20" placeholder="Escribe aquí la noticia. Puedes usar **negrita**, ## títulos, listas y [enlaces](https://…). Para una imagen, usa «Añadir imagen», arrástrala aquí o pégala con Ctrl+V." required></textarea>
      <div id="pf-preview" class="wp-live-preview-box" style="display: none;"></div>
      <span class="field-hint" id="pf-content-stats"></span>
    </div>

    <aside class="editor-sidebar-col">
      <div class="wp-box metabox">
        <div class="wp-box-head"><h4>Publicar</h4></div>
        <div class="wp-box-body">
          <div class="meta-setting-row">
            <span class="meta-label">Estado</span>
            <select id="pf-status" name="status" class="form-input select-sm">
              <option value="draft">Borrador</option>
              <option value="published">Publicada</option>
            </select>
          </div>
          <div class="meta-setting-row">
            <span class="meta-label">Fecha</span>
            <input type="date" id="pf-date" name="published_date" class="form-input select-sm" />
          </div>
          <div class="meta-setting-row">
            <span class="meta-label">Autor</span>
            <span id="pf-author">—</span>
          </div>
          <p class="field-hint" id="pf-author-hint" hidden>Como Autor puedes guardar borradores; un Editor los publica.</p>

          <div class="metabox-actions">
            <button type="button" class="btn btn-secondary btn-sm" data-view="posts">Cancelar</button>
            <button type="submit" class="btn btn-primary" id="post-submit">Guardar</button>
          </div>
        </div>
      </div>

      <div class="wp-box metabox">
        <div class="wp-box-head"><h4>Imagen destacada</h4></div>
        <div class="wp-box-body">
          <label class="drop-zone drop-zone-sm" id="pf-image-drop" for="pf-image-input">
            <input type="file" id="pf-image-input" accept="image/*" class="screen-reader-text" />
            <strong>Elegir imagen</strong>
            <span>o arrástrala aquí</span>
            <span class="drop-zone-rules">Se guarda en WebP muy comprimido, máximo 1920×1280.</span>
          </label>

          <figure class="featured-image-preview" id="pf-image-preview" hidden>
            <img id="pf-image-thumb" alt="Imagen destacada de la noticia" />
            <figcaption id="pf-image-info"></figcaption>
            <button type="button" class="btn btn-secondary btn-sm" id="pf-image-remove">Quitar imagen</button>
          </figure>
        </div>
      </div>

      <div class="wp-box metabox">
        <div class="wp-box-head"><h4>Categoría</h4></div>
        <div class="wp-box-body">
          <div class="checkbox-list" id="pf-categories"></div>
        </div>
      </div>

      <div class="wp-box metabox">
        <div class="wp-box-head"><h4>Etiquetas y destacado</h4></div>
        <div class="wp-box-body">
          <div class="form-group">
            <label for="pf-tags">Etiquetas</label>
            <input type="text" id="pf-tags" name="tags" class="form-input select-sm" placeholder="Petra, TG734, Tutorial" />
            <span class="field-hint">Separadas por comas, hasta 10.</span>
          </div>
          <div class="form-group">
            <label class="checkbox-inline">
              <input type="checkbox" id="pf-featured" name="featured" />
              Destacar en la portada
            </label>
          </div>
          <div class="form-group">
            <label for="pf-read-time">Tiempo de lectura</label>
            <input type="text" id="pf-read-time" name="read_time" class="form-input select-sm" placeholder="Se calcula solo" maxlength="40" />
          </div>
        </div>
      </div>
    </aside>
  </form>
</section>

<!-- ========================================================= -->
<!-- NOTICIAS: INSERTAR IMAGEN EN EL TEXTO (estilo "Añadir medio") -->
<!-- ========================================================= -->
<div id="modal-post-image" class="wp-modal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="modal-post-image-title">
  <div class="wp-modal-backdrop" data-close-modal></div>
  <div class="wp-modal-dialog wp-modal-media">
    <div class="wp-modal-header">
      <h3 id="modal-post-image-title">Insertar imagen</h3>
      <button type="button" class="btn-close-modal" data-close-modal aria-label="Cerrar">&times;</button>
    </div>
    <form id="post-image-form" novalidate>
      <div class="wp-modal-body">
        <div id="post-image-notice"></div>

        <!-- Paso 1: elegir la imagen -->
        <label class="drop-zone" id="pi-drop" for="pi-file">
          <input type="file" id="pi-file" accept="image/*" class="screen-reader-text" />
          <strong>Elegir imagen</strong>
          <span>o arrástrala aquí</span>
          <span class="drop-zone-rules">Se optimiza a WebP y cabe en 1600×1600 px. Horizontales y verticales.</span>
        </label>

        <!-- Paso 2: vista previa, progreso y datos de la imagen -->
        <div class="pi-details" id="pi-details" hidden>
          <figure class="pi-preview">
            <img id="pi-thumb" alt="" />
            <figcaption id="pi-status" aria-live="polite"></figcaption>
          </figure>
          <div class="pi-fields">
            <div class="form-group">
              <label for="pi-alt">Descripción de la imagen</label>
              <input type="text" id="pi-alt" class="form-input" maxlength="160" placeholder="Ej.: Antena del repetidor en el cerro El Ávila" />
              <span class="field-hint">La leen los lectores de pantalla y Google. Describe qué se ve.</span>
            </div>
            <div class="form-group">
              <label for="pi-caption">Pie de foto <span class="optional">(opcional)</span></label>
              <input type="text" id="pi-caption" class="form-input" maxlength="200" placeholder="Ej.: Instalación del repetidor, septiembre de 2026" />
            </div>
            <fieldset class="form-group pi-size">
              <legend>Tamaño</legend>
              <label class="radio-inline"><input type="radio" name="pi-size" value="completo" checked /> Ancho completo</label>
              <label class="radio-inline"><input type="radio" name="pi-size" value="mediana" /> Mediana, centrada</label>
            </fieldset>
            <button type="button" class="btn btn-secondary btn-sm" id="pi-change">Elegir otra imagen</button>
          </div>
        </div>
      </div>
      <div class="wp-modal-footer">
        <button type="button" class="btn btn-secondary" data-close-modal>Cancelar</button>
        <button type="submit" class="btn btn-primary" id="pi-insert" disabled>Insertar en la noticia</button>
      </div>
    </form>
  </div>
</div>
