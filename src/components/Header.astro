---
---

<div class="bm-stripe"></div>
<header class="site-header">
  <div class="container header-container">
    <a href="/" class="brand-link" aria-label="BrandMeister Venezuela - Inicio">
      <img
        src="/assets/logo.webp"
        alt="BrandMeister Venezuela"
        class="brand-logo"
        width="220"
        height="55"
      />
    </a>

    <nav class="nav-desktop" aria-label="Navegación principal">
      <ul class="nav-list">
        <li><a href="/" class="nav-link">Inicio</a></li>
        <li><a href="/comunidad" class="nav-link">Comunidad</a></li>
        <li><a href="/talkgroups" class="nav-link">Talkgroups</a></li>
        <li><a href="/repetidores" class="nav-link">Repetidores</a></li>
        <li>
          <a href="/petra" class="nav-link">
            Petra
          </a>
        </li>
        <li class="nav-dropdown-item">
          <button
            type="button"
            class="nav-link nav-dropdown-btn"
            id="exp-dropdown-btn"
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>Experiencia DMR</span>
            <svg class="dropdown-chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="nav-dropdown-menu" id="exp-dropdown-menu">
            <a href="/blog" class="dropdown-link">
              <div class="dropdown-link-icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                </svg>
              </div>
              <div class="dropdown-link-text">
                <span class="dropdown-link-title">Noticias</span>
                <span class="dropdown-link-desc">Artículos, guías y comunicados</span>
              </div>
            </a>
            <a href="/galeria" class="dropdown-link">
              <div class="dropdown-link-icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
              </div>
              <div class="dropdown-link-text">
                <span class="dropdown-link-title">Galería</span>
                <span class="dropdown-link-desc">Momentos y trabajo de campo</span>
              </div>
            </a>
          </div>
        </li>
        <li><a href="/contacto" class="nav-link">Contacto</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <button
        type="button"
        class="btn-hoseline btn-hoseline-native js-toggle-hoseline"
        title="Escuchar audio en vivo de BrandMeister TG 734"
      >
        <!-- Play icon (shown when idle) -->
        <svg class="icon-play" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
          <polygon points="6 4 20 12 6 20 6 4"></polygon>
        </svg>
        <!-- Pause icon (shown when active) -->
        <svg class="icon-pause" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
          <rect x="6" y="4" width="4" height="16" rx="1"></rect>
          <rect x="14" y="4" width="4" height="16" rx="1"></rect>
        </svg>
        <span class="btn-label">Audio en Vivo</span>
      </button>

      <button id="mobile-toggle" class="mobile-toggle" aria-label="Abrir menú" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-nav" class="mobile-nav" aria-hidden="true">
    <div class="mobile-nav-inner">
      <a href="/" class="mobile-nav-link">Inicio</a>
      <a href="/comunidad" class="mobile-nav-link">Comunidad</a>
      <a href="/talkgroups" class="mobile-nav-link">Talkgroups y Circuitos</a>
      <a href="/repetidores" class="mobile-nav-link">Repetidores Activos</a>
      <a href="/petra" class="mobile-nav-link">Petra</a>

      <!-- Experiencia DMR Mobile Accordion -->
      <div class="mobile-dropdown-group">
        <button type="button" class="mobile-dropdown-toggle" id="mobile-exp-toggle" aria-expanded="true">
          <span>Experiencia DMR</span>
          <svg class="mobile-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="mobile-dropdown-sublinks" id="mobile-exp-sublinks">
          <a href="/blog" class="mobile-sublink">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
            <span>Noticias</span>
          </a>
          <a href="/galeria" class="mobile-sublink">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
            <span>Galería</span>
          </a>
        </div>
      </div>

      <a href="/contacto" class="mobile-nav-link">Contacto y Redes</a>
      <button
        type="button"
        class="btn-hoseline btn-hoseline-native js-toggle-hoseline mobile-hoseline-btn"
      >
        <svg class="icon-play" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
          <polygon points="6 4 20 12 6 20 6 4"></polygon>
        </svg>
        <svg class="icon-pause" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
          <rect x="6" y="4" width="4" height="16" rx="1"></rect>
          <rect x="14" y="4" width="4" height="16" rx="1"></rect>
        </svg>
        <span class="btn-label">Audio en Vivo</span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-subtle);
    transition: all 0.25s ease;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 78px;
    gap: 1.25rem;
  }

  .brand-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand-logo {
    height: 52px;
    width: auto;
    object-fit: contain;
    transition: transform 0.2s ease;
  }

  .brand-logo:hover {
    transform: scale(1.02);
  }

  .nav-desktop {
    display: none;
  }

  @media (min-width: 1040px) {
    .nav-desktop {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    list-style: none;
  }

  .nav-link {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-muted);
    position: relative;
    padding: 0.35rem 0;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-link:hover {
    color: var(--bm-red);
  }

  /* Dropdown: Experiencia DMR */
  .nav-dropdown-item {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav-dropdown-btn {
    background: none;
    border: none;
    cursor: pointer;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-muted);
    padding: 0.35rem 0;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.18s ease;
  }

  .nav-dropdown-btn:hover,
  .nav-dropdown-item:hover .nav-dropdown-btn,
  .nav-dropdown-item:focus-within .nav-dropdown-btn,
  .nav-dropdown-btn.is-active {
    color: var(--bm-red);
  }

  .dropdown-chevron {
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    color: var(--bm-orange);
  }

  .nav-dropdown-item:hover .dropdown-chevron,
  .nav-dropdown-item:focus-within .dropdown-chevron,
  .nav-dropdown-btn.is-active .dropdown-chevron {
    transform: rotate(180deg);
  }

  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1.5px solid rgba(238, 108, 31, 0.22);
    border-radius: 14px;
    box-shadow: 0 16px 36px -8px rgba(15, 23, 42, 0.12),
                0 4px 14px -2px rgba(238, 108, 31, 0.08);
    padding: 0.45rem;
    min-width: 250px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.2s;
    z-index: 150;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  /* Invisible hover bridge to prevent mouse leaving panel */
  .nav-dropdown-menu::before {
    content: '';
    position: absolute;
    top: -14px;
    left: 0;
    right: 0;
    height: 14px;
  }

  .nav-dropdown-item:hover .nav-dropdown-menu,
  .nav-dropdown-item:focus-within .nav-dropdown-menu,
  .nav-dropdown-menu.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.85rem;
    border-radius: 10px;
    text-decoration: none;
    transition: background-color 0.18s ease, transform 0.18s ease;
  }

  .dropdown-link:hover {
    background: #FFF7ED;
    transform: translateX(2px);
  }

  .dropdown-link-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(238, 108, 31, 0.1);
    color: var(--bm-orange);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.18s ease;
  }

  .dropdown-link:hover .dropdown-link-icon {
    background: var(--bm-gradient);
    color: #FFFFFF;
    box-shadow: 0 4px 10px rgba(232, 38, 28, 0.25);
  }

  .dropdown-link-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .dropdown-link-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-main);
    transition: color 0.18s ease;
  }

  .dropdown-link:hover .dropdown-link-title {
    color: var(--bm-red);
  }

  .dropdown-link-desc {
    font-size: 0.74rem;
    color: var(--text-muted);
    line-height: 1.3;
  }

  .nav-link-admin {
    color: var(--bm-orange);
    padding: 0.25rem 0.65rem;
    background: var(--bm-orange-light);
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
  }

  .nav-link-admin:hover {
    color: var(--bm-red);
    background: var(--bm-red-light);
  }

  .nav-link-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .badge-mini {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-pill);
    background: rgba(238, 108, 31, 0.14);
    color: var(--bm-orange);
    text-transform: uppercase;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Audio en Vivo button styled identically to Hero button (BrandMeister gradient pill) */
  .btn-hoseline {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 1.25rem;
    background: var(--bm-gradient);
    color: #FFFFFF;
    font-size: 0.88rem;
    font-weight: 700;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(232, 38, 28, 0.4);
    box-shadow: 0 4px 16px -3px rgba(232, 38, 28, 0.4);
    transition: all 0.22s ease;
    cursor: pointer;
  }

  .btn-hoseline:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px -4px rgba(232, 38, 28, 0.55);
    color: #FFFFFF;
  }

  @media (max-width: 1039px) {
    .header-actions .btn-hoseline {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .brand-logo {
      height: 48px;
    }
    .header-actions {
      gap: 0.5rem;
    }
  }

  .btn-hoseline .icon-pause {
    display: none;
  }

  .btn-hoseline.is-active .icon-play {
    display: none;
  }

  .btn-hoseline.is-active .icon-pause {
    display: inline-block;
  }

  .mobile-hoseline-btn {
    margin-top: 1rem;
    width: 100%;
    justify-content: center;
    border: none;
  }

  .mobile-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0.4rem;
    color: var(--text-main);
    cursor: pointer;
  }

  @media (min-width: 1040px) {
    .mobile-toggle {
      display: none;
    }
  }

  .mobile-nav {
    display: none;
    background: #FFFFFF;
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.25rem 1.5rem;
  }

  .mobile-nav.is-open {
    display: block;
  }

  .mobile-nav-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-nav-link {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-main);
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .mobile-nav-link:hover {
    color: var(--bm-red);
  }

  /* Mobile Dropdown: Experiencia DMR */
  .mobile-dropdown-group {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.35rem;
  }

  .mobile-dropdown-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: none;
    border: none;
    padding: 0.4rem 0;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-main);
    cursor: pointer;
    font-family: inherit;
    text-align: left;
  }

  .mobile-dropdown-toggle:hover {
    color: var(--bm-red);
  }

  .mobile-chevron {
    transition: transform 0.22s ease;
    color: var(--bm-orange);
  }

  .mobile-dropdown-toggle[aria-expanded="true"] .mobile-chevron {
    transform: rotate(180deg);
  }

  .mobile-dropdown-sublinks {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.35rem 0 0.5rem 0.75rem;
  }

  .mobile-dropdown-sublinks.is-collapsed {
    display: none;
  }

  .mobile-sublink {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-muted);
    padding: 0.4rem 0.6rem;
    border-radius: 8px;
    transition: all 0.18s ease;
  }

  .mobile-sublink:hover {
    color: var(--bm-red);
    background: #FFF7ED;
  }

  .mobile-sublink svg {
    color: var(--bm-orange);
    flex-shrink: 0;
  }
</style>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const nav = document.getElementById('mobile-nav');

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      nav.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
    });

    nav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        nav.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        nav.setAttribute('aria-hidden', 'true');
      });
    });
  }

  // Mobile Accordion Toggle for Experiencia DMR
  const mobileExpToggle = document.getElementById('mobile-exp-toggle');
  const mobileExpSublinks = document.getElementById('mobile-exp-sublinks');
  if (mobileExpToggle && mobileExpSublinks) {
    mobileExpToggle.addEventListener('click', () => {
      const isExpanded = mobileExpToggle.getAttribute('aria-expanded') === 'true';
      mobileExpToggle.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
      mobileExpSublinks.classList.toggle('is-collapsed', isExpanded);
    });
  }

  // Desktop Dropdown: click & outside click support
  const expBtn = document.getElementById('exp-dropdown-btn');
  const expMenu = document.getElementById('exp-dropdown-menu');

  if (expBtn && expMenu) {
    expBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = expMenu.classList.toggle('is-open');
      expBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      expBtn.classList.toggle('is-active', isOpen);
    });

    document.addEventListener('click', (e) => {
      if (!expBtn.contains(e.target as Node) && !expMenu.contains(e.target as Node)) {
        expMenu.classList.remove('is-open');
        expBtn.setAttribute('aria-expanded', 'false');
        expBtn.classList.remove('is-active');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && expMenu.classList.contains('is-open')) {
        expMenu.classList.remove('is-open');
        expBtn.setAttribute('aria-expanded', 'false');
        expBtn.classList.remove('is-active');
        expBtn.focus();
      }
    });
  }
</script>
