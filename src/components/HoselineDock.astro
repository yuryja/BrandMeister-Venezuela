---
---

<!-- Floating Hoseline Live Audio Dock (Appears when user activates Hoseline) -->
<div id="hoseline-dock" class="hoseline-dock" aria-live="polite">
  <div class="dock-container">
    <!-- Left: Status & Live Indicator -->
    <div class="dock-left">
      <div class="dock-pulse-badge">
        <span id="dock-status-label" class="dock-status-label">DMR EN LÍNEA</span>
      </div>

      <div class="dock-call-meta">
        <span id="dock-callsign" class="dock-callsign">TG 734 - Venezuela</span>
        <span id="dock-alias" class="dock-alias">Escuchando...</span>
      </div>
    </div>

    <!-- Center: Dynamic Equalizer Wave -->
    <div class="dock-center">
      <div id="dock-wave" class="dock-wave is-idle">
        <span class="bar bar-1"></span>
        <span class="bar bar-2"></span>
        <span class="bar bar-3"></span>
        <span class="bar bar-4"></span>
        <span class="bar bar-5"></span>
        <span class="bar bar-6"></span>
        <span class="bar bar-7"></span>
        <span class="bar bar-8"></span>
      </div>
    </div>

    <!-- Right: Volume Slider & Close Button -->
    <div class="dock-right">
      <div class="dock-vol-group">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
        </svg>
        <input
          type="range"
          id="dock-volume"
          min="0"
          max="100"
          value="90"
          class="dock-vol-slider"
          aria-label="Volumen de Hoseline"
        />
      </div>

      <button id="dock-stop-btn" class="dock-btn-stop" title="Desconectar y silenciar audio">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
        <span>Desconectar</span>
      </button>
    </div>
  </div>
</div>

<script>
  import type { hoseline as HoselineInstance } from "../scripts/hoseline";

  // El reproductor (WebSocket + msgpack + audio) no se carga con la página:
  // se importa cuando el navegador está libre o al acercarse a un botón de audio.
  let hoseline: typeof HoselineInstance | null = null;
  let hoselineLoading: Promise<typeof HoselineInstance> | null = null;
  let pendingVolume: number | null = null;

  function loadHoseline(): Promise<typeof HoselineInstance> {
    if (hoseline) return Promise.resolve(hoseline);
    hoselineLoading ??= import("../scripts/hoseline").then((m) => {
      hoseline = m.hoseline;
      if (pendingVolume !== null) hoseline.setVolume(pendingVolume);
      return hoseline;
    });
    return hoselineLoading;
  }

  // ── Desbloqueo de audio en móviles ────────────────────────────────────────
  // iOS/Android solo permiten iniciar audio dentro del mismo toque. Como el reproductor se
  // carga de forma diferida, el AudioContext se crea y reanuda aquí, de forma síncrona.
  let silentLoop: HTMLAudioElement | null = null;

  function silentWavUrl(): string {
    const samples = 800; // 0,1 s a 8 kHz, 8 bits, silencio (valor 128)
    const buf = new ArrayBuffer(44 + samples);
    const v = new DataView(buf);
    const str = (o: number, s: string) => [...s].forEach((c, i) => v.setUint8(o + i, c.charCodeAt(0)));
    str(0, "RIFF"); v.setUint32(4, 36 + samples, true); str(8, "WAVE"); str(12, "fmt ");
    v.setUint32(16, 16, true); v.setUint16(20, 1, true); v.setUint16(22, 1, true);
    v.setUint32(24, 8000, true); v.setUint32(28, 8000, true); v.setUint16(32, 1, true); v.setUint16(34, 8, true);
    str(36, "data"); v.setUint32(40, samples, true);
    new Uint8Array(buf, 44).fill(128);
    return URL.createObjectURL(new Blob([buf], { type: "audio/wav" }));
  }

  function unlockAudio() {
    const w = window as any;
    try {
      // iOS 17+: que el audio suene aunque el interruptor de silencio esté activado
      if (w.navigator?.audioSession) w.navigator.audioSession.type = "playback";

      const AudioCtxClass = window.AudioContext || w.webkitAudioContext;
      if (!AudioCtxClass) return;
      if (!w.__bmAudioCtx) w.__bmAudioCtx = new AudioCtxClass();
      const ctx: AudioContext = w.__bmAudioCtx;
      if (ctx.state !== "running") ctx.resume().catch(() => {});

      // Un buffer silencioso reproducido dentro del gesto termina de desbloquear WebKit
      const source = ctx.createBufferSource();
      source.buffer = ctx.createBuffer(1, 1, ctx.sampleRate);
      source.connect(ctx.destination);
      source.start(0);

      // iOS < 17: un <audio> en bucle pasa la sesión a "reproducción" e ignora el modo silencio
      if (!w.navigator?.audioSession) {
        silentLoop ??= Object.assign(new Audio(silentWavUrl()), { loop: true });
        silentLoop.setAttribute("playsinline", "");
        silentLoop.play().catch(() => {});
      }
    } catch (err) {
      console.warn("[Hoseline] No se pudo desbloquear el audio:", err);
    }
  }

  function releaseSilentLoop() {
    silentLoop?.pause();
  }

  const dock = document.getElementById("hoseline-dock");
  const statusLabel = document.getElementById("dock-status-label");
  const callsignEl = document.getElementById("dock-callsign");
  const aliasEl = document.getElementById("dock-alias");
  const wave = document.getElementById("dock-wave");
  const volSlider = document.getElementById("dock-volume") as HTMLInputElement;
  const stopBtn = document.getElementById("dock-stop-btn");

  // Wire volume
  volSlider?.addEventListener("input", (e) => {
    const val = Number((e.target as HTMLInputElement).value) / 100;
    if (hoseline) hoseline.setVolume(val);
    else pendingVolume = val;
  });

  // Wire stop
  stopBtn?.addEventListener("click", () => {
    if (isAudioActive) {
      isAudioActive = false;
      sendAudioStop();
    }
    hoseline?.disconnect();
  });

  // In-memory cache for resolved radio operator names
  const operatorCache = new Map<string, string>();

  function formatOperatorText(call: any): string {
    if (!call) return "Escuchando...";
    const callsign = (call.callsign || "").trim().toUpperCase();
    let name = (call.name || "").trim();
    const alias = (call.alias || "").trim();

    // Check cache if name is not present
    if (!name && callsign && operatorCache.has(callsign)) {
      name = operatorCache.get(callsign)!;
    }

    // Attempt to extract name from alias
    if (!name && alias) {
      let cleanAlias = alias;
      if (callsign && cleanAlias.toUpperCase().startsWith(callsign)) {
        cleanAlias = cleanAlias.slice(callsign.length).replace(/^[\s\-_/:]+/, "").trim();
      }
      if (cleanAlias && cleanAlias.toUpperCase() !== callsign) {
        name = cleanAlias;
      }
    }

    // If still no name and sourceId or callsign exists, fetch in background from RadioID
    if (!name && (call.sourceId || callsign)) {
      const queryId = call.sourceId || callsign;
      fetch(`https://database.radioid.net/api/dmr/user/?id=${queryId}`)
        .then((res) => (res.ok ? res.json() : null))
        .then((data) => {
          const resObj = data?.results?.[0];
          const resolvedName = resObj?.fname || resObj?.name || "";
          if (resolvedName && callsign) {
            operatorCache.set(callsign, resolvedName);
            const active = hoseline?.getActiveCall();
            if (active && active.callsign?.toUpperCase() === callsign) {
              active.name = resolvedName;
              if (aliasEl) aliasEl.textContent = `${callsign} - ${resolvedName}`;
            }
          }
        })
        .catch(() => {});
    }

    if (callsign && name) {
      return `${callsign} - ${name}`;
    }
    if (callsign) {
      return callsign;
    }
    if (name) {
      return name;
    }
    return "Escuchando...";
  }

  // State Handler
  window.addEventListener("hoseline:stateChange", (e: any) => {
    const state = e.detail?.state;
    updateAllButtons(state);

    if (state === "idle" || state === "error") {
      releaseSilentLoop();
      dock?.classList.remove("is-visible");
      wave?.classList.add("is-idle");
      if (statusLabel) statusLabel.textContent = "DMR EN LÍNEA";
      if (callsignEl) callsignEl.textContent = "TG 734 - Venezuela";
      if (aliasEl) aliasEl.textContent = "Escuchando...";
    } else {
      dock?.classList.add("is-visible");
      if (statusLabel) statusLabel.textContent = "DMR EN LÍNEA";
      if (callsignEl) callsignEl.textContent = "TG 734 - Venezuela";

      if (state === "connecting" || state === "listening") {
        // Distinguir conexión de escucha ayuda a diagnosticar redes que bloquean el WebSocket
        if (aliasEl) aliasEl.textContent = state === "connecting" ? "Conectando con BrandMeister…" : "Escuchando...";
        wave?.classList.add("is-idle");
      } else if (state === "transmitting") {
        const call = hoseline?.getActiveCall();
        if (aliasEl) aliasEl.textContent = formatOperatorText(call);
        wave?.classList.remove("is-idle");
      }
    }
  });

  // Call Start Handler
  window.addEventListener("hoseline:callStart", (e: any) => {
    const call = e.detail;
    if (statusLabel) statusLabel.textContent = "DMR EN LÍNEA";
    if (callsignEl) callsignEl.textContent = "TG 734 - Venezuela";
    if (aliasEl) aliasEl.textContent = formatOperatorText(call);
    wave?.classList.remove("is-idle");
  });

  // Call Alias Handler
  window.addEventListener("hoseline:callAlias", (e: any) => {
    const call = hoseline?.getActiveCall();
    if (call && aliasEl) {
      if (e.detail?.alias) {
        call.alias = e.detail.alias;
      }
      aliasEl.textContent = formatOperatorText(call);
    }
  });

  // Call End Handler
  window.addEventListener("hoseline:callEnd", () => {
    if (statusLabel) statusLabel.textContent = "DMR EN LÍNEA";
    if (callsignEl) callsignEl.textContent = "TG 734 - Venezuela";
    if (aliasEl) aliasEl.textContent = "Escuchando...";
    wave?.classList.add("is-idle");
  });

  let isAudioActive = false;
  let audioHeartbeatTimer: any = null;

  function sendAudioStop() {
    stopAudioHeartbeat();
    const payload = JSON.stringify({
      event_type: 'player_play',
      event_category: 'audio_stop',
      entity_id: 'tg-734',
      entity_title: 'TG 734 Hoseline Audio'
    });
    try {
      if (navigator.sendBeacon) {
        const blob = new Blob([payload], { type: 'application/json' });
        navigator.sendBeacon('/api/analytics.php?action=track', blob);
      } else {
        fetch('/api/analytics.php?action=track', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: payload,
          keepalive: true
        }).catch(() => {});
      }
    } catch (_) {}
  }

  function startAudioHeartbeat() {
    if (audioHeartbeatTimer) return;
    audioHeartbeatTimer = setInterval(() => {
      if (hoseline && hoseline.getState() !== "idle" && hoseline.getState() !== "error") {
        fetch('/api/analytics.php?action=track', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            event_type: 'player_play',
            event_category: 'audio_heartbeat',
            entity_id: 'tg-734',
            entity_title: 'TG 734 Hoseline Audio'
          }),
          keepalive: true
        }).catch(() => {});
      } else {
        if (isAudioActive) {
          isAudioActive = false;
          sendAudioStop();
        } else {
          stopAudioHeartbeat();
        }
      }
    }, 25000);
  }

  function stopAudioHeartbeat() {
    if (audioHeartbeatTimer) {
      clearInterval(audioHeartbeatTimer);
      audioHeartbeatTimer = null;
    }
  }

  window.addEventListener("beforeunload", () => {
    if (isAudioActive) {
      isAudioActive = false;
      sendAudioStop();
    }
    hoseline?.disconnect();
  });
  window.addEventListener("pagehide", () => {
    if (isAudioActive) {
      isAudioActive = false;
      sendAudioStop();
    }
    hoseline?.disconnect();
  });

  // Helper to update buttons across Header, Hero, and Navigation
  function updateAllButtons(state: string) {
    const isActive = state !== "idle" && state !== "error";
    if (isActive) {
      isAudioActive = true;
      startAudioHeartbeat();
    } else {
      if (isAudioActive) {
        isAudioActive = false;
        sendAudioStop();
      } else {
        stopAudioHeartbeat();
      }
    }

    // Header Hoseline Button
    const headerBtn = document.querySelectorAll(".btn-hoseline-native");
    headerBtn.forEach((btn) => {
      const textSpan = btn.querySelector(".btn-label");
      if (!isActive) {
        btn.classList.remove("is-active", "is-transmitting");
        if (textSpan) textSpan.textContent = "Audio en Vivo";
      } else {
        btn.classList.add("is-active");
        if (state === "transmitting") {
          btn.classList.add("is-transmitting");
        } else {
          btn.classList.remove("is-transmitting");
        }
        if (textSpan) textSpan.textContent = "Escuchando TG 734";
      }
    });

    // Hero Hoseline Button
    const heroBtn = document.querySelectorAll(".btn-hero-primary-hoseline");
    // El texto lo resuelve el CSS del Hero según .is-active y el ancho de pantalla
    heroBtn.forEach((btn) => {
      btn.classList.toggle("is-active", isActive);
    });
  }

  // Hook global click events for any button with class .js-toggle-hoseline
  document.addEventListener("click", (e) => {
    const target = (e.target as HTMLElement).closest(".js-toggle-hoseline");
    if (target) {
      e.preventDefault();
      const willStart = !hoseline || hoseline.getState() === "idle" || hoseline.getState() === "error";
      if (willStart) {
        unlockAudio();
        isAudioActive = true;
        try {
          fetch('/api/analytics.php?action=track', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              event_type: 'player_play',
              event_category: 'audio',
              entity_id: 'tg-734',
              entity_title: 'TG 734 Hoseline Audio'
            }),
            keepalive: true
          }).catch(() => {});
        } catch (_) {}
      } else {
        if (isAudioActive) {
          isAudioActive = false;
          sendAudioStop();
        }
      }
      loadHoseline().then((player) => player.toggle(734));
    }
  });

  // Precarga anticipada: al acercar el cursor/dedo o enfocar un botón de audio,
  // y en cualquier caso cuando el navegador quede libre tras la carga.
  const warmUp = (e: Event) => {
    if ((e.target as HTMLElement | null)?.closest?.(".js-toggle-hoseline")) loadHoseline();
  };
  document.addEventListener("pointerover", warmUp, { passive: true });
  document.addEventListener("touchstart", warmUp, { passive: true });
  document.addEventListener("focusin", warmUp);

  const idle = (window as any).requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 2500));
  window.addEventListener("load", () => idle(() => loadHoseline(), { timeout: 5000 }), { once: true });
</script>

<style>
  .hoseline-dock {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translate(-50%, calc(100% + 3.5rem));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 999;
    width: min(92vw, 760px);
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1.5px solid rgba(238, 108, 31, 0.35);
    border-radius: 20px;
    box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.18),
                0 4px 16px -2px rgba(238, 108, 31, 0.15);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease, visibility 0.35s;
    box-sizing: border-box;
    font-family: var(--font-sans);
  }

  .hoseline-dock.is-visible {
    transform: translate(-50%, 0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .dock-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 0.85rem 1.35rem;
  }

  @media (max-width: 680px) {
    .hoseline-dock {
      bottom: 0.85rem;
      width: calc(100vw - 1.25rem);
      border-radius: 16px;
    }

    .dock-container {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      padding: 0.85rem 1rem;
    }
  }

  .dock-left {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .dock-pulse-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.2rem;
  }

  .dock-status-label {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--bm-red);
    text-transform: uppercase;
    letter-spacing: 0 !important;
  }

  .dock-call-meta {
    display: flex;
    flex-direction: column;
  }

  .dock-callsign {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: 0 !important;
  }

  .dock-alias {
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0 !important;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dock-center {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dock-wave {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 22px;
  }

  .dock-wave .bar {
    width: 3.5px;
    background: var(--bm-gradient);
    border-radius: 2px;
    animation: bounce 1.2s infinite ease-in-out;
  }

  .dock-wave.is-idle .bar {
    animation: none;
    height: 3px !important;
    background: #CBD5E1;
  }

  .bar-1 { height: 35%; animation-delay: 0.1s; }
  .bar-2 { height: 75%; animation-delay: 0.3s; }
  .bar-3 { height: 100%; animation-delay: 0.2s; }
  .bar-4 { height: 50%; animation-delay: 0.4s; }
  .bar-5 { height: 85%; animation-delay: 0.15s; }
  .bar-6 { height: 60%; animation-delay: 0.35s; }
  .bar-7 { height: 95%; animation-delay: 0.25s; }
  .bar-8 { height: 45%; animation-delay: 0.5s; }

  @keyframes bounce {
    0%, 100% { transform: scaleY(0.25); }
    50% { transform: scaleY(1); }
  }

  .dock-right {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    flex-shrink: 0;
  }

  @media (max-width: 680px) {
    .dock-right {
      justify-content: space-between;
    }
  }

  .dock-vol-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
  }

  .dock-vol-slider {
    width: 80px;
    accent-color: var(--bm-orange);
    cursor: pointer;
  }

  .dock-btn-stop {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.95rem;
    background: #FFF1F0;
    color: var(--bm-red);
    border: 1px solid rgba(232, 38, 28, 0.25);
    border-radius: var(--radius-pill);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    letter-spacing: 0 !important;
  }

  .dock-btn-stop:hover {
    background: var(--bm-red);
    color: #FFFFFF;
  }
</style>
