---
import type { PetraOperator } from '../../lib/petra';
import { formatDuration } from '../../lib/petra';
import CallsignFlag from './CallsignFlag.astro';

interface Props {
  top: {
    '1': PetraOperator[];
    '7': PetraOperator[];
    '30': PetraOperator[];
  };
}

const { top } = Astro.props;
const ranges = [
  { id: '1', label: 'Hoy' },
  { id: '7', label: '7 días' },
  { id: '30', label: '30 días' }
];
---

<div class="petra-panel-card top-operators-card">
  <div class="panel-header">
    <div class="panel-title-group">
      <h3 class="panel-title">Más Escuchados</h3>
      <span class="panel-subtitle" id="petra-top-subtitle">Estaciones con mayor tiempo de modulación en TG 734</span>
    </div>

    <div class="range-tabs" role="tablist">
      {ranges.map((r) => (
        <button
          type="button"
          class={`range-tab-btn ${r.id === '7' ? 'active' : ''}`}
          data-range={r.id}
          role="tab"
          aria-selected={r.id === '7' ? 'true' : 'false'}
        >
          {r.label}
        </button>
      ))}
    </div>
  </div>

  <div class="top-lists-container">
    {ranges.map((r) => {
      const list = top[r.id as '1' | '7' | '30'] || [];
      const maxMs = list.length > 0 ? list[0].air_ms : 1;
      const isActive = r.id === '7';

      return (
        <div
          id={`top-list-${r.id}`}
          class={`top-list-view ${isActive ? 'active' : ''}`}
        >
          {list.length > 0 ? (
            <div class="operators-table">
              {list.slice(0, 10).map((op, idx) => {
                const widthPct = Math.max(8, Math.round((op.air_ms / maxMs) * 100));
                const rank = idx + 1;
                const isPodium = rank === 1 || rank === 2 || rank === 3;

                return (
                  <div class="operator-row">
                    <div class="op-rank-col">
                      <span class={`rank-badge ${isPodium ? `rank-badge--podium rank-badge--${rank}` : ''}`}>
                        {rank}
                      </span>
                    </div>

                    <div class="op-info-col">
                      <div class="op-main-line">
                        <a
                          href={`https://www.qrz.com/db/${op.callsign}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="op-callsign"
                          title={`Ver perfil de ${op.callsign} en QRZ.com`}
                        >
                          <CallsignFlag callsign={op.callsign} />{op.callsign}
                        </a>
                        <span class="op-name">{op.name || 'Operador'}</span>
                        <span class="op-id">ID {op.id}</span>
                      </div>

                      <div class="op-bar-track">
                        <div
                          class={`op-bar-fill ${rank === 1 ? 'op-bar-fill--top' : ''}`}
                          style={`width: ${widthPct}%;`}
                        ></div>
                      </div>
                    </div>

                    <div class="op-stats-col">
                      <span class="op-airtime">{formatDuration(op.air_ms)}</span>
                      <span class="op-count">{op.count} QSOs</span>
                    </div>
                  </div>
                );
              })}
            </div>
          ) : (
            <div class="empty-state">
              <span>Sin registros para este intervalo</span>
            </div>
          )}
        </div>
      );
    })}
  </div>
</div>

<style>
  .top-operators-card {
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.75rem;
    box-shadow: var(--shadow-sm);
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .panel-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.2rem;
  }

  .panel-subtitle {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .range-tabs {
    display: inline-flex;
    background: var(--bg-card-subtle);
    padding: 0.2rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-subtle);
    gap: 0.15rem;
  }

  .range-tab-btn {
    border: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-muted);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .range-tab-btn:hover {
    color: var(--text-main);
  }

  .range-tab-btn.active {
    background: #FFFFFF;
    color: var(--bm-red);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }

  .top-list-view {
    display: none;
  }

  .top-list-view.active {
    display: block;
  }

  .top-lists-container :global(.operators-table) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .top-lists-container :global(.operator-row) {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    transition: background 0.15s ease;
  }

  .top-lists-container :global(.operator-row:hover) {
    background: var(--bg-card-subtle);
  }

  .top-lists-container :global(.op-rank-col) {
    flex: none;
    width: 24px;
    text-align: center;
  }

  .top-lists-container :global(.rank-badge) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    background: #F1F5F9;
  }

  .top-lists-container :global(.rank-badge--podium) {
    color: #FFFFFF;
  }

  .top-lists-container :global(.rank-badge--1) {
    background: var(--bm-red);
  }

  .top-lists-container :global(.rank-badge--2) {
    background: var(--bm-orange);
  }

  .top-lists-container :global(.rank-badge--3) {
    background: var(--bm-yellow);
  }

  .top-lists-container :global(.op-info-col) {
    flex: 1;
    min-width: 0;
  }

  .top-lists-container :global(.op-main-line) {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
    flex-wrap: wrap;
  }

  .top-lists-container :global(.op-callsign) {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 800;
    color: var(--text-main);
    text-decoration: none;
    transition: color 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .top-lists-container :global(.op-callsign:hover) {
    color: var(--bm-red);
    text-decoration: underline;
  }

  .top-lists-container :global(.op-name) {
    font-size: 0.85rem;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .top-lists-container :global(.op-id) {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  .top-lists-container :global(.op-bar-track) {
    height: 5px;
    background: #EDEFF2;
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .top-lists-container :global(.op-bar-fill) {
    height: 100%;
    background: var(--bm-orange);
    border-radius: var(--radius-pill);
    transition: width 0.3s ease;
  }

  .top-lists-container :global(.op-bar-fill--top) {
    background: linear-gradient(90deg, var(--bm-orange) 0%, var(--bm-red) 100%);
  }

  .top-lists-container :global(.op-stats-col) {
    flex: none;
    text-align: right;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .top-lists-container :global(.op-airtime) {
    font-family: var(--font-mono, monospace);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .top-lists-container :global(.op-count) {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  .empty-state {
    padding: 2rem;
    text-align: center;
    color: var(--text-muted);
    font-style: italic;
    font-size: 0.9rem;
  }
</style>

<script>
  function initTopOperatorsTabs() {
    const btns = document.querySelectorAll('.range-tab-btn');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const range = btn.getAttribute('data-range');
        btns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        document.querySelectorAll('.top-list-view').forEach((v) => v.classList.remove('active'));
        const activeList = document.getElementById(`top-list-${range}`);
        if (activeList) activeList.classList.add('active');
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initTopOperatorsTabs);
</script>
