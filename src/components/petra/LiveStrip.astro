---
import type { PetraLive } from '../../lib/petra';
import { formatDuration, formatRelativeTime } from '../../lib/petra';
import CallsignFlag from './CallsignFlag.astro';

interface Props {
  live: PetraLive;
}

const { live } = Astro.props;
const last = live.last_heard;
const isUp = live.link.state === 'up';
---

<div class="petra-live-strip">
  <div class="live-strip-header">
    <div class="live-strip-title-group">
      <div class="live-indicator">
        <span id="petra-status-dot" class={`status-dot ${isUp ? 'status-dot--ok' : 'status-dot--err'}`}></span>
        <span id="petra-status-text" class="live-status-text">{isUp ? 'Enlace Activo' : 'Enlace Inactivo'}</span>
      </div>
      <div class="master-host" title="Servidor Máster BrandMeister">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
          <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
          <line x1="6" y1="6" x2="6.01" y2="6"></line>
          <line x1="6" y1="18" x2="6.01" y2="18"></line>
        </svg>
        <span>{live.link.host || '7301.master.brandmeister.network'}</span>
      </div>
    </div>

    <div class="live-strip-uptime">
      <span class="uptime-badge">Uptime 24h: <strong id="petra-uptime">{live.link.uptime_24h}%</strong></span>
      <span id="petra-drops-badge" class={`drops-badge ${live.link.drops_24h > 0 ? 'drops-badge--warn' : ''}`}>{live.link.drops_24h} caídas</span>
    </div>
  </div>

  <!-- Selector de Talkgroup activo (encima de Último escuchado) -->
  <div class="petra-tg-selector-box">
    <div class="tg-selector-header">
      <div class="tg-selector-title-wrap">
        <span class="tg-selector-dot"></span>
        <label for="petra-tg-select" class="tg-selector-title">Talkgroup en Monitoreo:</label>
      </div>
      <span id="petra-tg-badge" class="tg-active-badge">TG 734 · Canal Nacional</span>
    </div>
    
    <div class="tg-selector-row">
      <div class="tg-select-wrapper">
        <select id="petra-tg-select" class="petra-tg-select" aria-label="Seleccionar Talkgroup para telemetría">
          <option value="734" selected>TG 734 · Venezuela Nacional (Oficial)</option>
          <option value="73452">TG 73452 · Emisiones Técnicas YV5RNE (Rueda 19:30-20:30)</option>
          <option value="73473">TG 73473 · Radio Club Venezolano (RCV)</option>
        </select>
        <svg class="tg-select-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>

      <div class="tg-quick-buttons" role="group" aria-label="Accesos rápidos de Talkgroup">
        <button type="button" class="tg-quick-btn active" data-tg="734" title="Canal Nacional Principal">TG 734</button>
        <button type="button" class="tg-quick-btn" data-tg="73452" title="Emisiones Técnicas YV5RNE · Rueda 19:30 a 20:30">TG 73452</button>
        <button type="button" class="tg-quick-btn" data-tg="73473" title="Radio Club Venezolano">TG 73473</button>
      </div>
    </div>
  </div>

  <!-- Último escuchado -->
  <div class="last-heard-card">
    <div class="last-heard-label">
      <span class="lh-tag" id="petra-lh-tag">Último escuchado en TG 734</span>
      <span id="petra-lh-time" class="lh-time" data-timestamp={last?.at || ''}>
        {last ? formatRelativeTime(last.at) : ''}
      </span>
    </div>

    <div class="last-heard-body" id="petra-lh-body" style={last ? '' : 'display: none;'}>
      <div class="lh-operator">
        <div class="lh-callsign-row">
          <a
            id="petra-lh-callsign"
            href={last ? `https://www.qrz.com/db/${last.callsign}` : '#'}
            target="_blank"
            rel="noopener noreferrer"
            class="lh-callsign"
            title={last ? `Ver ficha de ${last.callsign} en QRZ.com` : ''}
          >
            <span id="petra-lh-flag-container">
              {last && <CallsignFlag callsign={last.callsign} size="md" />}
            </span>
            <span id="petra-lh-callsign-text">{last ? last.callsign : ''}</span>
          </a>
          <span id="petra-carrier" class={`carrier-badge animate-pulse${last?.open ? '' : ' hidden'}`}>
            <span class="carrier-dot"></span>
            TRANSMITIENDO
          </span>
        </div>
        <div class="lh-details">
          <span id="petra-lh-name" class="lh-name">{last?.name || 'Operador DMR'}</span>
          <span class="lh-separator">·</span>
          <span id="petra-lh-id" class="lh-id" title="RadioID DMR">ID {last?.src_id || ''}</span>
        </div>
      </div>

      <div class="lh-meta">
        <div class="lh-duration-box">
          <span class="dur-label">Duración</span>
          <span id="petra-lh-dur" class="dur-val">{last ? formatDuration(last.dur_ms) : '0 s'}</span>
        </div>
      </div>
    </div>

    <div class="lh-empty" id="petra-lh-empty" style={last ? 'display: none;' : ''}>
      <span id="petra-lh-empty-text">Sin transmisiones registradas en esta sesión</span>
    </div>
  </div>
</div>

<style>
  .petra-live-strip {
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    box-shadow: var(--shadow-sm);
    margin-bottom: 2rem;
  }

  .live-strip-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 1.1rem;
  }

  .live-strip-title-group {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .live-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .status-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
  }

  .status-dot--ok {
    background-color: #10B981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
  }

  .status-dot--err {
    background-color: var(--bm-red);
    box-shadow: 0 0 0 3px rgba(232, 38, 28, 0.2);
  }

  .master-host {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    color: var(--text-muted);
    background: var(--bg-card-subtle);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  .live-strip-uptime {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8rem;
  }

  .uptime-badge {
    color: var(--text-muted);
  }

  .uptime-badge strong {
    color: var(--text-main);
  }

  .drops-badge {
    color: #10B981;
    font-weight: 600;
  }

  .drops-badge--warn {
    color: #F59E0B;
  }

  /* Último Escuchado */
  .last-heard-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .last-heard-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
    font-family: var(--font-mono, monospace);
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .lh-time {
    color: var(--text-muted);
    font-weight: 600;
    text-transform: none;
  }

  .last-heard-body {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    background: linear-gradient(135deg, rgba(238, 108, 31, 0.04) 0%, rgba(232, 38, 28, 0.02) 100%);
    border: 1px solid rgba(238, 108, 31, 0.15);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
  }

  .lh-callsign-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .lh-callsign {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--bm-red);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.15s ease;
  }

  .lh-callsign:hover {
    color: var(--bm-orange);
    text-decoration: underline;
  }

  .carrier-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #FFFFFF;
    background: var(--bm-red);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
  }

  .carrier-badge.hidden {
    display: none;
  }


  .carrier-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #FFFFFF;
  }

  .lh-details {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.95rem;
    color: var(--text-main);
  }

  .lh-name {
    font-weight: 600;
  }

  .lh-separator {
    color: var(--text-faint);
  }

  .lh-id {
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .lh-meta {
    display: flex;
    align-items: center;
  }

  .lh-duration-box {
    text-align: right;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .dur-label {
    font-size: 0.72rem;
    font-family: var(--font-mono, monospace);
    color: var(--text-faint);
    text-transform: uppercase;
  }

  .dur-val {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .lh-empty {
    padding: 1rem;
    color: var(--text-muted);
    font-style: italic;
    font-size: 0.9rem;
    text-align: center;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.75; transform: scale(1.03); }
  }

  .animate-pulse {
    animation: pulse 1.8s ease-in-out infinite;
  }

  /* Selector de Talkgroup (encima de Último escuchado) */
  .petra-tg-selector-box {
    background: #FFFBF7;
    border: 1.5px solid rgba(238, 108, 31, 0.25);
    border-radius: var(--radius-md);
    padding: 0.9rem 1.15rem;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .petra-tg-selector-box:focus-within {
    border-color: var(--bm-orange);
    box-shadow: 0 0 0 3px rgba(238, 108, 31, 0.12);
  }

  .tg-selector-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tg-selector-title-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tg-selector-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bm-gradient);
    display: inline-block;
  }

  .tg-selector-title {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-main);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .tg-active-badge {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--bm-red);
    background: rgba(232, 38, 28, 0.08);
    border: 1px solid rgba(232, 38, 28, 0.2);
    padding: 0.18rem 0.6rem;
    border-radius: var(--radius-pill);
    transition: all 0.2s ease;
  }

  .tg-selector-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .tg-select-wrapper {
    position: relative;
    flex: 1;
    min-width: 260px;
    max-width: 480px;
  }

  .petra-tg-select {
    width: 100%;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: #FFFFFF;
    border: 1.5px solid rgba(238, 108, 31, 0.35);
    border-radius: 10px;
    padding: 0.6rem 2.4rem 0.6rem 0.95rem;
    font-family: inherit;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-main);
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    transition: all 0.2s ease;
  }

  .petra-tg-select:hover {
    border-color: var(--bm-orange);
    box-shadow: 0 4px 12px rgba(238, 108, 31, 0.1);
  }

  .petra-tg-select:focus {
    outline: none;
    border-color: var(--bm-red);
    box-shadow: 0 0 0 3px rgba(232, 38, 28, 0.15);
  }

  .tg-select-arrow {
    position: absolute;
    right: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--bm-orange);
  }

  .tg-quick-buttons {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #FFFFFF;
    padding: 0.25rem;
    border-radius: 10px;
    border: 1px solid var(--border-subtle);
  }

  .tg-quick-btn {
    background: none;
    border: none;
    padding: 0.4rem 0.8rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-muted);
    border-radius: 7px;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .tg-quick-btn:hover {
    color: var(--bm-red);
    background: rgba(238, 108, 31, 0.08);
  }

  .tg-quick-btn.active {
    background: var(--bm-gradient);
    color: #FFFFFF;
    box-shadow: 0 2px 8px rgba(232, 38, 28, 0.25);
  }
</style>
