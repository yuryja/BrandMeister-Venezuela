---
import type { PetraHeatmapDay } from '../../lib/petra';
import { formatDuration } from '../../lib/petra';

interface Props {
  heatmap: PetraHeatmapDay[];
}

const { heatmap = [] } = Astro.props;

// Calculate max seconds for color scale
let maxSec = 1;
heatmap.forEach((d) => {
  d.hours.forEach((h) => {
    if (h > maxSec) maxSec = h;
  });
});

const dayNames = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];

function getDayLabel(dateStr: string): string {
  try {
    const [y, m, d] = dateStr.split('-').map(Number);
    const date = new Date(y, m - 1, d);
    return dayNames[date.getDay()] || dateStr.slice(5);
  } catch {
    return dateStr.slice(5);
  }
}

function getCellColor(sec: number, max: number): string {
  if (sec <= 0) return '#F1F5F9';
  const ratio = sec / max;
  if (ratio < 0.15) return '#FEF3C7'; // Amarillo suave BrandMeister
  if (ratio < 0.35) return '#FBBF24'; // Ámbar medio
  if (ratio < 0.65) return '#EE6C1F'; // Naranja BrandMeister
  return '#E8261C'; // Rojo BrandMeister pico
}
---

<div class="petra-chart-card heatmap-card">
  <div class="chart-header">
    <div class="chart-title-group">
      <h3 class="chart-title">La Semana, Hora a Hora</h3>
      <span class="chart-subtitle">Matriz de ocupación horaria en el talkgroup nacional</span>
    </div>

    <!-- Leyenda de colores -->
    <div class="heatmap-legend">
      <span class="legend-text">De silencio a saturado</span>
      <div class="legend-swatches">
        <span class="swatch" style="background: #F1F5F9;" title="Sin tráfico"></span>
        <span class="swatch" style="background: #FEF3C7;" title="Bajo"></span>
        <span class="swatch" style="background: #FBBF24;" title="Moderado"></span>
        <span class="swatch" style="background: #EE6C1F;" title="Alto"></span>
        <span class="swatch" style="background: #E8261C;" title="Pico"></span>
      </div>
    </div>
  </div>

  <div class="heatmap-matrix-container">
    <div class="heatmap-matrix">
      {heatmap.map((row) => {
        const dayLabel = getDayLabel(row.day);

        return (
          <div class="heat-row">
            <span class="heat-day-label" title={row.day}>{dayLabel}</span>
            <div class="heat-cells-grid">
              {row.hours.map((sec, hourIdx) => {
                const hourStr = `${String(hourIdx).padStart(2, '0')}:00`;
                const color = getCellColor(sec, maxSec);
                const durStr = sec > 0 ? formatDuration(sec * 1000) : 'Sin tráfico';

                return (
                  <div
                    class="heat-cell"
                    style={`background-color: ${color};`}
                    data-day={row.day}
                    data-hour={hourStr}
                    data-sec={sec}
                  >
                    <div class="cell-tooltip">
                      <span class="tt-day-hour">{dayLabel} {row.day} · {hourStr}</span>
                      <span class="tt-sec">{durStr} al aire</span>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>

    <div class="heat-axis">
      <span class="axis-spacer"></span>
      <div class="axis-ticks">
        <span>00:00</span>
        <span>04:00</span>
        <span>08:00</span>
        <span>12:00</span>
        <span>16:00</span>
        <span>20:00</span>
        <span>23:00</span>
      </div>
    </div>
  </div>
</div>

<style>
  .heatmap-card {
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.75rem;
    box-shadow: var(--shadow-sm);
    margin-bottom: 2.5rem;
  }

  .chart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .chart-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.2rem;
  }

  .chart-subtitle {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .heatmap-legend {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .legend-swatches {
    display: flex;
    gap: 3px;
  }

  .swatch {
    width: 14px;
    height: 12px;
    border-radius: 2px;
    display: inline-block;
  }

  .heatmap-matrix-container {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    overflow-x: auto;
    padding-top: 3.2rem;
    padding-bottom: 0.5rem;
  }

  .heatmap-matrix {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 650px;
  }

  .heat-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .heat-day-label {
    flex: none;
    width: 38px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-muted);
    text-align: right;
  }

  .heat-cells-grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(24, 1fr);
    gap: 3px;
  }

  .heat-cell {
    aspect-ratio: 1.1;
    border-radius: 3px;
    position: relative;
    cursor: pointer;
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .heat-cell:hover {
    transform: scale(1.2);
    filter: brightness(0.95);
    z-index: 15;
  }

  /* Tooltip con protección contra overflow */
  .cell-tooltip {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    background: #0F172A;
    color: #FFFFFF;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    font-size: 0.7rem;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
    z-index: 25;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    box-shadow: var(--shadow-md);
  }

  .cell-tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-width: 4px;
    border-style: solid;
    border-color: #0F172A transparent transparent transparent;
  }

  /* Evitar overflow en las primeras columnas del heatmap */
  .heat-cell:nth-child(-n+4) .cell-tooltip {
    left: 0;
    transform: none;
    align-items: flex-start;
  }

  .heat-cell:nth-child(-n+4) .cell-tooltip::after {
    left: 8px;
    transform: none;
  }

  /* Evitar overflow en las últimas columnas del heatmap */
  .heat-cell:nth-last-child(-n+4) .cell-tooltip {
    left: auto;
    right: 0;
    transform: none;
    align-items: flex-end;
  }

  .heat-cell:nth-last-child(-n+4) .cell-tooltip::after {
    left: auto;
    right: 8px;
    transform: none;
  }

  .heat-cell:hover .cell-tooltip {
    opacity: 1;
  }

  .tt-day-hour {
    font-weight: 700;
    color: var(--bm-orange);
  }

  .tt-sec {
    color: #F1F5F9;
  }

  .heat-axis {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.4rem;
    min-width: 650px;
  }

  .axis-spacer {
    flex: none;
    width: 38px;
  }

  .axis-ticks {
    flex: 1;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    color: var(--text-faint);
  }
</style>
