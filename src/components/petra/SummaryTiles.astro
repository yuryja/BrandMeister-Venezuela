---
import type { PetraSummary } from '../../lib/petra';
import { formatAirTimeSplit, formatDuration } from '../../lib/petra';

interface Props {
  summary: PetraSummary;
}

const { summary } = Astro.props;
const t = summary.today;
const y = summary.yesterday;

const diffCount = t.count - y.count;
const diffSign = diffCount > 0 ? `+${diffCount}` : `${diffCount}`;
const air = formatAirTimeSplit(t.air_ms);
const avgStr = t.count > 0 ? formatDuration(t.avg_ms) : 'Sin tráfico';
const longestStr = t.longest_s > 0 ? formatDuration(t.longest_s * 1000) : '—';
---

<div class="petra-summary-tiles">
  <!-- Tarjeta 1: Transmisiones hoy -->
  <div class="summary-tile">
    <div class="tile-header">
      <span class="tile-label">Transmisiones hoy</span>
      <span class="tile-icon">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
          <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
          <line x1="12" y1="19" x2="12" y2="22"></line>
        </svg>
      </span>
    </div>
    <div class="tile-value-row">
      <span id="petra-tile-count" class="tile-value">{t.count.toLocaleString('es-VE')}</span>
    </div>
    <div class={`tile-footer ${diffCount >= 0 ? 'tile-footer--up' : 'tile-footer--down'}`}>
      {diffCount === 0 ? (
        <span>Igual que ayer</span>
      ) : (
        <span>{diffSign} vs ayer a esta hora</span>
      )}
    </div>
  </div>

  <!-- Tarjeta 2: Tiempo al aire -->
  <div class="summary-tile">
    <div class="tile-header">
      <span class="tile-label">Tiempo al aire hoy</span>
      <span class="tile-icon">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </span>
    </div>
    <div class="tile-value-row">
      <span id="petra-tile-air-value" class="tile-value">{air.value}</span>
      <span id="petra-tile-air-unit" class="tile-unit">{air.unit}</span>
    </div>
    <div class="tile-footer">
      <span>Media por cambio: {avgStr}</span>
    </div>
  </div>

  <!-- Tarjeta 3: Operadores hoy -->
  <div class="summary-tile">
    <div class="tile-header">
      <span class="tile-label">Operadores hoy</span>
      <span class="tile-icon">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
      </span>
    </div>
    <div class="tile-value-row">
      <span id="petra-tile-ops" class="tile-value">{t.uniq_ops}</span>
    </div>
    <div class="tile-footer">
      <span>{summary.ops_7d} estaciones en 7 días</span>
    </div>
  </div>

  <!-- Tarjeta 4: La más larga -->
  <div class="summary-tile">
    <div class="tile-header">
      <span class="tile-label">Transmisión más larga</span>
      <span class="tile-icon">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
      </span>
    </div>
    <div class="tile-value-row">
      <span id="petra-tile-longest" class="tile-value">{longestStr}</span>
    </div>
    <div class="tile-footer">
      <span>{t.alerts === 1 ? '1 aviso oficial' : `${t.alerts} avisos oficiales`}</span>
    </div>
  </div>
</div>

<style>
  .petra-summary-tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  @media (max-width: 600px) {
    .petra-summary-tiles {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
      margin-bottom: 1.75rem;
    }
  }

  @media (max-width: 360px) {
    .petra-summary-tiles {
      grid-template-columns: 1fr;
    }
  }

  .summary-tile {
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.4rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .summary-tile:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: rgba(238, 108, 31, 0.3);
  }

  .tile-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }

  .tile-label {
    font-family: var(--font-mono, monospace);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .tile-icon {
    color: var(--bm-orange);
    opacity: 0.8;
  }

  .tile-value-row {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    margin-bottom: 0.5rem;
  }

  .tile-value {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .tile-unit {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .tile-footer {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-mono, monospace);
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.5rem;
    margin-top: auto;
  }

  .tile-footer--up {
    color: #10B981;
    font-weight: 600;
  }

  .tile-footer--down {
    color: var(--bm-red);
  }
</style>
