---

<footer id="contacto" class="site-footer">
  <div class="bm-stripe"></div>
  <div class="container footer-content">
    <div class="footer-main-grid">
      <!-- Brand Column -->
      <div class="footer-brand-col">
        <a href="/" class="footer-logo-link">
          <img
            src="/assets/logo-white.webp"
            alt="BrandMeister Venezuela"
            class="footer-logo"
            width="170"
            height="48"
            loading="lazy"
            decoding="async"
          />
        </a>
        <div class="footer-tg-text">
          Red BrandMeister · TG Nacional 734
        </div>
        <p class="footer-mission">
          Comunidad técnica abierta dedicada a la consolidación y expansión de la voz digital DMR en toda Venezuela.
        </p>
      </div>

      <!-- Quick Links -->
      <div class="footer-links-col">
        <h4 class="footer-heading">Navegación</h4>
        <ul class="footer-links">
          <li><a href="/">Inicio</a></li>
          <li><a href="/comunidad">Nuestra Comunidad</a></li>
          <li><a href="/talkgroups">Talkgroups y Circuitos</a></li>
          <li><a href="/repetidores">Repetidores Activos</a></li>
          <li><a href="/blog">Noticias</a></li>
          <li><a href="/galeria">Galería</a></li>
          <li><a href="/contacto">Contacto y Soporte</a></li>
          <li><a href="/admin" class="footer-admin-link">Login</a></li>
        </ul>
      </div>

      <!-- External Tools -->
      <div class="footer-links-col">
        <h4 class="footer-heading">Herramientas en Vivo</h4>
        <ul class="footer-links">
          <li>
            <a href="/petra">
              Petra
            </a>
          </li>
          <li>
            <a href="https://hose.brandmeister.network/" target="_blank" rel="noopener noreferrer">
              BrandMeister Hoseline ↗
            </a>
          </li>
          <li>
            <a href="https://brandmeister.network/" target="_blank" rel="noopener noreferrer">
              Master Dashboard ↗
            </a>
          </li>
          <li>
            <a href="https://wiki.brandmeister.network/index.php/Venezuela" target="_blank" rel="noopener noreferrer">
              Wiki Oficial BrandMeister ↗
            </a>
          </li>
          <li>
            <a href="https://radioid.net/" target="_blank" rel="noopener noreferrer">
              RadioID.net ↗
            </a>
          </li>
        </ul>
      </div>

      <!-- Social & Contact -->
      <div class="footer-contact-col">
        <h4 class="footer-heading">Contacto y Comunidad</h4>
        <div class="footer-contact-list">
          <div class="footer-email-block">
            <span class="footer-email-label">Sysop & Soporte</span>
            <a href="mailto:sysop@brandmeisteryv.net" class="footer-contact-link">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span>sysop@brandmeisteryv.net</span>
            </a>
          </div>

          <div class="footer-social-links">
            <a
              href="https://www.instagram.com/brandmeister_yv/"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-contact-link"
              aria-label="Instagram de BrandMeister Venezuela"
            >
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
              <span>@brandmeister_yv</span>
            </a>

            <a
              href="https://t.me/+_NUvASaZZGxhYTkx"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-contact-link"
              aria-label="Grupo de Telegram de BrandMeister Venezuela"
            >
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
              <span>Grupo Telegram</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Legal & Disclaimer -->
    <div class="footer-bottom">
      <div class="footer-disclaimer">
        <p>
          <strong>Aviso Comunitario:</strong> BrandMeister Venezuela es el nombre de esta comunidad técnica sin fines de lucro conformada por radioaficionados venezolanos y no representa una entidad corporativa comercial de la marca registrada BrandMeister.
        </p>
      </div>

      <div class="footer-credits">
        <span>© {new Date().getFullYear()} BrandMeister Venezuela.</span>
        <span>Desarrollado con orgullo por <a href="mailto:yy3big@gmail.com">YY3BIG</a></span>
      </div>
    </div>
  </div>
</footer>

<style>
  /* DARK THEME FOOTER */
  .site-footer {
    background: #0F172A;
    color: #E2E8F0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 0;
  }

  .bm-stripe {
    height: 3px;
    background: var(--bm-gradient);
    width: 100%;
  }

  .footer-content {
    padding-top: clamp(3.5rem, 6vw, 5rem);
    padding-bottom: 2.5rem;
  }

  .footer-main-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 640px) {
    .footer-main-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1040px) {
    .footer-main-grid {
      grid-template-columns: 1.5fr 1fr 1fr 1.3fr;
      gap: 3.5rem;
    }
  }

  .footer-logo {
    height: 48px;
    width: auto;
    object-fit: contain;
    margin-bottom: 1.25rem;
    display: block;
  }

  .footer-tg-text {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--bm-orange);
    margin-bottom: 1.1rem;
    letter-spacing: 0.02em;
  }

  .footer-mission {
    font-size: 0.95rem;
    color: #94A3B8;
    line-height: 1.65;
    max-width: 320px;
  }

  .footer-heading {
    font-size: 0.95rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a {
    font-size: 0.92rem;
    color: #94A3B8;
    text-decoration: none !important;
    transition: color 0.18s ease;
  }

  .footer-links a:hover {
    color: #FFFFFF;
    text-decoration: none !important;
  }

  .footer-admin-link {
    color: var(--bm-orange) !important;
    font-weight: 700;
  }

  .footer-admin-link:hover {
    color: #FFFFFF !important;
  }

  /* Contact and Social column */
  .footer-contact-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-email-block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .footer-email-label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #64748B;
  }

  .footer-social-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: #FFFFFF;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none !important;
    transition: color 0.18s ease, transform 0.18s ease;
    background: transparent;
    border: none;
    padding: 0;
  }

  .footer-contact-link svg {
    color: var(--bm-orange);
    flex-shrink: 0;
    transition: transform 0.18s ease;
  }

  .footer-contact-link:hover {
    color: var(--bm-orange);
    text-decoration: none !important;
    transform: translateX(3px);
  }

  /* Bottom Row */
  .footer-bottom {
    padding-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-disclaimer p {
    font-size: 0.85rem;
    color: #64748B;
    max-width: 600px;
    line-height: 1.55;
  }

  .footer-credits {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.85rem;
    color: #94A3B8;
  }

  @media (min-width: 768px) {
    .footer-credits {
      text-align: right;
    }
  }

  .footer-credits a {
    color: var(--bm-orange);
    font-weight: 700;
    text-decoration: none !important;
    transition: color 0.18s ease;
  }

  .footer-credits a:hover {
    color: #FFFFFF;
    text-decoration: none !important;
  }
</style>
