---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPost = sortedPosts.find(p => p.data.featured) || sortedPosts[0];
const otherPosts = sortedPosts.filter(p => p.slug !== featuredPost.slug).slice(0, 3);
---

<section class="blog-preview-section section-padding">
  <div class="container">
    <div class="blog-header-row reveal-on-scroll">
      <div>
        <div class="section-tag">Noticias & Comunicados</div>
        <h2 class="section-title">Novedades, avances técnicos y guías de la red</h2>
      </div>
      <a href="/blog" class="btn btn-secondary">
        <span>Ver todas las noticias</span>
        <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </a>
    </div>

    <!-- Editorial Asymmetric Layout (NOT generic card grid) -->
    <div class="editorial-blog-layout reveal-on-scroll">
      <!-- Main Lead Article -->
      {featuredPost && (
        <article class="featured-post">
          <div class="post-meta-top">
            <span class="post-cat">{featuredPost.data.category}</span>
            <span class="post-date">
              {featuredPost.data.pubDate.toLocaleDateString('es-VE', { year: 'numeric', month: 'long', day: 'numeric' })}
            </span>
            <span class="post-read">{featuredPost.data.readTime}</span>
          </div>

          <h3 class="featured-title">
            <a href={`/blog/${featuredPost.slug}`}>{featuredPost.data.title}</a>
          </h3>

          <p class="featured-excerpt">{featuredPost.data.description}</p>

          <div class="post-author-row">
            <span class="author-badge">
              <strong>{featuredPost.data.author}</strong>
              {featuredPost.data.authorCallsign && (
                <span class="callsign-tag">{featuredPost.data.authorCallsign}</span>
              )}
            </span>
            <a href={`/blog/${featuredPost.slug}`} class="read-more-link">
              Leer artículo completo →
            </a>
          </div>
        </article>
      )}

      <!-- Secondary Linear Article Stream -->
      <div class="articles-stream">
        {otherPosts.map(post => (
          <article class="stream-article">
            <div class="post-meta-top">
              <span class="post-cat">{post.data.category}</span>
              <span class="post-date">
                {post.data.pubDate.toLocaleDateString('es-VE', { month: 'short', day: 'numeric', year: 'numeric' })}
              </span>
            </div>

            <h4 class="stream-title">
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            </h4>

            <p class="stream-excerpt">{post.data.description}</p>

            <div class="stream-footer">
              <span class="stream-author">{post.data.authorCallsign || post.data.author}</span>
              <span class="stream-read">{post.data.readTime}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .blog-preview-section {
    position: relative;
    box-sizing: border-box;
    overflow: hidden;
    background-color: #FFFFFF;
    background-image:
      linear-gradient(90deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.94) 42%, rgba(255, 255, 255, 0.65) 68%, rgba(255, 255, 255, 0.15) 100%),
      linear-gradient(0deg, #FFFFFF 0%, rgba(255, 255, 255, 0.8) 12%, transparent 35%),
      url('/assets/news-motorola-bg.jpg');
    background-size: cover;
    background-position: right center;
    background-repeat: no-repeat;
    border-bottom: 1px solid var(--border-subtle);
  }

  @media (max-width: 768px) {
    .blog-preview-section {
      background-image:
        linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.92) 50%, rgba(255, 255, 255, 0.65) 80%, rgba(255, 255, 255, 0.35) 100%),
        url('/assets/news-motorola-bg.jpg');
      background-position: center top;
      background-size: cover;
    }
  }

  .blog-header-row {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  @media (min-width: 768px) {
    .blog-header-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  /* Editorial Split Grid */
  .editorial-blog-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 960px) {
    .editorial-blog-layout {
      grid-template-columns: 1.25fr 1fr;
      gap: 3.5rem;
      align-items: stretch;
    }
  }

  /* Featured Post Styling */
  .featured-post {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(2rem, 4vw, 3rem);
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-left: 4px solid var(--bm-red);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .post-meta-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    font-size: 0.82rem;
  }

  .post-cat {
    font-weight: 700;
    text-transform: uppercase;
    color: var(--bm-red);
  }

  .post-date {
    color: var(--text-faint);
  }

  .post-read {
    color: var(--text-faint);
    padding-left: 0.75rem;
    border-left: 1px solid var(--border-subtle);
  }

  .featured-title {
    font-size: clamp(1.5rem, 2.5vw, 2.1rem);
    line-height: 1.25;
    margin-bottom: 1.25rem;
  }

  .featured-title a:hover {
    color: var(--bm-red);
  }

  .featured-excerpt {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .post-author-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .author-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-main);
  }

  .callsign-tag {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--bm-orange);
    background: rgba(238, 108, 31, 0.1);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .read-more-link {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--bm-orange);
  }

  .read-more-link:hover {
    color: var(--bm-red);
  }

  /* Articles Stream */
  .articles-stream {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2rem);
    box-shadow: var(--shadow-sm);
  }

  .stream-article {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .stream-article:first-child {
    padding-top: 0;
  }

  .stream-article:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .stream-title {
    font-size: 1.15rem;
    line-height: 1.35;
    margin-bottom: 0.5rem;
  }

  .stream-title a:hover {
    color: var(--bm-red);
  }

  .stream-excerpt {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 0.85rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .stream-footer {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .stream-author {
    font-weight: 600;
    color: var(--text-muted);
  }
</style>
