---
// Últimas noticias en la portada. Se prerenderizan con datos base y se actualizan dinámicamente desde /api/posts.php (MySQL).

interface PostPreview {
  id: number;
  title: string;
  slug: string;
  description: string;
  category: string;
  read_time: string;
  featured: boolean;
  image_url: string;
  published_ts: number;
  author_name: string;
  author_callsign?: string;
  url: string;
}

const DEFAULT_POSTS: PostPreview[] = [
  {
    id: 1,
    title: 'Evolución y estado del sistema Petra para el TG 734 en Venezuela',
    slug: 'petra-telemetria-tg734',
    description: 'Descubre cómo funciona la plataforma comunitaria Petra, desarrollada por YY3BIG para medir la actividad, salud del anunciador y ocupación espectral en BrandMeister Venezuela.',
    category: 'Innovación',
    read_time: '5 min de lectura',
    featured: true,
    image_url: '/assets/petra-hero-bg.webp',
    published_ts: 1789613553,
    author_name: 'Yury',
    author_callsign: 'YY3BIG',
    url: '/blog/petra-telemetria-tg734'
  },
  {
    id: 2,
    title: 'Guía esencial: Configuración de Hotspots DMR en BrandMeister Venezuela',
    slug: 'configuracion-hotspots-dmr-venezuela',
    description: 'Paso a paso para configurar tu hotspot MMDVM (Pi-Star / WPSD) conectado a los servidores máster 3341 y 7301 con los parámetros oficiales recomendados.',
    category: 'Guías Técnicas',
    read_time: '6 min de lectura',
    featured: false,
    image_url: '/assets/services-dmr-composition.webp',
    published_ts: 1789613553,
    author_name: 'Severino Mastracci',
    author_callsign: 'YV5OF',
    url: '/blog/configuracion-hotspots-dmr-venezuela'
  },
  {
    id: 3,
    title: 'Protocolo de operación en emergencias con el TG 734911 y Radio Club Venezolano',
    slug: 'red-emergencia-tg734911',
    description: 'Directrices para el uso del canal de emergencias de BrandMeister Venezuela, coordinación con YV5RNE y recomendaciones de escucha activa en repetidores.',
    category: 'Operación',
    read_time: '4 min de lectura',
    featured: false,
    image_url: '/assets/repeaters-fieldwork.webp',
    published_ts: 1789613553,
    author_name: 'Arnaldo',
    author_callsign: 'YV5ADM',
    url: '/blog/red-emergencia-tg734911'
  },
  {
    id: 4,
    title: 'Actualización RadioID.net: Proceso anual de verificación y preservación de IDs DMR',
    slug: 'verificacion-radioid-dmr',
    description: 'Todo lo que necesitas saber sobre el proceso anual de confirmación de RadioID.net y cómo mantener tu identificador DMR activo para operar en BrandMeister.',
    category: 'Comunidad',
    read_time: '3 min de lectura',
    featured: false,
    image_url: '/assets/news-motorola-bg.webp',
    published_ts: 1789613553,
    author_name: 'Severino Mastracci',
    author_callsign: 'YV5OF',
    url: '/blog/verificacion-radioid-dmr'
  }
];

const destacada = DEFAULT_POSTS.find((p) => p.featured) || DEFAULT_POSTS[0];
const resto = DEFAULT_POSTS.filter((p) => p.id !== destacada.id).slice(0, 3);
const formatDate = (ts: number, opts: Intl.DateTimeFormatOptions) => new Date(ts * 1000).toLocaleDateString('es-VE', opts);
---

<section class="blog-preview-section section-padding">
  <div class="container">
    <div class="blog-header-row reveal-on-scroll">
      <div>
        <div class="section-tag">Noticias & Comunicados</div>
        <h2 class="section-title">Novedades, avances técnicos y guías de la red</h2>
      </div>
      <a href="/blog" class="btn btn-secondary">
        <span>Ver todas las noticias</span>
        <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </a>
    </div>

    <div class="editorial-blog-layout reveal-on-scroll" id="blog-preview-layout">
      <article class={`featured-post ${destacada.image_url ? 'has-bg-image' : ''}`}>
        {destacada.image_url && (
          <div class="post-bg-layer" style={`background-image: url('${destacada.image_url}');`} aria-hidden="true" />
        )}
        <div class="post-meta-top">
          <span class="post-cat">{destacada.category}</span>
          <span class="post-date">{formatDate(destacada.published_ts, { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          <span class="post-read">{destacada.read_time}</span>
        </div>
        <div class="featured-body">
          <h3 class="featured-title"><a href={destacada.url}>{destacada.title}</a></h3>
          <p class="featured-excerpt">{destacada.description}</p>
        </div>
        <div class="post-author-row">
          <span class="author-badge">
            <strong>{destacada.author_name}</strong>
            {destacada.author_callsign && <span class="callsign-tag">{destacada.author_callsign}</span>}
          </span>
          <a href={destacada.url} class="read-more-link">
            <span>Leer artículo completo</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>

      <div class="articles-stream">
        {resto.map((post) => (
          <article class={`stream-article ${post.image_url ? 'has-bg-image' : ''}`}>
            {post.image_url && (
              <div class="post-bg-layer" style={`background-image: url('${post.image_url}');`} aria-hidden="true" />
            )}
            <div class="stream-content">
              <div class="post-meta-top">
                <span class="post-cat">{post.category}</span>
                <span class="post-date">{formatDate(post.published_ts, { month: 'short', day: 'numeric', year: 'numeric' })}</span>
              </div>
              <h4 class="stream-title"><a href={post.url}>{post.title}</a></h4>
              <p class="stream-excerpt">{post.description}</p>
              <div class="stream-footer">
                <span class="stream-author">{post.author_callsign || post.author_name}</span>
                <span class="stream-read">{post.read_time}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (async () => {
    const layout = document.getElementById('blog-preview-layout');
    if (!layout) return;

    const escapeHtml = (value) =>
      String(value ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    const fecha = (ts, opts) => new Date(ts * 1000).toLocaleDateString('es-VE', opts);

    let posts = [];
    try {
      const res = await fetch('/api/posts.php?limit=4', { headers: { Accept: 'application/json' } });
      if (res.ok) {
        const data = await res.json();
        posts = Array.isArray(data?.posts) ? data.posts : [];
      }
    } catch {
      posts = [];
    }

    // Si la API no retorna noticias (ej. entorno de desarrollo estático), mantenemos las prerenderizadas
    if (!posts || !posts.length) return;

    const destacada = posts.find((p) => p.featured) || posts[0];
    const resto = posts.filter((p) => p.id !== destacada.id).slice(0, 3);

    const autor = (p) => escapeHtml(p.author_callsign || p.author_name);
    const hasImgDestacada = Boolean(destacada.image_url);

    layout.innerHTML = `
      <article class="featured-post ${hasImgDestacada ? 'has-bg-image' : ''}">
        ${hasImgDestacada ? `<div class="post-bg-layer" style="background-image: url('${escapeHtml(destacada.image_url)}');" aria-hidden="true"></div>` : ''}
        <div class="post-meta-top">
          <span class="post-cat">${escapeHtml(destacada.category)}</span>
          <span class="post-date">${fecha(destacada.published_ts, { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          <span class="post-read">${escapeHtml(destacada.read_time)}</span>
        </div>
        <div class="featured-body">
          <h3 class="featured-title"><a href="${escapeHtml(destacada.url)}">${escapeHtml(destacada.title)}</a></h3>
          <p class="featured-excerpt">${escapeHtml(destacada.description)}</p>
        </div>
        <div class="post-author-row">
          <span class="author-badge">
            <strong>${escapeHtml(destacada.author_name)}</strong>
            ${destacada.author_callsign ? `<span class="callsign-tag">${escapeHtml(destacada.author_callsign)}</span>` : ''}
          </span>
          <a href="${escapeHtml(destacada.url)}" class="read-more-link">
            <span>Leer artículo completo</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
      <div class="articles-stream">
        ${resto.map((post) => {
          const hasImg = Boolean(post.image_url);
          return `
            <article class="stream-article ${hasImg ? 'has-bg-image' : ''}">
              ${hasImg ? `<div class="post-bg-layer" style="background-image: url('${escapeHtml(post.image_url)}');" aria-hidden="true"></div>` : ''}
              <div class="stream-content">
                <div class="post-meta-top">
                  <span class="post-cat">${escapeHtml(post.category)}</span>
                  <span class="post-date">${fecha(post.published_ts, { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                </div>
                <h4 class="stream-title"><a href="${escapeHtml(post.url)}">${escapeHtml(post.title)}</a></h4>
                <p class="stream-excerpt">${escapeHtml(post.description)}</p>
                <div class="stream-footer">
                  <span class="stream-author">${autor(post)}</span>
                  <span class="stream-read">${escapeHtml(post.read_time)}</span>
                </div>
              </div>
            </article>`;
        }).join('')}
      </div>`;
  })();
</script>

<!-- Global con prefijo .blog-preview-section: las tarjetas se generan con JS -->
<style is:global>
  .blog-preview-section {
    background: #FFFFFF;
    border-bottom: 1px solid var(--border-subtle);
  }

  .blog-preview-section .blog-header-row {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  @media (min-width: 768px) {
    .blog-preview-section .blog-header-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  /* Editorial Split Grid */
  .blog-preview-section .editorial-blog-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 960px) {
    .blog-preview-section .editorial-blog-layout {
      grid-template-columns: 1.25fr 1fr;
      gap: 2.5rem;
      align-items: stretch;
    }
  }

  /* Background image layer with smooth hover zoom and dark contrast overlay */
  .blog-preview-section .post-bg-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 0;
    pointer-events: none;
    transform: scale(1.001);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .blog-preview-section .featured-post .post-bg-layer::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.42) 0%, rgba(15, 23, 42, 0.76) 50%, rgba(15, 23, 42, 0.96) 100%);
  }

  .blog-preview-section .stream-article .post-bg-layer::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.48) 0%, rgba(15, 23, 42, 0.82) 55%, rgba(15, 23, 42, 0.97) 100%);
  }

  .blog-preview-section .featured-post:hover .post-bg-layer,
  .blog-preview-section .stream-article:hover .post-bg-layer {
    transform: scale(1.045);
  }

  /* Featured Post Styling */
  .blog-preview-section .featured-post {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(2rem, 4vw, 3rem);
    background: var(--bg-page);
    border: 1px solid var(--border-subtle);
    border-left: 4px solid var(--bm-red);
    border-radius: var(--radius-md);
    min-height: 440px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
  }

  .blog-preview-section .featured-post:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .blog-preview-section .featured-post.has-bg-image {
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-left: 4px solid var(--bm-red);
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.16);
  }

  .blog-preview-section .featured-post.has-bg-image:hover {
    box-shadow: 0 20px 48px rgba(15, 23, 42, 0.28);
  }

  /* Content elements inside featured post stay above the background */
  .blog-preview-section .featured-post .post-meta-top,
  .blog-preview-section .featured-post .featured-body,
  .blog-preview-section .featured-post .post-author-row {
    position: relative;
    z-index: 1;
  }

  .blog-preview-section .featured-post .featured-body {
    margin: 1.5rem 0;
  }

  .blog-preview-section .post-meta-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.82rem;
  }

  /* Standard / Default Post Meta */
  .blog-preview-section .post-cat {
    font-weight: 700;
    text-transform: uppercase;
    color: var(--bm-red);
  }

  .blog-preview-section .post-date {
    color: var(--text-faint);
  }

  .blog-preview-section .post-read {
    color: var(--text-faint);
    padding-left: 0.75rem;
    border-left: 1px solid var(--border-subtle);
  }

  /* High-contrast typography when background image is present */
  .blog-preview-section .featured-post.has-bg-image .post-cat {
    background: var(--bm-red);
    color: #FFFFFF;
    padding: 0.22rem 0.65rem;
    border-radius: var(--radius-sm);
    font-size: 0.74rem;
    letter-spacing: 0.4px;
    box-shadow: 0 2px 8px rgba(232, 38, 28, 0.4);
  }

  .blog-preview-section .featured-post.has-bg-image .post-date {
    color: rgba(255, 255, 255, 0.85);
    font-weight: 500;
  }

  .blog-preview-section .featured-post.has-bg-image .post-read {
    color: rgba(255, 255, 255, 0.85);
    border-left-color: rgba(255, 255, 255, 0.25);
  }

  .blog-preview-section .featured-title {
    font-size: clamp(1.5rem, 2.5vw, 2.1rem);
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .blog-preview-section .featured-title a {
    color: var(--text-main);
    transition: color 0.2s ease, text-shadow 0.2s ease;
  }

  .blog-preview-section .featured-title a:hover {
    color: var(--bm-red);
  }

  .blog-preview-section .featured-post.has-bg-image .featured-title a {
    color: #FFFFFF;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.75);
  }

  .blog-preview-section .featured-post.has-bg-image .featured-title a:hover {
    color: var(--bm-yellow);
    text-shadow: 0 2px 12px rgba(242, 169, 59, 0.45);
  }

  .blog-preview-section .featured-excerpt {
    font-size: 1.08rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .blog-preview-section .featured-post.has-bg-image .featured-excerpt {
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
  }

  .blog-preview-section .post-author-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .blog-preview-section .featured-post.has-bg-image .post-author-row {
    border-top-color: rgba(255, 255, 255, 0.18);
  }

  .blog-preview-section .author-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-main);
  }

  .blog-preview-section .featured-post.has-bg-image .author-badge {
    color: #FFFFFF;
  }

  .blog-preview-section .callsign-tag {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--bm-orange);
    background: rgba(238, 108, 31, 0.1);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .blog-preview-section .featured-post.has-bg-image .callsign-tag {
    color: var(--bm-yellow);
    background: rgba(242, 169, 59, 0.18);
    border: 1px solid rgba(242, 169, 59, 0.4);
  }

  .blog-preview-section .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--bm-orange);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .blog-preview-section .read-more-link:hover {
    color: var(--bm-red);
    transform: translateX(3px);
  }

  .blog-preview-section .featured-post.has-bg-image .read-more-link {
    color: var(--bm-yellow);
  }

  .blog-preview-section .featured-post.has-bg-image .read-more-link:hover {
    color: #FFFFFF;
  }

  /* Articles Stream (Modern balanced cards) */
  .blog-preview-section .articles-stream {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    justify-content: space-between;
  }

  .blog-preview-section .stream-article {
    position: relative;
    overflow: hidden;
    padding: 1.35rem 1.5rem;
    border-radius: var(--radius-md);
    background: var(--bg-page);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 125px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .blog-preview-section .stream-article:hover {
    transform: translateY(-2px);
    border-color: var(--border-medium);
    box-shadow: var(--shadow-md);
  }

  .blog-preview-section .stream-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .blog-preview-section .stream-article .post-meta-top {
    margin-bottom: 0.65rem;
  }

  .blog-preview-section .stream-title {
    font-size: 1.15rem;
    line-height: 1.35;
    margin-bottom: 0.5rem;
  }

  .blog-preview-section .stream-title a {
    color: var(--text-main);
    transition: color 0.2s ease;
  }

  .blog-preview-section .stream-title a:hover {
    color: var(--bm-red);
  }

  .blog-preview-section .stream-excerpt {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-preview-section .stream-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    color: var(--text-faint);
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
  }

  .blog-preview-section .stream-author {
    font-weight: 600;
    color: var(--text-muted);
  }

  .blog-preview-section .stream-read {
    color: var(--text-faint);
  }

  /* Stream Article With Background Image */
  .blog-preview-section .stream-article.has-bg-image {
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.14);
  }

  .blog-preview-section .stream-article.has-bg-image:hover {
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.24);
  }

  .blog-preview-section .stream-article.has-bg-image .post-cat {
    background: var(--bm-red);
    color: #FFFFFF;
    padding: 0.18rem 0.55rem;
    border-radius: var(--radius-sm);
    font-size: 0.72rem;
    font-weight: 700;
    box-shadow: 0 2px 6px rgba(232, 38, 28, 0.3);
  }

  .blog-preview-section .stream-article.has-bg-image .post-date {
    color: rgba(255, 255, 255, 0.82);
  }

  .blog-preview-section .stream-article.has-bg-image .stream-title a {
    color: #FFFFFF;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.7);
  }

  .blog-preview-section .stream-article.has-bg-image .stream-title a:hover {
    color: var(--bm-yellow);
    text-shadow: 0 1px 8px rgba(242, 169, 59, 0.4);
  }

  .blog-preview-section .stream-article.has-bg-image .stream-excerpt {
    color: rgba(255, 255, 255, 0.88);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }

  .blog-preview-section .stream-article.has-bg-image .stream-footer {
    border-top-color: rgba(255, 255, 255, 0.18);
    color: rgba(255, 255, 255, 0.82);
  }

  .blog-preview-section .stream-article.has-bg-image .stream-author {
    color: #FFFFFF;
    font-weight: 600;
  }

  .blog-preview-section .stream-article.has-bg-image .stream-read {
    color: rgba(255, 255, 255, 0.82);
  }

  /* Esqueleto mientras cargan las noticias */
  .blog-preview-section .is-loading .skeleton-line,
  .blog-preview-section .is-loading .skeleton-chip {
    display: block;
    height: 1rem;
    border-radius: 4px;
    background: linear-gradient(90deg, #EEF2F6 25%, #F8FAFC 50%, #EEF2F6 75%);
    background-size: 200% 100%;
    animation: blogPreviewSkeleton 1.2s ease-in-out infinite;
  }

  .blog-preview-section .is-loading .skeleton-line {
    width: 100%;
    height: 1.4rem;
    margin-bottom: 0.6rem;
  }

  .blog-preview-section .is-loading .skeleton-line.short {
    width: 65%;
  }

  .blog-preview-section .is-loading .skeleton-chip {
    width: 8rem;
  }

  @keyframes blogPreviewSkeleton {
    from { background-position: 200% 0; }
    to { background-position: -200% 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-preview-section .is-loading .skeleton-line,
    .blog-preview-section .is-loading .skeleton-chip {
      animation: none;
    }
  }
</style>
