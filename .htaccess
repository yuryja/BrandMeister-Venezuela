# Apache configuration for BrandMeister Venezuela static Astro site

# Nunca listar el contenido de carpetas (/api/, /_astro/...)
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Todo el sitio por HTTPS: sin esto la contraseña y la cookie del panel viajan sin cifrar
  # (localhost queda fuera para poder probar el sitio en local, donde no hay certificado)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # En /media/ solo hay fotos y videos: nada que el servidor deba ejecutar o mostrar como página
  RewriteRule ^media/.*\.(php[0-9]?|phtml|phar|cgi|pl|py|sh|s?html?|xml|svg)$ - [F]

  # Panel: admin.php comprueba la sesión antes de enviar la página, para que al
  # refrescar no se vea el login un instante antes del escritorio
  RewriteRule ^admin(/|/index\.html)?$ /admin.php [L,QSA]

  # Proxy /api/petra to petra.php
  RewriteRule ^api/petra/(.*)$ api/petra.php?endpoint=$1 [QSA,L]

  # Proxy /api/radioid to radioid.php
  RewriteRule ^api/radioid/?$ api/radioid.php [QSA,L]
  RewriteRule ^api/radioid/(.*)$ api/radioid.php?endpoint=$1 [QSA,L]

  # Codeplug CSV Generator & Sync
  RewriteRule ^api/codeplug-generator/?$ api/codeplug-generator.php [QSA,L]
  RewriteRule ^api/cron-radioid-sync/?$ api/cron-radioid-sync.php [QSA,L]

  # Blog dinámico: las noticias salen de MySQL a través de blog.php
  RewriteRule ^plantillas(/|$) - [F]
  RewriteRule ^blog/?$ /blog.php [L]
  RewriteRule ^blog/([A-Za-z0-9_-]+)/?$ /blog.php?slug=$1 [L,QSA]

  # Redirect trailing slashes if not a directory
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)/$ /$1 [L,R=301]

  # Serve HTML files without extension
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Caching & Compression
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # HTML: siempre se revalida (ETag), así cada deploy se ve al instante
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Archivos con hash en el nombre (CSS, JS, fuentes): inmutables durante un año
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# Archivos internos del API: solo se incluyen desde PHP, nunca se sirven directamente
<FilesMatch "^(config|env|db|accounts|mailer|recaptcha|markdown|uploads)\.php$">
  Require all denied
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"

  # HSTS: el navegador recuerda que este dominio solo se visita por HTTPS.
  # Empieza en 7 días; cuando confirmes que todo entra bien por HTTPS, súbelo a 31536000 (1 año).
  Header always set Strict-Transport-Security "max-age=604800" "expr=%{HTTPS} == 'on'"

  # Content-Security-Policy: limita de dónde puede cargar el navegador.
  # 'unsafe-inline' sigue siendo necesario porque Astro incrusta scripts y estilos en el HTML;
  # aun así, esto bloquea scripts de dominios ajenos, iframes, formularios hacia fuera y objetos.
  # 'wasm-unsafe-eval': el panel comprime imágenes a WebP con WebAssembly.
  Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.google.com https://www.gstatic.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https://unpkg.com https://tile.openstreetmap.org https://*.tile.openstreetmap.org; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' blob: wss://hose.brandmeister.network https://www.google.com https://cdn.jsdelivr.net https://raw.githubusercontent.com; frame-src https://www.google.com; worker-src 'self' blob:"
</IfModule>
